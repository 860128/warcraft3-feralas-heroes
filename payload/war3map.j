    call Wild_SetTpl(2, 4, 3, 'nhrw', "鹰身风行者", "鹰身风行者 (疾风闪避/天界灵动)", 600, 0, 35, 3.0, 1.20, 340.0, 550, 1.10, 'ACev', "高阶闪避")
