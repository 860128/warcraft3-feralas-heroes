//===========================================================================

//===========================================================================
//===========================================================================
// Ninja (魔音忍者) Core System
//===========================================================================

function Ninja_GetTrueHero takes player p returns unit
    local integer pId = GetPlayerId(p)
    local unit u = null
    local group g = null
    if udg_Ninja_TrueHero[pId] != null and GetUnitTypeId(udg_Ninja_TrueHero[pId]) == 'H003' then
        return udg_Ninja_TrueHero[pId]
    endif
    set g = CreateGroup()
    call GroupEnumUnitsOfPlayer(g, p, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if GetUnitTypeId(u) == 'H003' and not IsUnitInGroup(u, udg_FakeHeroGroup) and not IsUnitIllusion(u) then
            set udg_Ninja_TrueHero[pId] = u
            call DestroyGroup(g)
            set g = null
            return u
        endif
    endloop
    call DestroyGroup(g)
    set g = null
    return null
endfunction

function Ninja_GetCloneCount takes integer pId returns integer
    local group g = udg_Ninja_CloneGroup[pId]
    local group tempG = null
    local unit u = null
    local integer count = 0

    if g == null then
        return 0
    endif

    set tempG = CreateGroup()
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) and GetWidgetLife(u) > 0.405 then
            set count = count + 1
            call GroupAddUnit(tempG, u)
        endif
    endloop

    loop
        set u = FirstOfGroup(tempG)
        exitwhen u == null
        call GroupRemoveUnit(tempG, u)
        call GroupAddUnit(g, u)
    endloop

    call DestroyGroup(tempG)
    set tempG = null
    set g = null
    return count
endfunction

function Ninja_IsAnyClone takes unit u returns boolean
    local integer uId = 0
    local integer p = 0
    if u == null then
        return false
    endif
    set uId = GetUnitTypeId(u)
    if uId == 'u002' or uId == 'u001' or IsUnitInGroup(u, udg_FakeHeroGroup) or IsUnitIllusion(u) then
        return true
    endif
    set p = 0
    loop
        exitwhen p > 7
        if udg_Ninja_CloneGroup[p] != null and IsUnitInGroup(u, udg_Ninja_CloneGroup[p]) then
            return true
        endif
        set p = p + 1
    endloop
    return false
endfunction

function Ninja_SpawnClone takes player p, real x, real y, real facing returns unit
    local integer pId = GetPlayerId(p)
    local unit trueHero = Ninja_GetTrueHero(p)
    local real dur = 120.0
    local integer lv = 0
    local unit clone = null
    local integer itemSlot = 0
    local item itm = null
    local integer maxClones = 3
    local integer curClones = 0

    if trueHero != null then
        set lv = GetUnitAbilityLevel(trueHero, 'A011')
    endif
    if lv <= 0 and (GetPlayerController(p) == MAP_CONTROL_COMPUTER or trueHero == null) then
        set lv = 1
    endif

    // Determine max clones based on A011 level: Lv1=3, Lv2=5, Lv3=7
    if lv <= 1 then
        set maxClones = 3
        set dur = 120.0
    elseif lv == 2 then
        set maxClones = 5
        set dur = 240.0
    else
        set maxClones = 7
        set dur = 600.0
    endif

    // Enforce hard cap: no clone created if already at or above cap
    set curClones = Ninja_GetCloneCount(pId)
    if curClones >= maxClones then
        set trueHero = null
        return null
    endif

    set clone = CreateUnit(p, 'u002', x, y, facing)
    call RemoveGuardPosition(clone)
    call UnitAddType(clone, UNIT_TYPE_SUMMONED)

    if lv > 0 then
        call UnitAddAbility(clone, 'A015')
        call SetUnitAbilityLevel(clone, 'A015', lv)
    endif

    if trueHero != null then
        set itemSlot = 0
        loop
            exitwhen itemSlot >= 6
            set itm = UnitItemInSlot(trueHero, itemSlot)
            if itm != null then
                call UnitAddItemById(clone, GetItemTypeId(itm))
            endif
            set itemSlot = itemSlot + 1
        endloop
        set itm = null
    endif

    call GroupAddUnit(udg_FakeHeroGroup, clone)
    if udg_Ninja_CloneGroup[pId] == null then
        set udg_Ninja_CloneGroup[pId] = CreateGroup()
    endif
    call GroupAddUnit(udg_Ninja_CloneGroup[pId], clone)

    call UnitApplyTimedLife(clone, 'BTLF', dur)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl", clone, "origin"))

    set trueHero = null
    return clone
endfunction

function Ninja_PickLivingClone takes integer pId returns unit
    local group g = udg_Ninja_CloneGroup[pId]
    local group tempG = null
    local unit u = null
    local unit pick = null

    if g == null then
        return null
    endif

    set tempG = CreateGroup()
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) and GetWidgetLife(u) > 0.405 then
            if pick == null then
                set pick = u
            endif
            call GroupAddUnit(tempG, u)
        endif
    endloop

    loop
        set u = FirstOfGroup(tempG)
        exitwhen u == null
        call GroupRemoveUnit(tempG, u)
        call GroupAddUnit(g, u)
    endloop

    call DestroyGroup(tempG)
    set tempG = null
    set g = null
    return pick
endfunction

function Ninja_FindKarmaIndex takes unit u returns integer
    local integer i = 0
    loop
        exitwhen i >= udg_KarmaCount
        if udg_KarmaUnit[i] == u then
            return i
        endif
        set i = i + 1
    endloop
    return -1
endfunction

function Ninja_RemoveKarmaIndex takes integer idx returns nothing
    if idx >= 0 and idx < udg_KarmaCount then
        if udg_KarmaFx[idx] != null then
            call DestroyEffect(udg_KarmaFx[idx])
            set udg_KarmaFx[idx] = null
        endif
        if udg_KarmaUnit[idx] != null then
            call SetUnitVertexColor(udg_KarmaUnit[idx], 255, 255, 255, 255)
        endif
        set udg_KarmaUnit[idx] = udg_KarmaUnit[udg_KarmaCount - 1]
        set udg_KarmaOwner[idx] = udg_KarmaOwner[udg_KarmaCount - 1]
        set udg_KarmaLevel[idx] = udg_KarmaLevel[udg_KarmaCount - 1]
        set udg_KarmaFx[idx] = udg_KarmaFx[udg_KarmaCount - 1]
        set udg_KarmaUnit[udg_KarmaCount - 1] = null
        set udg_KarmaOwner[udg_KarmaCount - 1] = null
        set udg_KarmaFx[udg_KarmaCount - 1] = null
        set udg_KarmaCount = udg_KarmaCount - 1
    endif
endfunction

function Ninja_MarkKarma takes unit killer, player ninjaOwner, integer lv returns nothing
    local integer idx = -1
    if killer == null or IsUnitType(killer, UNIT_TYPE_STRUCTURE) or GetUnitTypeId(killer) == 'u000' then
        return
    endif
    set idx = Ninja_FindKarmaIndex(killer)
    if idx >= 0 then
        set udg_KarmaOwner[idx] = ninjaOwner
        if lv > udg_KarmaLevel[idx] then
            set udg_KarmaLevel[idx] = lv
        endif
        if udg_KarmaFx[idx] == null then
            set udg_KarmaFx[idx] = AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Curse\\CurseTarget.mdl", killer, "overhead")
        endif
    else
        if udg_KarmaCount < 128 then
            set udg_KarmaUnit[udg_KarmaCount] = killer
            set udg_KarmaOwner[udg_KarmaCount] = ninjaOwner
            set udg_KarmaLevel[udg_KarmaCount] = lv
            set udg_KarmaFx[udg_KarmaCount] = AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Curse\\CurseTarget.mdl", killer, "overhead")
            set udg_KarmaCount = udg_KarmaCount + 1
        endif
    endif
    call SetUnitVertexColor(killer, 255, 140, 255, 255)
endfunction

function Ninja_OnHeroSkill takes nothing returns boolean
    local unit hero = GetTriggerUnit()
    local integer pId = 0
    local group g = null
    local unit u = null
    local integer qLv = 0
    if GetUnitTypeId(hero) == 'H003' then
        set pId = GetPlayerId(GetOwningPlayer(hero))
        if not IsUnitInGroup(hero, udg_FakeHeroGroup) and not IsUnitIllusion(hero) then
            set udg_Ninja_TrueHero[pId] = hero
        endif
        if GetLearnedSkill() == 'A012' and GetUnitAbilityLevel(hero, 'A012') == 1 then
            set udg_Ninja_AuraOn[pId] = true
            if udg_Ninja_AuraFx[pId] == null then
                set udg_Ninja_AuraFx[pId] = AddSpecialEffectTarget("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl", hero, "origin")
            endif
        endif
        if GetLearnedSkill() == 'A011' then
            set qLv = GetUnitAbilityLevel(hero, 'A011')
            if qLv > 0 and udg_Ninja_CloneGroup[pId] != null then
                set g = CreateGroup()
                call GroupAddGroup(udg_Ninja_CloneGroup[pId], g)
                loop
                    set u = FirstOfGroup(g)
                    exitwhen u == null
                    call GroupRemoveUnit(g, u)
                    if GetUnitTypeId(u) == 'u002' and not IsUnitType(u, UNIT_TYPE_DEAD) then
                        if GetUnitAbilityLevel(u, 'A015') == 0 then
                            call UnitAddAbility(u, 'A015')
                        endif
                        call SetUnitAbilityLevel(u, 'A015', qLv)
                    endif
                endloop
                call DestroyGroup(g)
                set g = null
            endif
        endif
    endif
    set hero = null
    return false
endfunction

// Dream Master (幻梦大师) v1.3 Core System
//===========================================================================

function DM_GetHeroIndex takes unit u returns integer
    local integer i = 0
    loop
        exitwhen i >= udg_DM_HeroCount
        if udg_DM_Hero[i] == u then
            return i
        endif
        set i = i + 1
    endloop
    if udg_DM_HeroCount < 32 then
        set udg_DM_Hero[udg_DM_HeroCount] = u
        set udg_DM_InStealth[udg_DM_HeroCount] = false
        set udg_DM_Backstab[udg_DM_HeroCount] = false
        set udg_DM_StealthDuration[udg_DM_HeroCount] = 0.0
        set udg_DM_HeroCount = udg_DM_HeroCount + 1
        return udg_DM_HeroCount - 1
    endif
    return -1
endfunction

function DM_FindCapIndex takes unit u returns integer
    local integer i = 0
    loop
        exitwhen i >= udg_CapCount
        if udg_CapUnit[i] == u then
            return i
        endif
        set i = i + 1
    endloop
    return -1
endfunction

function DM_RemoveCapIndex takes integer idx returns nothing
    if idx >= 0 and idx < udg_CapCount then
        set udg_CapUnit[idx] = udg_CapUnit[udg_CapCount - 1]
        set udg_CapOrigOwner[idx] = udg_CapOrigOwner[udg_CapCount - 1]
        set udg_CapDuration[idx] = udg_CapDuration[udg_CapCount - 1]
        set udg_CapUnit[udg_CapCount - 1] = null
        set udg_CapOrigOwner[udg_CapCount - 1] = null
        set udg_CapCount = udg_CapCount - 1
    endif
endfunction

function DM_BreakInvisibility takes unit hero, unit victim returns nothing
    local integer hIdx = DM_GetHeroIndex(hero)
    local integer lv = 1
    local boolean hasAgh = false
    local real dmg = 60.0

    if hIdx < 0 or not udg_DM_InStealth[hIdx] then
        return
    endif

    set udg_DM_InStealth[hIdx] = false
    call UnitRemoveBuffBJ('Binv', hero)
    call SetUnitVertexColor(hero, 255, 255, 255, 255)
    call SetUnitMoveSpeed(hero, 320.0)

    if victim != null and udg_DM_Backstab[hIdx] then
        set udg_DM_Backstab[hIdx] = false
        set lv = GetUnitAbilityLevel(hero, 'A001')
        set hasAgh = GetUnitAbilityLevel(hero, 'A004') > 0
        if lv == 2 then
            set dmg = 100.0
        elseif lv >= 3 then
            set dmg = 150.0
        endif
        if hasAgh then
            set dmg = dmg + 100.0
        endif

        call UnitDamageTarget(hero, victim, dmg, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WindWalk\\WindWalkTarget.mdl", victim, "chest"))
    endif
endfunction

//===========================================================================
// Hero #3: The Primordial Strain (异种之源 H004) System
//===========================================================================

function Strain_InitHero takes unit h returns nothing
    if h == null then
        return
    endif
    if GetUnitAbilityLevel(h, 'A024') == 0 then
        call UnitAddAbility(h, 'A024')
    endif
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Burrow\\BurrowTarget.mdl", h, "origin"))
endfunction

function Strain_BreakMimicry takes unit u, integer pId returns nothing
    if not udg_Strain_MimicActive[pId] then
        return
    endif
    set udg_Strain_MimicActive[pId] = false
    if udg_Strain_MimicActor[pId] != null then
        call RemoveUnit(udg_Strain_MimicActor[pId])
        set udg_Strain_MimicActor[pId] = null
    endif
    if u != null then
        call UnitRemoveAbility(u, 'A027')
        call UnitRemoveAbility(u, 'A00V')
        call UnitRemoveBuffBJ('Binv', u)
        call SetUnitPathing(u, true)
        call SetUnitVertexColor(u, 255, 255, 255, 255)
        call SetUnitColor(u, GetPlayerColor(GetOwningPlayer(u)))
        call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), GetOwningPlayer(u), bj_ALLIANCE_UNALLIED)
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageDeathCaster.mdl", GetUnitX(u), GetUnitY(u)))
    endif
endfunction

function Strain_Unburrow takes unit u, integer pId returns nothing
    local unit enumU = null
    local real dmg = 0.0
    if u == null then
        return
    endif
    set udg_Strain_Burrowed[pId] = false
    set udg_Strain_BurrowTimer[pId] = 0.0
    call UnitRemoveAbility(u, 'Abun')
    call UnitRemoveAbility(u, 'A027')
    call UnitRemoveAbility(u, 'A00V')
    call UnitRemoveBuffBJ('Binv', u)
    call SetUnitPathing(u, true)
    call SetUnitMoveSpeed(u, GetUnitDefaultMoveSpeed(u))
    call SetUnitVertexColor(u, 255, 255, 255, 255)
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Undead\\Impale\\ImpaleHitTarget.mdl", GetUnitX(u), GetUnitY(u)))
    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", GetUnitX(u), GetUnitY(u)))

    set dmg = 60.0 + 60.0 * I2R(GetUnitAbilityLevel(u, 'A021')) + 1.5 * I2R(GetHeroAgi(u, true))
    call GroupClear(udg_EnumGroup)
    call GroupEnumUnitsInRange(udg_EnumGroup, GetUnitX(u), GetUnitY(u), 250.0, null)
    loop
        set enumU = FirstOfGroup(udg_EnumGroup)
        exitwhen enumU == null
        call GroupRemoveUnit(udg_EnumGroup, enumU)
        if IsUnitEnemy(enumU, GetOwningPlayer(u)) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(enumU) != 'u000' and not IsUnitInGroup(enumU, udg_FakeHeroGroup) then
            call UnitDamageTarget(u, enumU, dmg, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
            call UnitAddAbility(enumU, 'Amrf')
            call UnitRemoveAbility(enumU, 'Amrf')
            call SetUnitFlyHeight(enumU, 260.0, 650.0)
            if udg_Strain_KnockCount < 64 then
                set udg_Strain_KnockUnit[udg_Strain_KnockCount] = enumU
                set udg_Strain_KnockTimer[udg_Strain_KnockCount] = 0.75
                set udg_Strain_KnockCount = udg_Strain_KnockCount + 1
            endif
        endif
    endloop
    set enumU = null
endfunction

function Strain_ClearCurrentGene takes unit u, integer pId returns nothing
    if u != null then
        call UnitRemoveAbility(u, 'A025')
        call UnitRemoveAbility(u, 'A026')
        if udg_Strain_StolenAbil1[pId] != 0 then
            call UnitRemoveAbility(u, udg_Strain_StolenAbil1[pId])
        endif
        if udg_Strain_StolenAbil2[pId] != 0 then
            call UnitRemoveAbility(u, udg_Strain_StolenAbil2[pId])
        endif
        if udg_Strain_StolenHeroAbil[pId] != 0 then
            call UnitRemoveAbility(u, udg_Strain_StolenHeroAbil[pId])
        endif
        call SetUnitMoveSpeed(u, GetUnitDefaultMoveSpeed(u))
        call SetUnitScale(u, 1.25, 1.25, 1.25)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", u, "origin"))
        call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 3.0, "|cffffcc00[异种进化]|r 已清空双基因槽位掠夺技能！")
    endif
    set udg_Strain_GeneCat[pId] = 0
    set udg_Strain_EvoTier[pId] = 0
    set udg_Strain_StolenHeroAbil[pId] = 0
    set udg_Strain_StolenAbil1[pId] = 0
    set udg_Strain_StolenAbil2[pId] = 0
    set udg_Strain_EvoTier1[pId] = 0
    set udg_Strain_EvoTier2[pId] = 0
    set udg_Strain_PendingNewAbil[pId] = 0
    set udg_Strain_CandidateCount[pId] = 0
endfunction

function Strain_DrainEnemyHero takes unit caster, unit victim returns nothing
    local integer pId = 0
    local integer k = 1
    local integer vAgi = 0
    local integer vStr = 0
    local integer vInt = 0
    local integer curMaxHP = 0
    local integer curMaxMana = 0
    local integer drainHP = 0
    local integer drainMana = 0
    local integer gainAgi = 0
    local integer gainStr = 0
    local integer gainInt = 0
    local integer totalDrainHP = 0
    local integer totalDrainMana = 0
    local boolean drainedSomething = false
    local string gainMsg = ""
    local integer idx = 0
    local integer cIdx = -1

    if caster == null or victim == null then
        return
    endif
    set pId = GetPlayerId(GetOwningPlayer(caster))

    // 1. Cascading drain 4 points: Agi -> Str -> Int -> Max HP/Mana down to 1
    // Mirror Gain: whatever is drained from enemy is permanently added to H004
    loop
        exitwhen k > 4
        set vAgi = GetHeroAgi(victim, false)
        set vStr = GetHeroStr(victim, false)
        set vInt = GetHeroInt(victim, false)
        if vAgi > 1 then
            call SetHeroAgi(victim, vAgi - 1, true)
            call SetHeroAgi(caster, GetHeroAgi(caster, false) + 1, true)
            set gainAgi = gainAgi + 1
        elseif vStr > 1 then
            call SetHeroStr(victim, vStr - 1, true)
            call SetHeroStr(caster, GetHeroStr(caster, false) + 1, true)
            set gainStr = gainStr + 1
        elseif vInt > 1 then
            call SetHeroInt(victim, vInt - 1, true)
            call SetHeroInt(caster, GetHeroInt(caster, false) + 1, true)
            set gainInt = gainInt + 1
        else
            // All 3 attributes are 1! Drain HP & Mana down to 1
            set curMaxHP = BlzGetUnitMaxHP(victim)
            set curMaxMana = BlzGetUnitMaxMana(victim)
            set drainedSomething = false

            if curMaxHP > 1 then
                set drainHP = IMinBJ(curMaxHP - 1, 150)
                call BlzSetUnitMaxHP(victim, curMaxHP - drainHP)
                call BlzSetUnitMaxHP(caster, BlzGetUnitMaxHP(caster) + drainHP)
                set udg_Strain_TotalBonusHP[pId] = udg_Strain_TotalBonusHP[pId] + drainHP
                set totalDrainHP = totalDrainHP + drainHP
                set drainedSomething = true
            endif
            if curMaxMana > 1 then
                set drainMana = IMinBJ(curMaxMana - 1, 150)
                call BlzSetUnitMaxMana(victim, curMaxMana - drainMana)
                call BlzSetUnitMaxMana(caster, BlzGetUnitMaxMana(caster) + drainMana)
                set udg_Strain_TotalBonusMana[pId] = udg_Strain_TotalBonusMana[pId] + drainMana
                set totalDrainMana = totalDrainMana + drainMana
                set drainedSomething = true
            endif

            // Fallback: if enemy is already completely drained (all 1), give +1 Agi guarantee
            if not drainedSomething then
                call SetHeroAgi(caster, GetHeroAgi(caster, false) + 1, true)
                set gainAgi = gainAgi + 1
            endif
        endif
        set k = k + 1
    endloop

    // 2. Track crippled hero so revive at Altar enforces Max HP / Mana clamp
    set idx = 0
    loop
        exitwhen idx >= udg_Strain_CrippledCount
        if udg_Strain_CrippledHero[idx] == victim then
            set cIdx = idx
            exitwhen true
        endif
        set idx = idx + 1
    endloop
    if cIdx == -1 and udg_Strain_CrippledCount < 64 then
        set cIdx = udg_Strain_CrippledCount
        set udg_Strain_CrippledHero[cIdx] = victim
        set udg_Strain_CrippledCount = udg_Strain_CrippledCount + 1
    endif
    if cIdx != -1 then
        set udg_Strain_CrippledHP[cIdx] = BlzGetUnitMaxHP(victim)
        set udg_Strain_CrippledMana[cIdx] = BlzGetUnitMaxMana(victim)
    endif

    // 3. Visual effect
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", caster, "origin"))

    // 4. Construct detailed feedback message listing each gained stat
    set gainMsg = ""
    if gainAgi > 0 then
        set gainMsg = gainMsg + " 敏捷+" + I2S(gainAgi)
    endif
    if gainStr > 0 then
        set gainMsg = gainMsg + " 力量+" + I2S(gainStr)
    endif
    if gainInt > 0 then
        set gainMsg = gainMsg + " 智力+" + I2S(gainInt)
    endif
    if totalDrainHP > 0 then
        set gainMsg = gainMsg + " 生命+" + I2S(totalDrainHP)
    endif
    if totalDrainMana > 0 then
        set gainMsg = gainMsg + " 法力+" + I2S(totalDrainMana)
    endif

    call DisplayTimedTextToPlayer(GetOwningPlayer(caster), 0, 0, 5.0, "|cff00ff00[顶端掠食-镜像获得]|r 成功蚕食敌方英雄，永久夺取：" + gainMsg + "！")
    call DisplayTimedTextToPlayer(GetOwningPlayer(caster), 0, 0, 5.0, "|cffff3333[目标残废状态]|r 敌方当前：" + I2S(GetHeroAgi(victim, false)) + "敏 / " + I2S(GetHeroStr(victim, false)) + "力 / " + I2S(GetHeroInt(victim, false)) + "智 / " + I2S(BlzGetUnitMaxHP(victim)) + "血 / " + I2S(BlzGetUnitMaxMana(victim)) + "蓝")
endfunction

function Strain_GetAbilName takes integer abilId returns string
    if abilId == 'ACbl' then
        return "嗜血术"
    elseif abilId == 'ACls' then
        return "闪电护盾"
    elseif abilId == 'ACpu' then
        return "净化"
    elseif abilId == 'ACct' then
        return "致命一击"
    elseif abilId == 'ACbh' then
        return "重击"
    elseif abilId == 'ACev' then
        return "闪避"
    elseif abilId == 'ACtb' then
        return "投掷巨石"
    elseif abilId == 'ACro' then
        return "战吼咆哮"
    elseif abilId == 'ACif' then
        return "心灵之火"
    elseif abilId == 'ACsw' then
        return "减速"
    elseif abilId == 'AChx' then
        return "妖术"
    elseif abilId == 'ACst' then
        return "战争践踏"
    elseif abilId == 'ACsh' then
        return "震荡波"
    elseif abilId == 'ACfl' then
        return "叉状闪电"
    elseif abilId == 'ACfn' then
        return "霜冻新星"
    elseif abilId == 'ACf2' then
        return "霜冻护甲"
    elseif abilId == 'ACen' then
        return "诱捕"
    elseif abilId == 'ACrj' then
        return "生命恢复"
    elseif abilId == 'ACcs' then
        return "诅咒"
    elseif abilId == 'ACav' then
        return "统御光环"
    elseif abilId == 'ACdv' then
        return "专注光环"
    elseif abilId == 'A025' then
        return "异种甲壳进化"
    elseif abilId == 'A026' then
        return "异种剧毒"
    endif
    return GetObjectName(abilId)
endfunction

function Strain_LearnOrUpgradeStolenAbil takes unit u, integer pId, integer abilId returns nothing
    local string name = ""
    local player p = null
    if u == null or abilId == 0 then
        return
    endif
    set p = GetOwningPlayer(u)
    set name = Strain_GetAbilName(abilId)

    // Case 1: Already in Slot 1 -> Upgrade Tier
    if udg_Strain_StolenAbil1[pId] == abilId then
        set udg_Strain_EvoTier1[pId] = udg_Strain_EvoTier1[pId] + 1
        call SetUnitAbilityLevel(u, abilId, IMinBJ(3, udg_Strain_EvoTier1[pId]))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", u, "origin"))
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cff00ff00[基因超载强化]|r 【槽位1】" + name + " 进化至强化 " + I2S(udg_Strain_EvoTier1[pId]) + " 阶！")
        set p = null
        return
    endif

    // Case 2: Already in Slot 2 -> Upgrade Tier
    if udg_Strain_StolenAbil2[pId] == abilId then
        set udg_Strain_EvoTier2[pId] = udg_Strain_EvoTier2[pId] + 1
        call SetUnitAbilityLevel(u, abilId, IMinBJ(3, udg_Strain_EvoTier2[pId]))
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", u, "origin"))
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cff00ff00[基因超载强化]|r 【槽位2】" + name + " 进化至强化 " + I2S(udg_Strain_EvoTier2[pId]) + " 阶！")
        set p = null
        return
    endif

    // Case 3: Slot 1 is empty -> Assign to Slot 1
    if udg_Strain_StolenAbil1[pId] == 0 then
        set udg_Strain_StolenAbil1[pId] = abilId
        set udg_Strain_EvoTier1[pId] = 1
        call UnitAddAbility(u, abilId)
        call SetUnitAbilityLevel(u, abilId, 1)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", u, "origin"))
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cff00ff00[基因融合成功]|r 已将 " + name + " 融入【基因槽位 1】！")
        set p = null
        return
    endif

    // Case 4: Slot 1 is full, Slot 2 is empty -> Assign to Slot 2
    if udg_Strain_StolenAbil2[pId] == 0 then
        set udg_Strain_StolenAbil2[pId] = abilId
        set udg_Strain_EvoTier2[pId] = 1
        call UnitAddAbility(u, abilId)
        call SetUnitAbilityLevel(u, abilId, 1)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", u, "origin"))
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cff00ff00[基因融合成功]|r 已将 " + name + " 融入【基因槽位 2】！（当前已持有双技能）")
        set p = null
        return
    endif

    // Case 5: Both slots are full with different skills!
    set udg_Strain_PendingNewAbil[pId] = abilId
    if GetPlayerController(p) == MAP_CONTROL_USER then
        call DialogDisplay(p, udg_Strain_ReplaceDialog, false)
        call DialogClear(udg_Strain_ReplaceDialog)
        call DialogSetMessage(udg_Strain_ReplaceDialog, "两个基因槽位均已满，请选择要替换的技能槽：\n待融入新技能：" + name)
        set udg_Strain_BtnRep1 = DialogAddButton(udg_Strain_ReplaceDialog, "[1] 替换【槽位1】: " + Strain_GetAbilName(udg_Strain_StolenAbil1[pId]) + " (阶数 " + I2S(udg_Strain_EvoTier1[pId]) + ")", 49)
        set udg_Strain_BtnRep2 = DialogAddButton(udg_Strain_ReplaceDialog, "[2] 替换【槽位2】: " + Strain_GetAbilName(udg_Strain_StolenAbil2[pId]) + " (阶数 " + I2S(udg_Strain_EvoTier2[pId]) + ")", 50)
        set udg_Strain_BtnRepCancel = DialogAddButton(udg_Strain_ReplaceDialog, "[3] 不加入当前技能组（取消覆盖）", 51)
        call DialogDisplay(p, udg_Strain_ReplaceDialog, true)
    else
        // AI: Replace Slot 1 by default
        call UnitRemoveAbility(u, udg_Strain_StolenAbil1[pId])
        set udg_Strain_StolenAbil1[pId] = abilId
        set udg_Strain_EvoTier1[pId] = 1
        call UnitAddAbility(u, abilId)
        call SetUnitAbilityLevel(u, abilId, 1)
    endif
    set p = null
endfunction

function Strain_OnReplaceDialogClick takes nothing returns nothing
    local button b = GetClickedButton()
    local player p = GetTriggerPlayer()
    local integer pId = 0
    local unit u = null
    local group g = null
    local unit enumU = null
    local integer newAbil = 0
    if p == null then
        set b = null
        return
    endif
    set pId = GetPlayerId(p)
    set u = udg_Strain_Hero[pId]
    if u == null then
        set u = udg_AI_CustomHero[pId]
    endif
    if u == null then
        set g = CreateGroup()
        call GroupEnumUnitsOfPlayer(g, p, null)
        loop
            set enumU = FirstOfGroup(g)
            exitwhen enumU == null
            call GroupRemoveUnit(g, enumU)
            if GetUnitTypeId(enumU) == 'H004' and not IsUnitIllusion(enumU) and not IsUnitInGroup(enumU, udg_FakeHeroGroup) then
                set u = enumU
                set udg_Strain_Hero[pId] = enumU
                exitwhen true
            endif
        endloop
        call DestroyGroup(g)
        set g = null
    endif
    call DialogDisplay(p, udg_Strain_ReplaceDialog, false)
    set newAbil = udg_Strain_PendingNewAbil[pId]
    if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) and newAbil != 0 then
        if b == udg_Strain_BtnRep1 then
            call UnitRemoveAbility(u, udg_Strain_StolenAbil1[pId])
            set udg_Strain_StolenAbil1[pId] = newAbil
            set udg_Strain_EvoTier1[pId] = 1
            call UnitAddAbility(u, newAbil)
            call SetUnitAbilityLevel(u, newAbil, 1)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", u, "origin"))
            call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cff00ff00[槽位替换成功]|r 【槽位1】已替换为：" + Strain_GetAbilName(newAbil))
        elseif b == udg_Strain_BtnRep2 then
            call UnitRemoveAbility(u, udg_Strain_StolenAbil2[pId])
            set udg_Strain_StolenAbil2[pId] = newAbil
            set udg_Strain_EvoTier2[pId] = 1
            call UnitAddAbility(u, newAbil)
            call SetUnitAbilityLevel(u, newAbil, 1)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", u, "origin"))
            call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cff00ff00[槽位替换成功]|r 【槽位2】已替换为：" + Strain_GetAbilName(newAbil))
        elseif b == udg_Strain_BtnRepCancel then
            call DisplayTimedTextToPlayer(p, 0, 0, 4.0, "|cffffcc00[基因替换取消]|r 保留现有双技能组，未做替换。")
        endif
    endif
    set udg_Strain_PendingNewAbil[pId] = 0
    set b = null
    set p = null
    set u = null
endfunction

function Strain_ShowSkillChoiceDialog takes player p, integer pId, string title, integer optCount returns nothing
    if p == null then
        return
    endif
    set udg_Strain_CandidateCount[pId] = optCount
    call DialogDisplay(p, udg_Strain_HeroDialog, false)
    call DialogClear(udg_Strain_HeroDialog)
    call DialogSetMessage(udg_Strain_HeroDialog, title)
    set udg_Strain_HeroSkillBtn[0] = null
    set udg_Strain_HeroSkillBtn[1] = null
    set udg_Strain_HeroSkillBtn[2] = null
    set udg_Strain_HeroSkillBtn[3] = null
    set udg_Strain_HeroSkillBtn[4] = null
    if optCount >= 1 and udg_Strain_CandidateAbil0[pId] != 0 then
        set udg_Strain_HeroSkillBtn[0] = DialogAddButton(udg_Strain_HeroDialog, "[1] " + Strain_GetAbilName(udg_Strain_CandidateAbil0[pId]), 49)
    endif
    if optCount >= 2 and udg_Strain_CandidateAbil1[pId] != 0 then
        set udg_Strain_HeroSkillBtn[1] = DialogAddButton(udg_Strain_HeroDialog, "[2] " + Strain_GetAbilName(udg_Strain_CandidateAbil1[pId]), 50)
    endif
    if optCount >= 3 and udg_Strain_CandidateAbil2[pId] != 0 then
        set udg_Strain_HeroSkillBtn[2] = DialogAddButton(udg_Strain_HeroDialog, "[3] " + Strain_GetAbilName(udg_Strain_CandidateAbil2[pId]), 51)
    endif
    if optCount >= 4 and udg_Strain_CandidateAbil3[pId] != 0 then
        set udg_Strain_HeroSkillBtn[3] = DialogAddButton(udg_Strain_HeroDialog, "[4] " + Strain_GetAbilName(udg_Strain_CandidateAbil3[pId]), 52)
    endif
    set udg_Strain_HeroSkillBtn[4] = DialogAddButton(udg_Strain_HeroDialog, "[5] 不加入当前技能组（保留现有技能，不覆盖）", 53)
    call DialogDisplay(p, udg_Strain_HeroDialog, true)
endfunction

function Strain_OnHeroDialogClick takes nothing returns nothing
    local button b = GetClickedButton()
    local player p = GetTriggerPlayer()
    local integer pId = 0
    local unit u = null
    local group g = null
    local unit enumU = null
    if p == null then
        set b = null
        return
    endif
    set pId = GetPlayerId(p)
    set u = udg_Strain_Hero[pId]
    if u == null then
        set u = udg_AI_CustomHero[pId]
    endif
    if u == null then
        set g = CreateGroup()
        call GroupEnumUnitsOfPlayer(g, p, null)
        loop
            set enumU = FirstOfGroup(g)
            exitwhen enumU == null
            call GroupRemoveUnit(g, enumU)
            if GetUnitTypeId(enumU) == 'H004' and not IsUnitIllusion(enumU) and not IsUnitInGroup(enumU, udg_FakeHeroGroup) then
                set u = enumU
                set udg_Strain_Hero[pId] = enumU
                exitwhen true
            endif
        endloop
        call DestroyGroup(g)
        set g = null
    endif
    call DialogDisplay(p, udg_Strain_HeroDialog, false)
    if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) then
        if b == udg_Strain_HeroSkillBtn[0] and udg_Strain_CandidateAbil0[pId] != 0 then
            call Strain_LearnOrUpgradeStolenAbil(u, pId, udg_Strain_CandidateAbil0[pId])
        elseif b == udg_Strain_HeroSkillBtn[1] and udg_Strain_CandidateAbil1[pId] != 0 then
            call Strain_LearnOrUpgradeStolenAbil(u, pId, udg_Strain_CandidateAbil1[pId])
        elseif b == udg_Strain_HeroSkillBtn[2] and udg_Strain_CandidateAbil2[pId] != 0 then
            call Strain_LearnOrUpgradeStolenAbil(u, pId, udg_Strain_CandidateAbil2[pId])
        elseif b == udg_Strain_HeroSkillBtn[3] and udg_Strain_CandidateAbil3[pId] != 0 then
            call Strain_LearnOrUpgradeStolenAbil(u, pId, udg_Strain_CandidateAbil3[pId])
        elseif b == udg_Strain_HeroSkillBtn[4] then
            call DisplayTimedTextToPlayer(p, 0, 0, 4.0, "|cffffcc00[基因同化]|r 已放弃新技能融合，保留现有双技能组！")
        endif
    endif
    set b = null
    set p = null
    set u = null
endfunction

function Strain_ShowGeneDialog takes player p, integer pId returns nothing
    local string msg = "【异种之源 - 基因控制台】"
    if p == null then
        return
    endif
    set msg = msg + "\n累计进化：+" + I2S(udg_Strain_TotalBonusHP[pId]) + "生命 / +" + I2S(udg_Strain_TotalBonusAtk[pId]) + "攻击 / +" + I2S(udg_Strain_TotalBonusMana[pId]) + "法力"
    if udg_Strain_StolenAbil1[pId] != 0 then
        set msg = msg + "\n【基因槽位 1】： " + Strain_GetAbilName(udg_Strain_StolenAbil1[pId]) + " (强化 " + I2S(udg_Strain_EvoTier1[pId]) + " 阶)"
    else
        set msg = msg + "\n【基因槽位 1】： [空闲]"
    endif
    if udg_Strain_StolenAbil2[pId] != 0 then
        set msg = msg + "\n【基因槽位 2】： " + Strain_GetAbilName(udg_Strain_StolenAbil2[pId]) + " (强化 " + I2S(udg_Strain_EvoTier2[pId]) + " 阶)"
    else
        set msg = msg + "\n【基因槽位 2】： [空闲]"
    endif
    call DialogDisplay(p, udg_Strain_GeneDialog, false)
    call DialogClear(udg_Strain_GeneDialog)
    call DialogSetMessage(udg_Strain_GeneDialog, msg)
    set udg_Strain_BtnKeep = DialogAddButton(udg_Strain_GeneDialog, "[1] 保留当前双技能组（关闭面板）", 49)
    set udg_Strain_BtnDiscard1 = null
    set udg_Strain_BtnDiscard2 = null
    if udg_Strain_StolenAbil1[pId] != 0 then
        set udg_Strain_BtnDiscard1 = DialogAddButton(udg_Strain_GeneDialog, "[2] 遗忘【槽位1】技能：" + Strain_GetAbilName(udg_Strain_StolenAbil1[pId]), 50)
    endif
    if udg_Strain_StolenAbil2[pId] != 0 then
        set udg_Strain_BtnDiscard2 = DialogAddButton(udg_Strain_GeneDialog, "[3] 遗忘【槽位2】技能：" + Strain_GetAbilName(udg_Strain_StolenAbil2[pId]), 51)
    endif
    call DialogDisplay(p, udg_Strain_GeneDialog, true)
endfunction

function Strain_OnGeneDialogClick takes nothing returns nothing
    local button b = GetClickedButton()
    local player p = GetTriggerPlayer()
    local integer pId = 0
    local unit u = null
    local group g = null
    local unit enumU = null
    if p == null then
        set b = null
        return
    endif
    set pId = GetPlayerId(p)
    set u = udg_Strain_Hero[pId]
    if u == null then
        set u = udg_AI_CustomHero[pId]
    endif
    if u == null then
        set g = CreateGroup()
        call GroupEnumUnitsOfPlayer(g, p, null)
        loop
            set enumU = FirstOfGroup(g)
            exitwhen enumU == null
            call GroupRemoveUnit(g, enumU)
            if GetUnitTypeId(enumU) == 'H004' and not IsUnitIllusion(enumU) and not IsUnitInGroup(enumU, udg_FakeHeroGroup) then
                set u = enumU
                set udg_Strain_Hero[pId] = enumU
                exitwhen true
            endif
        endloop
        call DestroyGroup(g)
        set g = null
    endif
    call DialogDisplay(p, udg_Strain_GeneDialog, false)
    if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) then
        if b == udg_Strain_BtnDiscard1 and udg_Strain_StolenAbil1[pId] != 0 then
            call DisplayTimedTextToPlayer(p, 0, 0, 4.0, "|cffffcc00[基因遗忘]|r 已遗忘【槽位1】技能：" + Strain_GetAbilName(udg_Strain_StolenAbil1[pId]) + "，腾出技能槽位 1！")
            call UnitRemoveAbility(u, udg_Strain_StolenAbil1[pId])
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", u, "origin"))
            set udg_Strain_StolenAbil1[pId] = 0
            set udg_Strain_EvoTier1[pId] = 0
        elseif b == udg_Strain_BtnDiscard2 and udg_Strain_StolenAbil2[pId] != 0 then
            call DisplayTimedTextToPlayer(p, 0, 0, 4.0, "|cffffcc00[基因遗忘]|r 已遗忘【槽位2】技能：" + Strain_GetAbilName(udg_Strain_StolenAbil2[pId]) + "，腾出技能槽位 2！")
            call UnitRemoveAbility(u, udg_Strain_StolenAbil2[pId])
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", u, "origin"))
            set udg_Strain_StolenAbil2[pId] = 0
            set udg_Strain_EvoTier2[pId] = 0
        endif
    endif
    set b = null
    set p = null
    set u = null
endfunction

function Strain_AddCandidateAbil takes integer pId, integer abilId returns nothing
    local integer count = udg_Strain_CandidateCount[pId]
    if abilId == 0 or count >= 4 then
        return
    endif
    if count >= 1 and udg_Strain_CandidateAbil0[pId] == abilId then
        return
    endif
    if count >= 2 and udg_Strain_CandidateAbil1[pId] == abilId then
        return
    endif
    if count >= 3 and udg_Strain_CandidateAbil2[pId] == abilId then
        return
    endif
    if count >= 4 and udg_Strain_CandidateAbil3[pId] == abilId then
        return
    endif
    if count == 0 then
        set udg_Strain_CandidateAbil0[pId] = abilId
    elseif count == 1 then
        set udg_Strain_CandidateAbil1[pId] = abilId
    elseif count == 2 then
        set udg_Strain_CandidateAbil2[pId] = abilId
    elseif count == 3 then
        set udg_Strain_CandidateAbil3[pId] = abilId
    endif
    set udg_Strain_CandidateCount[pId] = count + 1
endfunction

function Strain_CaptureRealUnitSkills takes integer pId, unit tgt returns nothing
    local integer uId = 0
    set udg_Strain_CandidateAbil0[pId] = 0
    set udg_Strain_CandidateAbil1[pId] = 0
    set udg_Strain_CandidateAbil2[pId] = 0
    set udg_Strain_CandidateAbil3[pId] = 0
    set udg_Strain_CandidateCount[pId] = 0

    if tgt == null then
        return
    endif
    set uId = GetUnitTypeId(tgt)

    // Check actual abilities on target unit & standard caster mappings
    if GetUnitAbilityLevel(tgt, 'Adef') > 0 or uId == 'hfoo' or uId == 'hcth' then
        call Strain_AddCandidateAbil(pId, 'A025')
    endif

    if GetUnitAbilityLevel(tgt, 'Aspo') > 0 or GetUnitAbilityLevel(tgt, 'Apsn') > 0 or GetUnitAbilityLevel(tgt, 'A026') > 0 or uId == 'edry' or uId == 'nspr' or uId == 'nspg' or uId == 'nass' or uId == 'nmrl' or uId == 'ngna' then
        call Strain_AddCandidateAbil(pId, 'A026')
    endif

    if GetUnitAbilityLevel(tgt, 'Ablo') > 0 or GetUnitAbilityLevel(tgt, 'ACbl') > 0 or uId == 'oshm' or uId == 'nomg' then
        call Strain_AddCandidateAbil(pId, 'ACbl')
    endif

    if GetUnitAbilityLevel(tgt, 'Alsh') > 0 or GetUnitAbilityLevel(tgt, 'ACls') > 0 or uId == 'oshm' then
        call Strain_AddCandidateAbil(pId, 'ACls')
    endif

    if GetUnitAbilityLevel(tgt, 'Apgr') > 0 or GetUnitAbilityLevel(tgt, 'Apg2') > 0 or GetUnitAbilityLevel(tgt, 'ACpu') > 0 or uId == 'oshm' then
        call Strain_AddCandidateAbil(pId, 'ACpu')
    endif

    if GetUnitAbilityLevel(tgt, 'AOcr') > 0 or GetUnitAbilityLevel(tgt, 'ACct') > 0 or GetUnitAbilityLevel(tgt, 'A017') > 0 then
        call Strain_AddCandidateAbil(pId, 'ACct')
    endif

    if GetUnitAbilityLevel(tgt, 'Abas') > 0 or GetUnitAbilityLevel(tgt, 'ACbh') > 0 or GetUnitAbilityLevel(tgt, 'AHbh') > 0 then
        call Strain_AddCandidateAbil(pId, 'ACbh')
    endif

    if GetUnitAbilityLevel(tgt, 'Aevs') > 0 or GetUnitAbilityLevel(tgt, 'ACev') > 0 or GetUnitAbilityLevel(tgt, 'AEev') > 0 then
        call Strain_AddCandidateAbil(pId, 'ACev')
    endif

    if GetUnitAbilityLevel(tgt, 'Atbb') > 0 or GetUnitAbilityLevel(tgt, 'ACtb') > 0 or uId == 'ngst' or uId == 'nggr' or uId == 'ngnv' or uId == 'ngns' then
        call Strain_AddCandidateAbil(pId, 'ACtb')
    endif

    if GetUnitAbilityLevel(tgt, 'Aroa') > 0 or GetUnitAbilityLevel(tgt, 'ACro') > 0 or uId == 'nfrb' or uId == 'nfrl' then
        call Strain_AddCandidateAbil(pId, 'ACro')
    endif

    if GetUnitAbilityLevel(tgt, 'Ainf') > 0 or GetUnitAbilityLevel(tgt, 'ACif') > 0 or GetUnitAbilityLevel(tgt, 'Ahea') > 0 or uId == 'hmpr' then
        call Strain_AddCandidateAbil(pId, 'ACif')
    endif

    if GetUnitAbilityLevel(tgt, 'Aslo') > 0 or GetUnitAbilityLevel(tgt, 'ACsw') > 0 or uId == 'hsor' then
        call Strain_AddCandidateAbil(pId, 'ACsw')
    endif

    if GetUnitAbilityLevel(tgt, 'Aply') > 0 or GetUnitAbilityLevel(tgt, 'AChx') > 0 or GetUnitAbilityLevel(tgt, 'AOhx') > 0 or uId == 'hsor' or uId == 'odoc' then
        call Strain_AddCandidateAbil(pId, 'AChx')
    endif

    if GetUnitAbilityLevel(tgt, 'Astp') > 0 or GetUnitAbilityLevel(tgt, 'ACst') > 0 or GetUnitAbilityLevel(tgt, 'AOws') > 0 then
        call Strain_AddCandidateAbil(pId, 'ACst')
    endif

    if GetUnitAbilityLevel(tgt, 'Ashw') > 0 or GetUnitAbilityLevel(tgt, 'ACsh') > 0 or GetUnitAbilityLevel(tgt, 'AOsh') > 0 then
        call Strain_AddCandidateAbil(pId, 'ACsh')
    endif

    if GetUnitAbilityLevel(tgt, 'Aflk') > 0 or GetUnitAbilityLevel(tgt, 'ACfl') > 0 then
        call Strain_AddCandidateAbil(pId, 'ACfl')
    endif

    if GetUnitAbilityLevel(tgt, 'Afno') > 0 or GetUnitAbilityLevel(tgt, 'ACfn') > 0 or GetUnitAbilityLevel(tgt, 'AUfn') > 0 then
        call Strain_AddCandidateAbil(pId, 'ACfn')
    endif

    if GetUnitAbilityLevel(tgt, 'Afae') > 0 or GetUnitAbilityLevel(tgt, 'ACf2') > 0 or GetUnitAbilityLevel(tgt, 'AUfu') > 0 then
        call Strain_AddCandidateAbil(pId, 'ACf2')
    endif

    if GetUnitAbilityLevel(tgt, 'Aens') > 0 or GetUnitAbilityLevel(tgt, 'ACen') > 0 or uId == 'orai' then
        call Strain_AddCandidateAbil(pId, 'ACen')
    endif

    if GetUnitAbilityLevel(tgt, 'Arej') > 0 or GetUnitAbilityLevel(tgt, 'ACrj') > 0 or uId == 'edoc' then
        call Strain_AddCandidateAbil(pId, 'ACrj')
    endif

    if GetUnitAbilityLevel(tgt, 'Acrs') > 0 or GetUnitAbilityLevel(tgt, 'ACcs') > 0 or uId == 'uban' or uId == 'unec' then
        call Strain_AddCandidateAbil(pId, 'ACcs')
    endif

    if GetUnitAbilityLevel(tgt, 'Acmd') > 0 or GetUnitAbilityLevel(tgt, 'ACav') > 0 then
        call Strain_AddCandidateAbil(pId, 'ACav')
    endif

    if GetUnitAbilityLevel(tgt, 'Aamk') > 0 or GetUnitAbilityLevel(tgt, 'ACdv') > 0 or GetUnitAbilityLevel(tgt, 'AHad') > 0 then
        call Strain_AddCandidateAbil(pId, 'ACdv')
    endif
endfunction

function Strain_OnDigestComplete takes unit u, integer pId returns nothing
    local integer tgtType = 0
    local integer bonusHP = 0
    local integer bonusAtk = 0
    local integer bonusMana = 0
    local integer uChoiceCount = 0
    local integer wLv = 1
    local real mult = 1.0
    local string multStr = "1.0倍"
    if u == null then
        return
    endif
    set tgtType = udg_Strain_DigestType[pId]
    set wLv = udg_Strain_DigestSkillLv[pId]
    if wLv == 2 then
        set mult = 1.25
        set multStr = "1.25倍"
    elseif wLv >= 3 then
        set mult = 1.50
        set multStr = "1.5倍"
    endif

    if udg_Strain_DigestIsHero[pId] then
        // Apex Harvest: Hero Devoured! (Agi drain & crippling was already done when A022 cast)
        if tgtType == 'H002' then
            set udg_Strain_CandidateAbil0[pId] = 'A001'
            set udg_Strain_CandidateAbil1[pId] = 'A002'
            set udg_Strain_CandidateAbil2[pId] = 'A003'
            set udg_Strain_CandidateAbil3[pId] = 'A004'
        elseif tgtType == 'H003' then
            set udg_Strain_CandidateAbil0[pId] = 'A011'
            set udg_Strain_CandidateAbil1[pId] = 'A012'
            set udg_Strain_CandidateAbil2[pId] = 'A013'
            set udg_Strain_CandidateAbil3[pId] = 'A014'
        elseif tgtType == 'Hamg' then
            set udg_Strain_CandidateAbil0[pId] = 'AHbz'
            set udg_Strain_CandidateAbil1[pId] = 'AHwe'
            set udg_Strain_CandidateAbil2[pId] = 'AHab'
            set udg_Strain_CandidateAbil3[pId] = 'AHmt'
        elseif tgtType == 'Hmkg' then
            set udg_Strain_CandidateAbil0[pId] = 'AHtb'
            set udg_Strain_CandidateAbil1[pId] = 'AHtc'
            set udg_Strain_CandidateAbil2[pId] = 'AHbh'
            set udg_Strain_CandidateAbil3[pId] = 'AHav'
        elseif tgtType == 'Hpal' then
            set udg_Strain_CandidateAbil0[pId] = 'AHhb'
            set udg_Strain_CandidateAbil1[pId] = 'AHds'
            set udg_Strain_CandidateAbil2[pId] = 'AHad'
            set udg_Strain_CandidateAbil3[pId] = 'AHre'
        elseif tgtType == 'Hblm' then
            set udg_Strain_CandidateAbil0[pId] = 'AHfs'
            set udg_Strain_CandidateAbil1[pId] = 'AHbn'
            set udg_Strain_CandidateAbil2[pId] = 'AHdr'
            set udg_Strain_CandidateAbil3[pId] = 'AHpx'
        elseif tgtType == 'Obla' then
            set udg_Strain_CandidateAbil0[pId] = 'AOwk'
            set udg_Strain_CandidateAbil1[pId] = 'AOmi'
            set udg_Strain_CandidateAbil2[pId] = 'AOcr'
            set udg_Strain_CandidateAbil3[pId] = 'AOww'
        elseif tgtType == 'Ofar' then
            set udg_Strain_CandidateAbil0[pId] = 'AOcl'
            set udg_Strain_CandidateAbil1[pId] = 'AOfs'
            set udg_Strain_CandidateAbil2[pId] = 'AOsf'
            set udg_Strain_CandidateAbil3[pId] = 'AOeq'
        elseif tgtType == 'Otch' then
            set udg_Strain_CandidateAbil0[pId] = 'AOsh'
            set udg_Strain_CandidateAbil1[pId] = 'AOws'
            set udg_Strain_CandidateAbil2[pId] = 'AOae'
            set udg_Strain_CandidateAbil3[pId] = 'AOre'
        elseif tgtType == 'Oshd' then
            set udg_Strain_CandidateAbil0[pId] = 'AOhw'
            set udg_Strain_CandidateAbil1[pId] = 'AOhx'
            set udg_Strain_CandidateAbil2[pId] = 'AOsw'
            set udg_Strain_CandidateAbil3[pId] = 'AOvd'
        elseif tgtType == 'Edem' then
            set udg_Strain_CandidateAbil0[pId] = 'AEmb'
            set udg_Strain_CandidateAbil1[pId] = 'AEim'
            set udg_Strain_CandidateAbil2[pId] = 'AEev'
            set udg_Strain_CandidateAbil3[pId] = 'AEme'
        elseif tgtType == 'Ekee' then
            set udg_Strain_CandidateAbil0[pId] = 'AEer'
            set udg_Strain_CandidateAbil1[pId] = 'AEfn'
            set udg_Strain_CandidateAbil2[pId] = 'AEah'
            set udg_Strain_CandidateAbil3[pId] = 'AEtq'
        elseif tgtType == 'Emoo' then
            set udg_Strain_CandidateAbil0[pId] = 'AHfa'
            set udg_Strain_CandidateAbil1[pId] = 'AEst'
            set udg_Strain_CandidateAbil2[pId] = 'AEar'
            set udg_Strain_CandidateAbil3[pId] = 'AEsf'
        elseif tgtType == 'Ewar' then
            set udg_Strain_CandidateAbil0[pId] = 'AEfk'
            set udg_Strain_CandidateAbil1[pId] = 'AEbl'
            set udg_Strain_CandidateAbil2[pId] = 'AEsh'
            set udg_Strain_CandidateAbil3[pId] = 'AEsv'
        elseif tgtType == 'Udea' then
            set udg_Strain_CandidateAbil0[pId] = 'AUdc'
            set udg_Strain_CandidateAbil1[pId] = 'AUdp'
            set udg_Strain_CandidateAbil2[pId] = 'AUau'
            set udg_Strain_CandidateAbil3[pId] = 'AUan'
        elseif tgtType == 'Ulic' then
            set udg_Strain_CandidateAbil0[pId] = 'AUfn'
            set udg_Strain_CandidateAbil1[pId] = 'AUfu'
            set udg_Strain_CandidateAbil2[pId] = 'AUdr'
            set udg_Strain_CandidateAbil3[pId] = 'AUdd'
        elseif tgtType == 'Udre' then
            set udg_Strain_CandidateAbil0[pId] = 'AUcs'
            set udg_Strain_CandidateAbil1[pId] = 'AUsl'
            set udg_Strain_CandidateAbil2[pId] = 'AUva'
            set udg_Strain_CandidateAbil3[pId] = 'AUin'
        else
            set udg_Strain_CandidateAbil0[pId] = 'AUim'
            set udg_Strain_CandidateAbil1[pId] = 'AUts'
            set udg_Strain_CandidateAbil2[pId] = 'AUcb'
            set udg_Strain_CandidateAbil3[pId] = 'AUls'
        endif

        if GetPlayerController(GetOwningPlayer(u)) == MAP_CONTROL_USER then
            call Strain_ShowSkillChoiceDialog(GetOwningPlayer(u), pId, "【顶端掠食 - 英雄基因同化】请选择掠夺技能：", 4)
        else
            call Strain_LearnOrUpgradeStolenAbil(u, pId, udg_Strain_CandidateAbil0[pId])
        endif
    else
        // Non-Hero unit: Creep, Lane unit, Summon Devoured!
        if udg_Strain_DigestFeedType[pId] == 1 then
            // Case C: Melee Unit without Mana -> Permanent Max HP bonus
            set bonusHP = R2I(I2R(30 + 10 * udg_Strain_DigestVictimLv[pId]) * mult + 0.5)
            call BlzSetUnitMaxHP(u, BlzGetUnitMaxHP(u) + bonusHP)
            call SetWidgetLife(u, GetWidgetLife(u) + I2R(bonusHP))
            set udg_Strain_TotalBonusHP[pId] = udg_Strain_TotalBonusHP[pId] + bonusHP
            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 4.0, "|cff00ff80[吞噬进化-近战猎物]|r 永久增加 " + I2S(bonusHP) + " 点最大生命值！（" + multStr + "收益，累计+" + I2S(udg_Strain_TotalBonusHP[pId]) + "生命）")
        elseif udg_Strain_DigestFeedType[pId] == 2 then
            // Case B: Ranged Unit without Mana -> Permanent Base Attack bonus (+1~2)
            if udg_Strain_DigestVictimLv[pId] <= 1 then
                set bonusAtk = R2I(1.0 * mult + 0.5)
            else
                set bonusAtk = R2I(2.0 * mult + 0.5)
            endif
            if bonusAtk < 1 then
                set bonusAtk = 1
            endif
            call BlzSetUnitBaseDamage(u, BlzGetUnitBaseDamage(u, 0) + bonusAtk, 0)
            set udg_Strain_TotalBonusAtk[pId] = udg_Strain_TotalBonusAtk[pId] + bonusAtk
            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 4.0, "|cffff6600[吞噬进化-远程猎物]|r 永久增加 " + I2S(bonusAtk) + " 点基础攻击力！（" + multStr + "收益，累计+" + I2S(udg_Strain_TotalBonusAtk[pId]) + "攻击）")
        else
            // Case A: Magical Unit -> Permanent Max Mana bonus
            set bonusMana = R2I(I2R(25 + 5 * udg_Strain_DigestVictimLv[pId]) * mult + 0.5)
            call BlzSetUnitMaxMana(u, BlzGetUnitMaxMana(u) + bonusMana)
            call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MANA) + I2R(bonusMana))
            set udg_Strain_TotalBonusMana[pId] = udg_Strain_TotalBonusMana[pId] + bonusMana
            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 4.0, "|cff33ccff[吞噬进化-魔法猎物]|r 永久增加 " + I2S(bonusMana) + " 点最大法力值！（" + multStr + "收益，累计+" + I2S(udg_Strain_TotalBonusMana[pId]) + "法力）")
        endif
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIam\\AIamTarget.mdl", u, "origin"))

        // Also check if unit has selectable skills (captured when swallowed)
        if udg_Strain_CandidateCount[pId] > 0 then
            if GetPlayerController(GetOwningPlayer(u)) == MAP_CONTROL_USER then
                call Strain_ShowSkillChoiceDialog(GetOwningPlayer(u), pId, "【基因掠夺 - 猎物技能库】请选择融入的技能：", udg_Strain_CandidateCount[pId])
            else
                call Strain_LearnOrUpgradeStolenAbil(u, pId, udg_Strain_CandidateAbil0[pId])
            endif
        else
            call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 4.0, "|cffaaaaaa（该猎物无特殊技能基因，已吸收纯粹肉体属性）|r")
        endif
    endif
endfunction

function DM_StealthLoop takes nothing returns nothing
    local integer i = 0
    local unit u = null
    local player p = null
    local unit dummy = null
    local integer hIdx = -1
    local boolean hasAgh = false
    local integer lv = 1
    local real dur = 30.0
    local unit enumU = null
    local integer pId = 0
    local unit checkU = null
    local boolean isRevealed = false
    local real dx = 0.0
    local real dy = 0.0

    // 1. Process pending stealth queue
    set i = 0
    loop
        exitwhen i >= udg_DM_StealthCount
        set udg_DM_StealthTimer[i] = udg_DM_StealthTimer[i] - 0.05
        if udg_DM_StealthTimer[i] <= 0.0 then
            set u = udg_DM_StealthUnit[i]
            set udg_DM_StealthUnit[i] = udg_DM_StealthUnit[udg_DM_StealthCount - 1]
            set udg_DM_StealthTimer[i] = udg_DM_StealthTimer[udg_DM_StealthCount - 1]
            set udg_DM_StealthUnit[udg_DM_StealthCount - 1] = null
            set udg_DM_StealthCount = udg_DM_StealthCount - 1
            set i = i - 1

            if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) then
                set p = GetOwningPlayer(u)
                set dummy = CreateUnit(p, 'u000', GetUnitX(u), GetUnitY(u), 0.0)
                call UnitAddAbility(dummy, 'A00V')
                call IssueTargetOrder(dummy, "invisibility", u)
                call UnitApplyTimedLife(dummy, 'BTLF', 1.0)
                set dummy = null
                set p = null

                call SetUnitVertexColor(u, 130, 150, 255, 120)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WindWalk\\WindWalkTarget.mdl", u, "origin"))

                set hIdx = DM_GetHeroIndex(u)
                set hasAgh = GetUnitAbilityLevel(u, 'A004') > 0
                set lv = GetUnitAbilityLevel(u, 'A001')
                set dur = 30.0 + I2R(lv) * 5.0

                if hasAgh then
                    call SetUnitMoveSpeed(u, 522.0)
                else
                    call SetUnitMoveSpeed(u, 400.0)
                endif

                if hIdx >= 0 then
                    set udg_DM_InStealth[hIdx] = true
                    set udg_DM_Backstab[hIdx] = true
                    set udg_DM_StealthDuration[hIdx] = dur
                endif
            endif
            set u = null
        endif
        set i = i + 1
    endloop

    // 2. Check active stealth duration
    set i = 0
    loop
        exitwhen i >= udg_DM_HeroCount
        if udg_DM_InStealth[i] then
            set udg_DM_StealthDuration[i] = udg_DM_StealthDuration[i] - 0.05
            if udg_DM_StealthDuration[i] <= 0.0 or IsUnitType(udg_DM_Hero[i], UNIT_TYPE_DEAD) then
                call DM_BreakInvisibility(udg_DM_Hero[i], null)
            endif
        endif
        set i = i + 1
    endloop

    // 3. Process Ninja pending heal
    set i = 0
    loop
        exitwhen i >= udg_Ninja_PendingCount
        if udg_Ninja_PendingHealUnit[i] != null and not IsUnitType(udg_Ninja_PendingHealUnit[i], UNIT_TYPE_DEAD) then
            call SetWidgetLife(udg_Ninja_PendingHealUnit[i], udg_Ninja_PendingHealHP[i])
        endif
        set udg_Ninja_PendingHealUnit[i] = null
        set i = i + 1
    endloop
    set udg_Ninja_PendingCount = 0

    // 4. Hero #3 Knockup Timer Loop
    set i = 0
    loop
        exitwhen i >= udg_Strain_KnockCount
        set udg_Strain_KnockTimer[i] = udg_Strain_KnockTimer[i] - 0.05
        set enumU = udg_Strain_KnockUnit[i]
        if enumU == null or IsUnitType(enumU, UNIT_TYPE_DEAD) or udg_Strain_KnockTimer[i] <= 0.0 then
            if enumU != null and not IsUnitType(enumU, UNIT_TYPE_DEAD) then
                call SetUnitFlyHeight(enumU, GetUnitDefaultFlyHeight(enumU), 750.0)
            endif
            set udg_Strain_KnockUnit[i] = udg_Strain_KnockUnit[udg_Strain_KnockCount - 1]
            set udg_Strain_KnockTimer[i] = udg_Strain_KnockTimer[udg_Strain_KnockCount - 1]
            set udg_Strain_KnockUnit[udg_Strain_KnockCount - 1] = null
            set udg_Strain_KnockCount = udg_Strain_KnockCount - 1
            set i = i - 1
        elseif udg_Strain_KnockTimer[i] <= 0.36 and udg_Strain_KnockTimer[i] >= 0.30 then
            call SetUnitFlyHeight(enumU, GetUnitDefaultFlyHeight(enumU), 750.0)
        endif
        set enumU = null
        set i = i + 1
    endloop

    // 5. Hero #3 Burrow Movement & Dust Loop
    set pId = 0
    loop
        exitwhen pId > 7
        if udg_Strain_Burrowed[pId] then
            set u = udg_Strain_Hero[pId]
            if u == null or IsUnitType(u, UNIT_TYPE_DEAD) then
                if u != null then
                    call Strain_Unburrow(u, pId)
                else
                    set udg_Strain_Burrowed[pId] = false
                    set udg_Strain_BurrowTimer[pId] = 0.0
                endif
            else
                set udg_Strain_BurrowTimer[pId] = udg_Strain_BurrowTimer[pId] - 0.05
                call SetUnitMoveSpeed(u, 522.0)
                if (R2I(udg_Strain_BurrowTimer[pId] * 20.0) - (R2I(udg_Strain_BurrowTimer[pId] * 20.0) / 6) * 6) == 0 then
                    call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl", u, "origin"))
                endif
                if udg_Strain_BurrowTimer[pId] <= 0.0 then
                    call Strain_Unburrow(u, pId)
                endif
            endif
            set u = null
        endif
        set pId = pId + 1
    endloop

    // 6. Hero #3 Mimicry Actor Position Sync & True Sight Check Loop
    set pId = 0
    loop
        exitwhen pId > 7
        if udg_Strain_MimicActive[pId] then
            set u = udg_Strain_Hero[pId]
            set enumU = udg_Strain_MimicActor[pId]
            if u == null or IsUnitType(u, UNIT_TYPE_DEAD) or enumU == null or IsUnitType(enumU, UNIT_TYPE_DEAD) then
                if u != null then
                    call Strain_BreakMimicry(u, pId)
                else
                    set udg_Strain_MimicActive[pId] = false
                    if enumU != null then
                        call RemoveUnit(enumU)
                        set udg_Strain_MimicActor[pId] = null
                    endif
                endif
            else
                // True Sight Detection Check
                call GroupClear(udg_EnumGroup)
                call GroupEnumUnitsInRange(udg_EnumGroup, GetUnitX(u), GetUnitY(u), 700.0, null)
                set isRevealed = false
                loop
                    set checkU = FirstOfGroup(udg_EnumGroup)
                    exitwhen checkU == null or isRevealed
                    call GroupRemoveUnit(udg_EnumGroup, checkU)
                    if IsUnitEnemy(checkU, GetOwningPlayer(u)) and not IsUnitType(checkU, UNIT_TYPE_DEAD) and GetUnitTypeId(checkU) != 'u000' and not IsUnitInGroup(checkU, udg_FakeHeroGroup) then
                        if IsUnitDetected(u, GetOwningPlayer(checkU)) then
                            set isRevealed = true
                        endif
                    endif
                endloop
                set checkU = null

                if isRevealed then
                    call Strain_BreakMimicry(u, pId)
                    set udg_Strain_AmbushReady[pId] = false
                    call DisplayTimedTextToPlayer(GetOwningPlayer(u), 0, 0, 3.0, "|cffffcc00[拟态伪装]|r 被敌方真视识破，伪装碎裂！")
                else
                    // Check movement & sync position/facing
                    set dx = GetUnitX(u) - GetUnitX(enumU)
                    set dy = GetUnitY(u) - GetUnitY(enumU)
                    call RemoveGuardPosition(enumU)
                    call SetUnitX(enumU, GetUnitX(u))
                    call SetUnitY(enumU, GetUnitY(u))
                    call SetUnitFacing(enumU, GetUnitFacing(u))

                    if dx * dx + dy * dy <= 4.0 then
                        call IssueImmediateOrder(enumU, "stop")
                    endif
                endif
            endif
            set u = null
            set enumU = null
        endif
        set pId = pId + 1
    endloop
endfunction

//===========================================================================
// Hero #4: The Wild Avatar (万灵化身 H005) System (v3.4 Full Flight, Range & Thrall System)
//===========================================================================

function Wild_GetCreepIndex takes integer cat, integer tier, integer sub returns integer
    return (cat - 1) * 30 + (tier - 1) * 3 + (sub - 1)
endfunction

function Wild_SetTpl takes integer cat, integer tier, integer sub, integer skin, string name, string btnLabel, integer hp, integer mana, integer dmg, real armor, real cool, real move, integer rangeN, real scale, integer abil, string abilName returns nothing
    local integer idx = (cat - 1) * 30 + (tier - 1) * 3 + (sub - 1)
    set udg_Wild_TplSkin[idx] = skin
    set udg_Wild_TplName[idx] = name
    set udg_Wild_TplBtnLabel[idx] = btnLabel
    set udg_Wild_TplHP[idx] = hp
    set udg_Wild_TplMana[idx] = mana
    set udg_Wild_TplDmg[idx] = dmg
    set udg_Wild_TplArmor[idx] = armor
    set udg_Wild_TplAtkCool[idx] = cool
    set udg_Wild_TplMove[idx] = move
    set udg_Wild_TplRange[idx] = rangeN
    set udg_Wild_TplScale[idx] = scale
    set udg_Wild_TplAbil[idx] = abil
    set udg_Wild_TplAbilName[idx] = abilName
endfunction

function Wild_GetCreepSkinId takes integer cat, integer tier, integer sub returns integer
    return udg_Wild_TplSkin[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepName takes integer cat, integer tier, integer sub returns string
    return udg_Wild_TplName[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepBtnLabel takes integer cat, integer tier, integer sub returns string
    return udg_Wild_TplBtnLabel[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepBaseHP takes integer cat, integer tier, integer sub returns integer
    return udg_Wild_TplHP[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepBaseMana takes integer cat, integer tier, integer sub returns integer
    return udg_Wild_TplMana[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepBaseDmg takes integer cat, integer tier, integer sub returns integer
    return udg_Wild_TplDmg[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepBaseArmor takes integer cat, integer tier, integer sub returns real
    return udg_Wild_TplArmor[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepAtkCool takes integer cat, integer tier, integer sub returns real
    return udg_Wild_TplAtkCool[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepMoveSpeed takes integer cat, integer tier, integer sub returns real
    return udg_Wild_TplMove[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepRange takes integer cat, integer tier, integer sub returns integer
    return udg_Wild_TplRange[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepScale takes integer cat, integer tier, integer sub returns real
    return udg_Wild_TplScale[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepAbil takes integer cat, integer tier, integer sub returns integer
    return udg_Wild_TplAbil[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

function Wild_GetCreepAbilName takes integer cat, integer tier, integer sub returns string
    return udg_Wild_TplAbilName[Wild_GetCreepIndex(cat, tier, sub)]
endfunction

