function Wild_IsFlyingCreep takes integer skinId returns boolean
    if skinId == 'nbwm' or skinId == 'nbdk' or skinId == 'nrwm' or skinId == 'nrdr' or skinId == 'nrdk' or skinId == 'nadw' or skinId == 'nadr' or skinId == 'nbzw' or skinId == 'nndk' or skinId == 'nfrl' then
        return true
    endif
    if skinId == 'nhar' or skinId == 'nhrw' or skinId == 'nhrh' or skinId == 'nhrq' then
        return true
    endif
    if skinId == 'nrvs' or skinId == 'nrvl' or skinId == 'nrvi' or skinId == 'ndrv' or skinId == 'nrvf' then
        return true
    endif
    return false
endfunction

function Wild_ApplyFlight takes unit u, integer skinId returns nothing
    if Wild_IsFlyingCreep(skinId) then
        call UnitAddAbility(u, 'Amrf')
        call UnitRemoveAbility(u, 'Amrf')
        call SetUnitFlyHeight(u, 260.0, 600.0)
        call SetUnitPathing(u, false)
    else
        call SetUnitFlyHeight(u, 0.0, 800.0)
        call SetUnitPathing(u, true)
    endif
endfunction

function Wild_GetCreepMissileArt takes integer skinId returns string
    if skinId == 'nbwm' or skinId == 'nbdk' or skinId == 'nrwm' or skinId == 'nrdr' or skinId == 'nrdk' then
        return "Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl"
    elseif skinId == 'nadw' or skinId == 'nadr' or skinId == 'nfrl' then
        return "Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl"
    elseif skinId == 'nbzw' then
        return "Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl"
    elseif skinId == 'nhar' or skinId == 'nhrw' or skinId == 'nhrh' or skinId == 'nhrq' then
        return "Abilities\\Weapons\\HarpyMissile\\HarpyMissile.mdl"
    elseif skinId == 'ncea' or skinId == 'ncnt' or skinId == 'ngna' or skinId == 'nrzg' or skinId == 'nrzs' then
        return "Abilities\\Weapons\\Arrow\\ArrowMissile.mdl"
    elseif skinId == 'nftt' or skinId == 'ndtt' or skinId == 'nitt' then
        return "Abilities\\Weapons\\Axe\\AxeMissile.mdl"
    elseif skinId == 'nltl' or skinId == 'nstw' or skinId == 'nslh' then
        return "Abilities\\Weapons\\Lightning\\LightningBolt.mdl"
    elseif skinId == 'nnwa' or skinId == 'nnwl' or skinId == 'nano' then
        return "Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl"
    elseif skinId == 'nrvs' or skinId == 'nrvl' or skinId == 'nrvi' or skinId == 'ndrv' or skinId == 'nrvf' then
        return "Abilities\\Weapons\\FrostNova\\FrostNovaTarget.mdl"
    elseif skinId == 'nerw' or skinId == 'nerd' or skinId == 'nwzg' or skinId == 'nfsp' or skinId == 'ncks' or skinId == 'nstl' then
        return "Abilities\\Weapons\\ShadowHunterMissile\\ShadowHunterMissile.mdl"
    endif
    return "Abilities\\Weapons\\KeeperGroveMissile\\KeeperGroveMissile.mdl"
endfunction

function Wild_GetCreepEffectiveScale takes integer skinId, integer tierLv, real baseScale returns real
    if tierLv == 10 then
        if skinId == 'nbwm' or skinId == 'nrwm' or skinId == 'nrdr' or skinId == 'nadw' or skinId == 'nbzw' or skinId == 'nggr' or skinId == 'ninf' or skinId == 'nerw' or skinId == 'nhyd' then
            return 1.85
        endif
        return 1.70
    endif
    if tierLv >= 7 then
        if skinId == 'nbwm' or skinId == 'nrwm' or skinId == 'nrdr' or skinId == 'nadw' or skinId == 'nbzw' or skinId == 'nmam' or skinId == 'nwrg' then
            return 1.55
        endif
    endif
    return baseScale
endfunction

function Wild_OnMorphSuccess takes unit u, integer formId returns nothing
    // Reserved hook for passive stacking
endfunction

function Wild_DoMorph takes unit u, integer cat, integer tierLv, integer subIdx returns nothing
    local player p = null
    local integer pId = 0
    local integer abilCode = 'A031'
    local integer sLv = 1
    local real mult = 0.55
    local real speedMult = 0.95
    local integer rank = 1
    local real cd = 10.0
    local string tierName = ""
    local integer skinId = 0
    local string name = ""
    local integer creepHP = 0
    local integer creepMana = 0
    local integer creepDmg = 0
    local real creepArmor = 0.0
    local real creepCool = 0.0
    local real creepMove = 0.0
    local integer creepRange = 128
    local real creepScale = 1.0
    local integer creepAbil = 0
    local string creepAbilName = ""
    local integer heroStr = 0
    local integer heroAgi = 0
    local integer heroInt = 0
    local integer hLv = 0
    local integer heroOwnHP = 0
    local integer heroOwnMana = 0
    local integer heroOwnDmg = 0
    local real heroOwnArmor = 0.0
    local integer finalMaxHP = 0
    local integer finalDmg = 0
    local real finalArmor = 0.0
    local integer finalMaxMana = 0
    local real finalAtkCool = 0.0
    local real oldHP = 0.0
    local real oldMaxHP = 0.0
    local real hpRatio = 1.0
    local real oldMaxMana = 0.0
    local integer newCurHP = 1
    local integer newCurMana = 0
    local string missileArt = ""
    local real effScale = 1.0

    if u == null or IsUnitType(u, UNIT_TYPE_DEAD) then
        return
    endif
    set p = GetOwningPlayer(u)
    set pId = GetPlayerId(p)

    if cat == 2 then
        set abilCode = 'A032'
    elseif cat == 3 then
        set abilCode = 'A033'
    endif
    set sLv = GetUnitAbilityLevel(u, abilCode)
    if sLv < 1 then
        set sLv = 1
    endif

    // v3.4 Smooth Fusion Formulas
    if sLv == 1 then
        set mult = 0.55
        set speedMult = 0.95
        set rank = 1
        set cd = 10.0
        set tierName = "【初阶融合 (+55%野怪面板)】"
    elseif sLv == 2 then
        set mult = 0.90
        set speedMult = 0.88
        set rank = 2
        set cd = 8.0
        set tierName = "【深度融合 (+90%野怪面板)】"
    else
        set mult = 1.30
        set speedMult = 0.80
        set rank = 3
        set cd = 6.0
        set tierName = "【完美共鸣 (+130%野怪面板，20%极速攻速)】"
    endif

    if tierLv < 1 then
        set tierLv = 1
    endif
    if tierLv > 10 then
        set tierLv = 10
    endif
    if subIdx < 1 then
        set subIdx = 1
    endif
    if subIdx > 3 then
        set subIdx = 3
    endif

    set skinId = Wild_GetCreepSkinId(cat, tierLv, subIdx)
    set name = Wild_GetCreepName(cat, tierLv, subIdx)
    set creepHP = Wild_GetCreepBaseHP(cat, tierLv, subIdx)
    set creepMana = Wild_GetCreepBaseMana(cat, tierLv, subIdx)
    set creepDmg = Wild_GetCreepBaseDmg(cat, tierLv, subIdx)
    set creepArmor = Wild_GetCreepBaseArmor(cat, tierLv, subIdx)
    set creepCool = Wild_GetCreepAtkCool(cat, tierLv, subIdx)
    set creepMove = Wild_GetCreepMoveSpeed(cat, tierLv, subIdx)
    set creepRange = Wild_GetCreepRange(cat, tierLv, subIdx)
    set creepScale = Wild_GetCreepScale(cat, tierLv, subIdx)
    set creepAbil = Wild_GetCreepAbil(cat, tierLv, subIdx)
    set creepAbilName = Wild_GetCreepAbilName(cat, tierLv, subIdx)

    set heroStr = GetHeroStr(u, true)
    set heroAgi = GetHeroAgi(u, true)
    set heroInt = GetHeroInt(u, true)
    set hLv = GetHeroLevel(u)

    set heroOwnHP = 550 + heroStr * 22 + hLv * 45
    set heroOwnMana = 250 + heroInt * 15 + hLv * 25
    set heroOwnDmg = 24 + R2I(I2R(heroStr + heroAgi + heroInt) * 0.65)
    set heroOwnArmor = 2.0 + I2R(heroAgi) * 0.25

    set finalMaxHP = heroOwnHP + R2I(I2R(creepHP) * mult)
    set finalDmg = heroOwnDmg + R2I(I2R(creepDmg) * mult)
    set finalArmor = heroOwnArmor + creepArmor * mult
    set finalAtkCool = creepCool * speedMult
    if creepMana > 0 then
        set finalMaxMana = heroOwnMana + R2I(I2R(creepMana) * mult)
    else
        set finalMaxMana = 0
    endif

    // Ratio preservation
    set oldHP = GetWidgetLife(u)
    set oldMaxHP = I2R(BlzGetUnitMaxHP(u))
    if oldMaxHP > 0.0 then
        set hpRatio = oldHP / oldMaxHP
    else
        set hpRatio = 1.0
    endif
    if hpRatio <= 0.0 then
        set hpRatio = 0.01
    endif
    if hpRatio > 1.0 then
        set hpRatio = 1.0
    endif

    set oldMaxMana = I2R(BlzGetUnitMaxMana(u))
    if oldMaxMana > 0.0 then
        set udg_Wild_StoredManaRatio[pId] = GetUnitState(u, UNIT_STATE_MANA) / oldMaxMana
        if udg_Wild_StoredManaRatio[pId] > 1.0 then
            set udg_Wild_StoredManaRatio[pId] = 1.0
        endif
    endif
    if udg_Wild_StoredManaRatio[pId] <= 0.0 then
        set udg_Wild_StoredManaRatio[pId] = 1.0
    endif

    // Remove old ability
    if udg_Wild_CurrentAbil[pId] != 0 then
        call UnitRemoveAbility(u, udg_Wild_CurrentAbil[pId])
        set udg_Wild_CurrentAbil[pId] = 0
    endif

    // Apply skin, name, scale
    call BlzSetUnitSkin(u, skinId)
    call BlzSetUnitName(u, "万灵化身 - " + name)
    set effScale = Wild_GetCreepEffectiveScale(skinId, tierLv, creepScale)
    call SetUnitScale(u, effScale, effScale, effScale)

    // Flight management
    call Wild_ApplyFlight(u, skinId)

    // Weapon Type & Range Management
    if creepRange >= 400 then
        set missileArt = Wild_GetCreepMissileArt(skinId)
        call SetUnitAcquireRange(u, 750.0)
        call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 0, I2R(creepRange))
        call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 1, I2R(creepRange))
        call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_PROJECTILE_SPEED, 0, 1100.0)
        call BlzSetUnitWeaponStringField(u, UNIT_WEAPON_SF_ATTACK_PROJECTILE_ART, 0, missileArt)
    else
        call SetUnitAcquireRange(u, 500.0)
        call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 0, 128.0)
        call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 1, 128.0)
    endif

    // Apply stats
    call BlzSetUnitMaxHP(u, finalMaxHP)
    set newCurHP = R2I(I2R(finalMaxHP) * hpRatio)
    if newCurHP < 1 then
        set newCurHP = 1
    endif
    call SetWidgetLife(u, I2R(newCurHP))

    if finalMaxMana > 0 then
        call BlzSetUnitMaxMana(u, finalMaxMana)
        set newCurMana = R2I(I2R(finalMaxMana) * udg_Wild_StoredManaRatio[pId])
        call SetUnitState(u, UNIT_STATE_MANA, I2R(newCurMana))
    else
        call BlzSetUnitMaxMana(u, 0)
        call SetUnitState(u, UNIT_STATE_MANA, 0.0)
    endif

    call BlzSetUnitBaseDamage(u, finalDmg, 0)
    call BlzSetUnitArmor(u, finalArmor)
    call BlzSetUnitAttackCooldown(u, finalAtkCool, 0)
    call SetUnitMoveSpeed(u, creepMove)

    // Attach creep ability
    if creepAbil != 0 then
        set udg_Wild_CurrentAbil[pId] = creepAbil
        call UnitAddAbility(u, creepAbil)
        call SetUnitAbilityLevel(u, creepAbil, rank)
        call UnitMakeAbilityPermanent(u, true, creepAbil)
    endif

    // State tracking
    set udg_Wild_IsMorphed[pId] = true
    set udg_Wild_CurrentForm[pId] = skinId
    set udg_Wild_CurrentFormType[pId] = cat
    set udg_Wild_CurrentFormLevel[pId] = tierLv
    set udg_Wild_MorphCD[pId] = cd

    call BlzStartUnitAbilityCooldown(u, 'A031', cd)
    call BlzStartUnitAbilityCooldown(u, 'A032', cd)
    call BlzStartUnitAbilityCooldown(u, 'A033', cd)

    call Wild_OnMorphSuccess(u, skinId)

    // Screen display to human player
    if GetPlayerController(p) == MAP_CONTROL_USER then
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffffcc00[万灵化形]|r 成功化身为 |cffff8000【" + name + "】|r！" + tierName)
        call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "面板属性: 生命: |cff00ff00" + I2S(finalMaxHP) + "|r | 攻击: |cffff6600" + I2S(finalDmg) + "|r | 护甲: |cff33ccff" + R2SW(finalArmor, 1, 1) + "|r | 攻速: |cffffff00" + R2SW(finalAtkCool, 1, 2) + "s|r | 特技: |cffffcc00" + creepAbilName + " (" + I2S(rank) + "阶)|r")
    endif

    set p = null
endfunction

function Wild_RevertToAvatar takes unit u returns nothing
    local player p = null
    local integer pId = 0
    local real oldHP = 0.0
    local real oldMaxHP = 0.0
    local real hpRatio = 1.0
    local real oldMaxMana = 0.0
    local integer heroStr = 0
    local integer heroAgi = 0
    local integer heroInt = 0
    local integer hLv = 0
    local integer baseMaxHP = 0
    local integer baseMaxMana = 0
    local integer baseDmg = 0
    local real baseArmor = 0.0
    local real baseCool = 1.50
    local real baseMove = 310.0
    local integer baseRange = 600
    local integer newCurHP = 1
    local integer newCurMana = 0

    if u == null or IsUnitType(u, UNIT_TYPE_DEAD) then
        return
    endif
    set p = GetOwningPlayer(u)
    set pId = GetPlayerId(p)

    if not udg_Wild_IsMorphed[pId] then
        if GetPlayerController(p) == MAP_CONTROL_USER then
            call DisplayTimedTextToPlayer(p, 0, 0, 2.0, "|cffffcc00[万灵化身]|r 当前已处于本体神体形态。")
        endif
        set p = null
        return
    endif

    // Ratio preservation
    set oldHP = GetWidgetLife(u)
    set oldMaxHP = I2R(BlzGetUnitMaxHP(u))
    if oldMaxHP > 0.0 then
        set hpRatio = oldHP / oldMaxHP
    else
        set hpRatio = 1.0
    endif
    if hpRatio <= 0.0 then
        set hpRatio = 0.01
    endif
    if hpRatio > 1.0 then
        set hpRatio = 1.0
    endif

    set oldMaxMana = I2R(BlzGetUnitMaxMana(u))
    if oldMaxMana > 0.0 then
        set udg_Wild_StoredManaRatio[pId] = GetUnitState(u, UNIT_STATE_MANA) / oldMaxMana
        if udg_Wild_StoredManaRatio[pId] > 1.0 then
            set udg_Wild_StoredManaRatio[pId] = 1.0
        endif
    endif
    if udg_Wild_StoredManaRatio[pId] <= 0.0 then
        set udg_Wild_StoredManaRatio[pId] = 1.0
    endif

    // Remove attached creep ability
    if udg_Wild_CurrentAbil[pId] != 0 then
        call UnitRemoveAbility(u, udg_Wild_CurrentAbil[pId])
        set udg_Wild_CurrentAbil[pId] = 0
    endif

    // Restore skin, name, scale
    call BlzSetUnitSkin(u, 'H005')
    call BlzSetUnitName(u, "万灵化身")
    call SetUnitScale(u, 1.10, 1.10, 1.10)

    // Land back to ground
    call SetUnitFlyHeight(u, 0.0, 800.0)
    call SetUnitPathing(u, true)

    // Base stats
    set heroStr = GetHeroStr(u, true)
    set heroAgi = GetHeroAgi(u, true)
    set heroInt = GetHeroInt(u, true)
    set hLv = GetHeroLevel(u)

    set baseMaxHP = 550 + heroStr * 22 + hLv * 45
    set baseMaxMana = 250 + heroInt * 15 + hLv * 25
    set baseDmg = 24 + R2I(I2R(heroStr + heroAgi + heroInt) * 0.65)
    set baseArmor = 2.0 + I2R(heroAgi) * 0.25
    set baseCool = 1.50
    set baseMove = 310.0
    set baseRange = 600

    call BlzSetUnitMaxHP(u, baseMaxHP)
    set newCurHP = R2I(I2R(baseMaxHP) * hpRatio)
    if newCurHP < 1 then
        set newCurHP = 1
    endif
    call SetWidgetLife(u, I2R(newCurHP))

    call BlzSetUnitMaxMana(u, baseMaxMana)
    set newCurMana = R2I(I2R(baseMaxMana) * udg_Wild_StoredManaRatio[pId])
    call SetUnitState(u, UNIT_STATE_MANA, I2R(newCurMana))

    call BlzSetUnitBaseDamage(u, baseDmg, 0)
    call BlzSetUnitArmor(u, baseArmor)
    call BlzSetUnitAttackCooldown(u, baseCool, 0)
    call SetUnitMoveSpeed(u, baseMove)

    // Restore 600 range missile
    call SetUnitAcquireRange(u, 700.0)
    call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 0, 600.0)
    call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_RANGE, 1, 600.0)
    call BlzSetUnitWeaponRealField(u, UNIT_WEAPON_RF_ATTACK_PROJECTILE_SPEED, 0, 1000.0)
    call BlzSetUnitWeaponStringField(u, UNIT_WEAPON_SF_ATTACK_PROJECTILE_ART, 0, "Abilities\\Weapons\\KeeperGroveMissile\\KeeperGroveMissile.mdl")

    set udg_Wild_IsMorphed[pId] = false
    set udg_Wild_CurrentForm[pId] = 0
    set udg_Wild_CurrentFormType[pId] = 0
    set udg_Wild_CurrentFormLevel[pId] = 0

    if GetPlayerController(p) == MAP_CONTROL_USER then
        call DisplayTimedTextToPlayer(p, 0, 0, 3.0, "|cffffcc00[万灵化身]|r 已返璞归真，恢复自然神体！")
    endif

    set p = null
endfunction

function Wild_InitHero takes unit h returns nothing
    local integer pId = 0
    if h == null then
        return
    endif
    set pId = GetPlayerId(GetOwningPlayer(h))
    set udg_Wild_Hero[pId] = h
    if GetUnitAbilityLevel(h, 'A034') == 0 then
        call UnitAddAbility(h, 'A034')
    endif
    if udg_Wild_IsMorphed[pId] then
        call Wild_RevertToAvatar(h)
    endif
endfunction

function Wild_ShowTierDialog takes player p, integer cat returns nothing
    local integer pId = 0
    local unit u = null
    local integer heroLv = 1
    local integer lvl = 1
    local string title = ""
    local string btnText = ""
    local integer hotkey = 49

    if p == null then
        return
    endif
    set pId = GetPlayerId(p)
    set u = udg_Wild_Hero[pId]
    if u == null or IsUnitType(u, UNIT_TYPE_DEAD) then
        return
    endif

    if udg_Wild_MorphCD[pId] > 0.0 then
        call DisplayTimedTextToPlayer(p, 0, 0, 3.0, "|cffffcc00[万灵化形]|r 变身冷却中，剩余 " + R2SW(udg_Wild_MorphCD[pId], 1, 1) + " 秒！")
        return
    endif

    set heroLv = GetHeroLevel(u)
    if heroLv < 1 then
        set heroLv = 1
    endif
    if heroLv > 10 then
        set heroLv = 10
    endif

    set udg_Wild_PendingCat[pId] = cat
    call DialogDisplay(p, udg_Wild_MorphDialog, false)
    call DialogClear(udg_Wild_MorphDialog)

    if cat == 1 then
        set title = "|cffffcc00[万灵化身·狂野巨力]|r 请选择力量近战野怪等级 (英雄等级: Lv" + I2S(heroLv) + "):"
    elseif cat == 2 then
        set title = "|cffffcc00[万灵化身·诡诈迅影]|r 请选择敏捷远程野怪等级 (英雄等级: Lv" + I2S(heroLv) + "):"
    else
        set title = "|cffffcc00[万灵化身·万相灵音]|r 请选择智力法术野怪等级 (英雄等级: Lv" + I2S(heroLv) + "):"
    endif
    call DialogSetMessage(udg_Wild_MorphDialog, title)

    set lvl = 1
    loop
        exitwhen lvl > heroLv
        set btnText = "[" + I2S(lvl) + "] " + I2S(lvl) + "级野怪"
        if lvl <= 9 then
            set hotkey = 48 + lvl
        else
            set hotkey = 48
        endif
        set udg_Wild_TierBtn[lvl] = DialogAddButton(udg_Wild_MorphDialog, btnText, hotkey)
        set lvl = lvl + 1
    endloop

    set udg_Wild_TierCancelBtn = DialogAddButton(udg_Wild_MorphDialog, "[0] 取消", 48)
    set udg_Wild_DialogState[pId] = 1
    call DialogDisplay(p, udg_Wild_MorphDialog, true)
endfunction

function Wild_ShowSubDialog takes player p, integer cat, integer tierLv returns nothing
    local integer pId = 0
    local unit u = null
    local string title = ""
    local string btnText = ""
    local integer subIdx = 1

    if p == null then
        return
    endif
    set pId = GetPlayerId(p)
    set u = udg_Wild_Hero[pId]
    if u == null or IsUnitType(u, UNIT_TYPE_DEAD) then
        return
    endif

    call DialogDisplay(p, udg_Wild_MorphDialog, false)
    call DialogClear(udg_Wild_MorphDialog)

    set title = "|cffffcc00[万灵化形 - " + I2S(tierLv) + "级野怪]|r 请选择化形目标:"
    call DialogSetMessage(udg_Wild_MorphDialog, title)

    set subIdx = 1
    loop
        exitwhen subIdx > 3
        set btnText = "[" + I2S(subIdx) + "] " + Wild_GetCreepBtnLabel(cat, tierLv, subIdx)
        set udg_Wild_SubBtn[subIdx] = DialogAddButton(udg_Wild_MorphDialog, btnText, 48 + subIdx)
        set subIdx = subIdx + 1
    endloop

    set udg_Wild_SubBackBtn = DialogAddButton(udg_Wild_MorphDialog, "[4] 返回上一级 (重选等级)", 52)
    set udg_Wild_SubCancelBtn = DialogAddButton(udg_Wild_MorphDialog, "[0] 取消", 48)

    set udg_Wild_DialogState[pId] = 2
    call DialogDisplay(p, udg_Wild_MorphDialog, true)
endfunction

function Wild_OnMorphDialogClick takes nothing returns nothing
    local button b = GetClickedButton()
    local player p = GetTriggerPlayer()
    local integer pId = 0
    local unit u = null
    local integer state = 0
    local integer cat = 1
    local integer tier = 1
    local integer i = 1

    if p == null or b == null then
        return
    endif
    set pId = GetPlayerId(p)
    set u = udg_Wild_Hero[pId]
    if u == null or IsUnitType(u, UNIT_TYPE_DEAD) then
        set b = null
        set p = null
        return
    endif

    set state = udg_Wild_DialogState[pId]
    set cat = udg_Wild_PendingCat[pId]
    set tier = udg_Wild_PendingTier[pId]

    call DialogDisplay(p, udg_Wild_MorphDialog, false)

    // State 1: Selecting Tier
    if state == 1 then
        if b == udg_Wild_TierCancelBtn then
            set udg_Wild_DialogState[pId] = 0
            set b = null
            set p = null
            return
        endif
        set i = 1
        loop
            exitwhen i > 10
            if b == udg_Wild_TierBtn[i] then
                set udg_Wild_PendingTier[pId] = i
                call Wild_ShowSubDialog(p, cat, i)
                set b = null
                set p = null
                return
            endif
            set i = i + 1
        endloop

    // State 2: Selecting Sub Creep
    elseif state == 2 then
        if b == udg_Wild_SubCancelBtn then
            set udg_Wild_DialogState[pId] = 0
            set b = null
            set p = null
            return
        endif
        if b == udg_Wild_SubBackBtn then
            call Wild_ShowTierDialog(p, cat)
            set b = null
            set p = null
            return
        endif
        set i = 1
        loop
            exitwhen i > 3
            if b == udg_Wild_SubBtn[i] then
                set udg_Wild_DialogState[pId] = 0
                call Wild_DoMorph(u, cat, tier, i)
                set b = null
                set p = null
                return
            endif
            set i = i + 1
        endloop
    endif

    set b = null
    set p = null
endfunction

function Wild_IsWorkerOrTrash takes unit u returns boolean
    local integer uId = 0
    if u == null then
        return true
    endif
    set uId = GetUnitTypeId(u)
    if IsUnitType(u, UNIT_TYPE_PEON) then
        return true
    endif
    if uId == 'ewsp' or uId == 'opeo' or uId == 'hpea' or uId == 'uaco' or uId == 'ugho' then
        return true
    endif
    if GetUnitLevel(u) < 3 or BlzGetUnitMaxHP(u) < 420 then
        return true
    endif
    return false
endfunction

function Wild_AddSoulStack takes integer pId returns nothing
    local unit enumU = null
    local boolean isEven = false
    if pId < 0 or pId > 15 then
        return
    endif
    set udg_Wild_SoulStacks[pId] = udg_Wild_SoulStacks[pId] + 1
    set udg_Wild_ArmyBonusHP[pId] = udg_Wild_SoulStacks[pId] * 4
    set udg_Wild_ArmyBonusDmg[pId] = udg_Wild_SoulStacks[pId] / 2
    set isEven = (ModuloInteger(udg_Wild_SoulStacks[pId], 2) == 0)

    // Real-time buff for active summons in the field
    call GroupClear(udg_EnumGroup)
    call GroupAddGroup(udg_Wild_ArmyGroup, udg_EnumGroup)
    loop
        set enumU = FirstOfGroup(udg_EnumGroup)
        exitwhen enumU == null
        call GroupRemoveUnit(udg_EnumGroup, enumU)
        if GetOwningPlayer(enumU) == Player(pId) and not IsUnitType(enumU, UNIT_TYPE_DEAD) then
            call BlzSetUnitMaxHP(enumU, BlzGetUnitMaxHP(enumU) + 4)
            call SetWidgetLife(enumU, GetWidgetLife(enumU) + 4.0)
            if isEven then
                call BlzSetUnitBaseDamage(enumU, BlzGetUnitBaseDamage(enumU, 0) + 1, 0)
            endif
        endif
    endloop
    set enumU = null
endfunction

function Wild_SpawnArmyCreep takes player p, integer unitTypeId, real x, real y, integer bonusHP, integer bonusDmg returns unit
    local unit u = CreateUnit(p, unitTypeId, x, y, 0.0)
    local integer maxHP = 0
    local integer baseDmg = 0
    call UnitApplyTimedLife(u, 'BTLF', 90.0)
    if bonusHP > 0 then
        set maxHP = BlzGetUnitMaxHP(u) + bonusHP
        call BlzSetUnitMaxHP(u, maxHP)
        call SetWidgetLife(u, I2R(maxHP))
    endif
    if bonusDmg > 0 then
        set baseDmg = BlzGetUnitBaseDamage(u, 0) + bonusDmg
        call BlzSetUnitBaseDamage(u, baseDmg, 0)
    endif
    call GroupAddUnit(udg_Wild_ArmyGroup, u)
    return u
endfunction

function Wild_GetTargetBaseX takes player p returns real
    local integer pId = GetPlayerId(p)
    local integer targetId = 0
    if pId >= 0 and pId <= 3 then
        set targetId = 4
    else
        set targetId = 0
    endif
    return GetStartLocationX(targetId)
endfunction

function Wild_GetTargetBaseY takes player p returns real
    local integer pId = GetPlayerId(p)
    local integer targetId = 0
    if pId >= 0 and pId <= 3 then
        set targetId = 4
    else
        set targetId = 0
    endif
    return GetStartLocationY(targetId)
endfunction

function Wild_EnslaveHero takes integer pId, unit deadHero returns nothing
    local integer count = 0
    local integer slot = 0
    local integer idx = 0
    local integer skinId = 0
    local string heroName = ""
    local integer heroLv = 1
    local integer maxHP = 0
    local integer maxMana = 0
    local integer baseDmg = 0
    local real armor = 0.0
    local integer primaryBonus = 0
    local item it = null
    local integer s = 0
    local integer abilFound = 0
    local integer aId = 0
    local integer aLv = 0
    local integer i = 0

    if deadHero == null or pId < 0 or pId > 15 then
        return
    endif

    call Wild_AddSoulStack(pId)

    set count = udg_Wild_HeroThrallCount[pId]
    if count < 8 then
        set slot = count
        set udg_Wild_HeroThrallCount[pId] = count + 1
    else
        set slot = 7
    endif
    set idx = pId * 8 + slot

    set skinId = BlzGetUnitSkin(deadHero)
    if skinId == 0 then
        set skinId = GetUnitTypeId(deadHero)
    endif
    set heroName = GetUnitName(deadHero)
    set heroLv = GetHeroLevel(deadHero)
    set maxHP = BlzGetUnitMaxHP(deadHero)
    set maxMana = BlzGetUnitMaxMana(deadHero)
    set primaryBonus = GetHeroStr(deadHero, true)
    if GetHeroAgi(deadHero, true) > primaryBonus then
        set primaryBonus = GetHeroAgi(deadHero, true)
    endif
    if GetHeroInt(deadHero, true) > primaryBonus then
        set primaryBonus = GetHeroInt(deadHero, true)
    endif
    set baseDmg = BlzGetUnitBaseDamage(deadHero, 0) + primaryBonus
    set armor = BlzGetUnitArmor(deadHero)

    set udg_Wild_ThrallSkin[idx] = skinId
    set udg_Wild_ThrallName[idx] = heroName
    set udg_Wild_ThrallLevel[idx] = heroLv
    set udg_Wild_ThrallHP[idx] = maxHP
    set udg_Wild_ThrallMana[idx] = maxMana
    set udg_Wild_ThrallDmg[idx] = baseDmg
    set udg_Wild_ThrallArmor[idx] = armor

    // Clear passives
    set udg_Wild_ThrallAbil1[idx] = 0
    set udg_Wild_ThrallAbil2[idx] = 0
    set udg_Wild_ThrallAbil3[idx] = 0
    set udg_Wild_ThrallAbil4[idx] = 0
    set udg_Wild_ThrallAbilLv1[idx] = 1
    set udg_Wild_ThrallAbilLv2[idx] = 1
    set udg_Wild_ThrallAbilLv3[idx] = 1
    set udg_Wild_ThrallAbilLv4[idx] = 1

    // Scan known passives
    set abilFound = 0
    set i = 1
    loop
        exitwhen i > 22 or abilFound >= 4
        if i == 1 then
            set aId = 'AOcr'
        elseif i == 2 then
            set aId = 'AEev'
        elseif i == 3 then
            set aId = 'AHbh'
        elseif i == 4 then
            set aId = 'AHad'
        elseif i == 5 then
            set aId = 'AHab'
        elseif i == 6 then
            set aId = 'AOae'
        elseif i == 7 then
            set aId = 'AUau'
        elseif i == 8 then
            set aId = 'AUav'
        elseif i == 9 then
            set aId = 'AEar'
        elseif i == 10 then
            set aId = 'AEah'
        elseif i == 11 then
            set aId = 'AUts'
        elseif i == 12 then
            set aId = 'A015'
        elseif i == 13 then
            set aId = 'A017'
        elseif i == 14 then
            set aId = 'ACct'
        elseif i == 15 then
            set aId = 'ACev'
        elseif i == 16 then
            set aId = 'ACbh'
        elseif i == 17 then
            set aId = 'ACav'
        elseif i == 18 then
            set aId = 'ACdv'
        elseif i == 19 then
            set aId = 'ACcs'
        elseif i == 20 then
            set aId = 'A025'
        elseif i == 21 then
            set aId = 'A026'
        else
            set aId = 'ACen'
        endif

        set aLv = GetUnitAbilityLevel(deadHero, aId)
        if aLv > 0 then
            set abilFound = abilFound + 1
            if abilFound == 1 then
                set udg_Wild_ThrallAbil1[idx] = aId
                set udg_Wild_ThrallAbilLv1[idx] = aLv
            elseif abilFound == 2 then
                set udg_Wild_ThrallAbil2[idx] = aId
                set udg_Wild_ThrallAbilLv2[idx] = aLv
            elseif abilFound == 3 then
                set udg_Wild_ThrallAbil3[idx] = aId
                set udg_Wild_ThrallAbilLv3[idx] = aLv
            elseif abilFound == 4 then
                set udg_Wild_ThrallAbil4[idx] = aId
                set udg_Wild_ThrallAbilLv4[idx] = aLv
            endif
        endif
        set i = i + 1
    endloop

    // Scan 6 items
    set s = 0
    loop
        exitwhen s > 5
        set it = UnitItemInSlot(deadHero, s)
        if it != null then
            if s == 0 then
                set udg_Wild_ThrallItem0[idx] = GetItemTypeId(it)
            elseif s == 1 then
                set udg_Wild_ThrallItem1[idx] = GetItemTypeId(it)
            elseif s == 2 then
                set udg_Wild_ThrallItem2[idx] = GetItemTypeId(it)
            elseif s == 3 then
                set udg_Wild_ThrallItem3[idx] = GetItemTypeId(it)
            elseif s == 4 then
                set udg_Wild_ThrallItem4[idx] = GetItemTypeId(it)
            elseif s == 5 then
                set udg_Wild_ThrallItem5[idx] = GetItemTypeId(it)
            endif
        else
            if s == 0 then
                set udg_Wild_ThrallItem0[idx] = 0
            elseif s == 1 then
                set udg_Wild_ThrallItem1[idx] = 0
            elseif s == 2 then
                set udg_Wild_ThrallItem2[idx] = 0
            elseif s == 3 then
                set udg_Wild_ThrallItem3[idx] = 0
            elseif s == 4 then
                set udg_Wild_ThrallItem4[idx] = 0
            elseif s == 5 then
                set udg_Wild_ThrallItem5[idx] = 0
            endif
        endif
        set s = s + 1
    endloop

    call DisplayTimedTextToPlayer(Player(pId), 0, 0, 6.0, "|cffff00ff[众野之怒·为虎作伥]|r 已将阵亡的英雄【" + heroName + " (Lv" + I2S(heroLv) + ")】连同其随身装备与被动技能永久炼化为【荒野伥鬼】！下次释放大招将随军出征！")
endfunction

function Wild_EnslaveCreep takes integer pId, unit deadCreep returns nothing
    local integer count = 0
    local integer uId = 0
    local integer deadPower = 0
    local integer minSlot = 0
    local integer minPower = 0
    local integer s = 0

    if deadCreep == null or pId < 0 or pId > 15 then
        return
    endif

    // Unconditionally add Soul Stack (+4 HP, +0.5 Dmg) and buff field units in real-time
    call Wild_AddSoulStack(pId)

    // Filter out workers & trash creeps: they do NOT occupy the 12 elite thrall slots
    if Wild_IsWorkerOrTrash(deadCreep) then
        return
    endif

    set count = udg_Wild_CreepThrallCount[pId]
    set uId = GetUnitTypeId(deadCreep)
    set deadPower = GetUnitLevel(deadCreep) * 1000 + BlzGetUnitMaxHP(deadCreep)

    if count < 12 then
        set udg_Wild_CreepThrallType[pId * 12 + count] = uId
        set udg_Wild_CreepThrallPower[pId * 12 + count] = deadPower
        set udg_Wild_CreepThrallCount[pId] = count + 1
    else
        // 12 slots full: Survival of the Fittest (replace weakest creep if newly killed creep is stronger)
        set minSlot = 0
        set minPower = udg_Wild_CreepThrallPower[pId * 12 + 0]
        set s = 1
        loop
            exitwhen s >= 12
            if udg_Wild_CreepThrallPower[pId * 12 + s] < minPower then
                set minPower = udg_Wild_CreepThrallPower[pId * 12 + s]
                set minSlot = s
            endif
            set s = s + 1
        endloop

        if deadPower > minPower then
            set udg_Wild_CreepThrallType[pId * 12 + minSlot] = uId
            set udg_Wild_CreepThrallPower[pId * 12 + minSlot] = deadPower
        endif
    endif
    // Completely silent: 0 screen spam for normal kills!
endfunction

function Wild_CastWrath takes unit caster returns nothing
    local player p = null
    local integer pId = 0
    local integer dRank = 1
    local real cx = 0.0
    local real cy = 0.0
    local unit c = null
    local unit thrall = null
    local integer s = 0
    local integer idx = 0
    local integer finalHP = 0
    local integer finalDmg = 0
    local integer itId = 0
    local item it = null
    local integer i = 0
    local integer cIdx = 0
    local integer tType = 0
    local integer bonusHP = 0
    local integer bonusDmg = 0

    if caster == null or IsUnitType(caster, UNIT_TYPE_DEAD) then
        return
    endif
    set p = GetOwningPlayer(caster)
    set pId = GetPlayerId(p)
    set dRank = GetUnitAbilityLevel(caster, 'A035')
    if dRank < 1 then
        set dRank = 1
    endif
    set cx = GetUnitX(caster)
    set cy = GetUnitY(caster)

    set udg_Wild_WrathTimer[pId] = 90.0

    set bonusHP = udg_Wild_ArmyBonusHP[pId]
    set bonusDmg = udg_Wild_ArmyBonusDmg[pId]

    call DisplayTimedTextToPlayer(p, 0, 0, 5.0, "|cffff0000[众野之怒]|r 荒野狂潮冲锋！野怪与炼化伥鬼大军已向敌方核心基地发起狂暴推进！")
    call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cffffcc00[伥鬼军势]|r 随军出征: 伪英雄伥鬼: |cffff8000" + I2S(udg_Wild_HeroThrallCount[pId]) + "/8|r 位 | 精锐精魄伥鬼: |cff33ccff" + I2S(udg_Wild_CreepThrallCount[pId]) + "/12|r 头 | 百鬼军魂: |cff00ff00" + I2S(udg_Wild_SoulStacks[pId]) + "|r 层 (全军永久 |cff00ff00+" + I2S(bonusHP) + " HP|r / |cffff6600+" + I2S(bonusDmg) + " 攻击|r)！")

    // Tier 1: Rank 1 (Lv 6)
    if dRank == 1 then
        set c = Wild_SpawnArmyCreep(p, 'nhyd', cx + 70.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nhyd', cx - 70.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nnwa', cx, cy + 70.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nnwa', cx, cy - 70.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nfrs', cx + 100.0, cy + 100.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nfrs', cx - 100.0, cy - 100.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nogr', cx + 130.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nogr', cx - 130.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nrzs', cx, cy + 130.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nrzs', cx, cy - 130.0, bonusHP, bonusDmg)

    // Tier 2: Rank 2 (Lv 8)
    elseif dRank == 2 then
        set c = Wild_SpawnArmyCreep(p, 'nfrb', cx + 80.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nmam', cx - 80.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nrvl', cx, cy + 80.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nbdo', cx, cy - 80.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nfrs', cx + 110.0, cy + 110.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nfrs', cx - 110.0, cy - 110.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nhyd', cx + 140.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nhyd', cx - 140.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nstw', cx, cy + 140.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nstw', cx, cy - 140.0, bonusHP, bonusDmg)

    // Tier 3: Rank 3 (Lv 10) - Supreme Boss Wave
    else
        set c = Wild_SpawnArmyCreep(p, 'nbwm', cx + 100.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nggr', cx - 100.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nrdr', cx, cy + 100.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nerw', cx, cy - 100.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nwrg', cx + 140.0, cy + 140.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nmam', cx - 140.0, cy - 140.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nbdo', cx + 140.0, cy - 140.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'ninf', cx - 140.0, cy + 140.0, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nhyd', cx + 180.0, cy, bonusHP, bonusDmg)
        set c = Wild_SpawnArmyCreep(p, 'nfrb', cx - 180.0, cy, bonusHP, bonusDmg)
    endif

    // Spawn Enslaved Hero Thralls (u003)
    set s = 0
    loop
        exitwhen s >= udg_Wild_HeroThrallCount[pId]
        set idx = pId * 8 + s
        set thrall = CreateUnit(p, 'u003', cx + GetRandomReal(-150.0, 150.0), cy + GetRandomReal(-150.0, 150.0), 0.0)
        call UnitApplyTimedLife(thrall, 'BTLF', 90.0)
        call BlzSetUnitSkin(thrall, udg_Wild_ThrallSkin[idx])
        call SetUnitVertexColor(thrall, 170, 210, 255, 225)
        call BlzSetUnitName(thrall, "【伥鬼】" + udg_Wild_ThrallName[idx] + "(Lv" + I2S(udg_Wild_ThrallLevel[idx]) + ")")

        set finalHP = udg_Wild_ThrallHP[idx] + bonusHP
        set finalDmg = udg_Wild_ThrallDmg[idx] + bonusDmg
        call BlzSetUnitMaxHP(thrall, finalHP)
        call SetWidgetLife(thrall, I2R(finalHP))
        if udg_Wild_ThrallMana[idx] > 0 then
            call BlzSetUnitMaxMana(thrall, udg_Wild_ThrallMana[idx])
            call SetUnitState(thrall, UNIT_STATE_MANA, I2R(udg_Wild_ThrallMana[idx]))
        endif
        call BlzSetUnitBaseDamage(thrall, finalDmg, 0)
        call BlzSetUnitArmor(thrall, udg_Wild_ThrallArmor[idx])

        // Passives
        if udg_Wild_ThrallAbil1[idx] != 0 then
            call UnitAddAbility(thrall, udg_Wild_ThrallAbil1[idx])
            call SetUnitAbilityLevel(thrall, udg_Wild_ThrallAbil1[idx], udg_Wild_ThrallAbilLv1[idx])
        endif
        if udg_Wild_ThrallAbil2[idx] != 0 then
            call UnitAddAbility(thrall, udg_Wild_ThrallAbil2[idx])
            call SetUnitAbilityLevel(thrall, udg_Wild_ThrallAbil2[idx], udg_Wild_ThrallAbilLv2[idx])
        endif
        if udg_Wild_ThrallAbil3[idx] != 0 then
            call UnitAddAbility(thrall, udg_Wild_ThrallAbil3[idx])
            call SetUnitAbilityLevel(thrall, udg_Wild_ThrallAbil3[idx], udg_Wild_ThrallAbilLv3[idx])
        endif
        if udg_Wild_ThrallAbil4[idx] != 0 then
            call UnitAddAbility(thrall, udg_Wild_ThrallAbil4[idx])
            call SetUnitAbilityLevel(thrall, udg_Wild_ThrallAbil4[idx], udg_Wild_ThrallAbilLv4[idx])
        endif

        // Items 0..5
        set i = 0
        loop
            exitwhen i > 5
            if i == 0 then
                set itId = udg_Wild_ThrallItem0[idx]
            elseif i == 1 then
                set itId = udg_Wild_ThrallItem1[idx]
            elseif i == 2 then
                set itId = udg_Wild_ThrallItem2[idx]
            elseif i == 3 then
                set itId = udg_Wild_ThrallItem3[idx]
            elseif i == 4 then
                set itId = udg_Wild_ThrallItem4[idx]
            elseif i == 5 then
                set itId = udg_Wild_ThrallItem5[idx]
            endif
            if itId != 0 then
                set it = UnitAddItemById(thrall, itId)
                if it != null then
                    call SetItemDroppable(it, false)
                    call SetItemPawnable(it, false)
                endif
            endif
            set i = i + 1
        endloop

        call GroupAddUnit(udg_Wild_ArmyGroup, thrall)
        set s = s + 1
    endloop

    // Spawn Enslaved Creep Thralls
    set cIdx = 0
    loop
        exitwhen cIdx >= udg_Wild_CreepThrallCount[pId]
        set tType = udg_Wild_CreepThrallType[pId * 12 + cIdx]
        if tType != 0 then
            set c = Wild_SpawnArmyCreep(p, tType, cx + GetRandomReal(-180.0, 180.0), cy + GetRandomReal(-180.0, 180.0), bonusHP, bonusDmg)
            call SetUnitVertexColor(c, 180, 220, 255, 230)
        endif
        set cIdx = cIdx + 1
    endloop

    set c = null
    set thrall = null
    set it = null
    set p = null
endfunction

function Wild_ArmyPushLoop takes nothing returns nothing
    local unit enumU = null
    local group tempG = CreateGroup()
    local real tx = 0.0
    local real ty = 0.0

    call GroupAddGroup(udg_Wild_ArmyGroup, tempG)
    loop
        set enumU = FirstOfGroup(tempG)
        exitwhen enumU == null
        call GroupRemoveUnit(tempG, enumU)
        if IsUnitType(enumU, UNIT_TYPE_DEAD) or GetUnitTypeId(enumU) == 0 then
            call GroupRemoveUnit(udg_Wild_ArmyGroup, enumU)
        else
            if GetUnitCurrentOrder(enumU) == 0 then
                set tx = Wild_GetTargetBaseX(GetOwningPlayer(enumU))
                set ty = Wild_GetTargetBaseY(GetOwningPlayer(enumU))
                call IssuePointOrder(enumU, "attack", tx, ty)
            endif
        endif
    endloop
    call DestroyGroup(tempG)
    set tempG = null
endfunction



function AI_GetPlayerAltar takes player p returns unit
    local group g = CreateGroup()
    local unit u = null
    local unit altar = null
    local integer uId = 0
    call GroupEnumUnitsOfPlayer(g, p, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        set uId = GetUnitTypeId(u)
        if (uId == 'halt' or uId == 'oalt' or uId == 'uaod' or uId == 'eate') and not IsUnitType(u, UNIT_TYPE_DEAD) and GetWidgetLife(u) > 0.405 then
            set altar = u
            call GroupClear(g)
        endif
    endloop
    call DestroyGroup(g)
    set g = null
    set u = null
    return altar
endfunction

function AI_GetPlayerTownHall takes player p returns unit
    local group g = CreateGroup()
    local unit u = null
    local unit th = null
    local integer uId = 0
    call GroupEnumUnitsOfPlayer(g, p, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        set uId = GetUnitTypeId(u)
        if (uId == 'htow' or uId == 'hkee' or uId == 'hcas' or uId == 'ogre' or uId == 'ostr' or uId == 'ofrt' or uId == 'unpl' or uId == 'unp1' or uId == 'unp2' or uId == 'etol' or uId == 'etoa' or uId == 'etot') and not IsUnitType(u, UNIT_TYPE_DEAD) and GetWidgetLife(u) > 0.405 then
            set th = u
            call GroupClear(g)
        endif
    endloop
    call DestroyGroup(g)
    set g = null
    set u = null
    return th
endfunction

function AI_ForceLearnSkill takes unit h, integer abilId, integer maxLv, boolean isUlt returns boolean
    local integer pts = GetHeroSkillPoints(h)
    local integer hLv = GetHeroLevel(h)
    local integer curLv = GetUnitAbilityLevel(h, abilId)
    local integer reqLv = 1
    local integer pId = 0
    local group g = null
    local unit u = null

    if GetPlayerController(GetOwningPlayer(h)) != MAP_CONTROL_COMPUTER then
        return false
    endif

    if pts <= 0 then
        return false
    endif
    if curLv >= maxLv then
        return false
    endif

    if isUlt then
        set reqLv = 6
    elseif abilId == 'Aamk' then
        set reqLv = 1
    else
        set reqLv = curLv * 2 + 1
    endif

    if hLv < reqLv then
        return false
    endif

    call SelectHeroSkill(h, abilId)

    if GetUnitAbilityLevel(h, abilId) == curLv then
        if curLv == 0 then
            call UnitAddAbility(h, abilId)
        else
            call SetUnitAbilityLevel(h, abilId, curLv + 1)
        endif
        call UnitModifySkillPoints(h, -1)
    endif

    if GetUnitAbilityLevel(h, abilId) <= curLv then
        return false
    endif

    set pId = GetPlayerId(GetOwningPlayer(h))
    if abilId == 'A012' then
        if not udg_Ninja_AuraOn[pId] then
            set udg_Ninja_AuraOn[pId] = true
            if udg_Ninja_AuraFx[pId] == null then
                set udg_Ninja_AuraFx[pId] = AddSpecialEffectTarget("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl", h, "origin")
            endif
        endif
    elseif abilId == 'A011' then
        if udg_Ninja_CloneGroup[pId] != null then
            set g = CreateGroup()
            call GroupAddGroup(udg_Ninja_CloneGroup[pId], g)
            loop
                set u = FirstOfGroup(g)
                exitwhen u == null
                call GroupRemoveUnit(g, u)
                if GetUnitTypeId(u) == 'u002' and not IsUnitType(u, UNIT_TYPE_DEAD) then
                    if GetUnitAbilityLevel(u, 'A015') == 0 then
                        call UnitAddAbility(u, 'A015')
                    endif
                    call SetUnitAbilityLevel(u, 'A015', GetUnitAbilityLevel(h, 'A011'))
                endif
            endloop
            call DestroyGroup(g)
            set g = null
        endif
    endif

    return true
endfunction

function AI_LearnSkillForNinja takes unit h returns boolean
    local integer hLv = GetHeroLevel(h)
    local integer qLv = GetUnitAbilityLevel(h, 'A011')
    local integer eLv = GetUnitAbilityLevel(h, 'A013')
    local integer wLv = GetUnitAbilityLevel(h, 'A012')
    local integer rLv = GetUnitAbilityLevel(h, 'A014')

    // 1. Ultimate at Lv 6+
    if hLv >= 6 and rLv == 0 then
        return AI_ForceLearnSkill(h, 'A014', 1, true)
    endif

    // 2. Primary skill Q (A011) at Lv 1, 3, 5
    if qLv < 3 and hLv >= (qLv * 2 + 1) then
        if not (hLv == 2 and eLv == 0) and not (hLv == 4 and wLv == 0) then
            return AI_ForceLearnSkill(h, 'A011', 3, false)
        endif
    endif

    // 3. Learn unlearned basic skills (E at Lv 2, W at Lv 4)
    if eLv == 0 then
        return AI_ForceLearnSkill(h, 'A013', 3, false)
    endif
    if wLv == 0 then
        return AI_ForceLearnSkill(h, 'A012', 3, false)
    endif

    // 4. Max Q if still available
    if qLv < 3 and hLv >= (qLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A011', 3, false)
    endif

    // 5. Upgrade E
    if eLv < 3 and hLv >= (eLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A013', 3, false)
    endif

    // 6. Upgrade W
    if wLv < 3 and hLv >= (wLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A012', 3, false)
    endif

    // 7. Stat bonus
    return AI_ForceLearnSkill(h, 'Aamk', 10, false)
endfunction

function AI_LearnSkillForDreamMaster takes unit h returns boolean
    local integer hLv = GetHeroLevel(h)
    local integer qLv = GetUnitAbilityLevel(h, 'A001')
