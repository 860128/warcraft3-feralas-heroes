        return AI_ForceLearnSkill(h, 'A004', 1, true)
    endif

    // 2. Primary skill E (A003) at Lv 1, 3, 5
    if eLv < 3 and hLv >= (eLv * 2 + 1) then
        if not (hLv == 2 and qLv == 0) and not (hLv == 4 and wLv == 0) then
            return AI_ForceLearnSkill(h, 'A003', 3, false)
        endif
    endif

    // 3. Learn unlearned basic skills (Q at Lv 2, W at Lv 4)
    if qLv == 0 then
        return AI_ForceLearnSkill(h, 'A001', 3, false)
    endif
    if wLv == 0 then
        return AI_ForceLearnSkill(h, 'A002', 3, false)
    endif

    // 4. Max E if still available
    if eLv < 3 and hLv >= (eLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A003', 3, false)
    endif

    // 5. Upgrade Q
    if qLv < 3 and hLv >= (qLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A001', 3, false)
    endif

    // 6. Upgrade W
    if wLv < 3 and hLv >= (wLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A002', 3, false)
    endif

    // 7. Stat bonus
    return AI_ForceLearnSkill(h, 'Aamk', 10, false)
endfunction

function AI_LearnSkillForStrain takes unit h returns boolean
    local integer hLv = GetHeroLevel(h)
    local integer qLv = GetUnitAbilityLevel(h, 'A021')
    local integer wLv = GetUnitAbilityLevel(h, 'A022')
    local integer eLv = GetUnitAbilityLevel(h, 'A023')
    local integer rLv = GetUnitAbilityLevel(h, 'A024')

    if rLv == 0 then
        call UnitAddAbility(h, 'A024')
    endif

    // 1. Primary skill Q (A021) at Lv 1, 3, 5
    if qLv < 3 and hLv >= (qLv * 2 + 1) then
        if not (hLv == 2 and wLv == 0) and not (hLv == 4 and eLv == 0) then
            return AI_ForceLearnSkill(h, 'A021', 3, false)
        endif
    endif

    // 2. Learn unlearned basic skills (W at Lv 2, E at Lv 4)
    if wLv == 0 then
        return AI_ForceLearnSkill(h, 'A022', 3, false)
    endif
    if eLv == 0 then
        return AI_ForceLearnSkill(h, 'A023', 3, false)
    endif

    // 3. Max Q
    if qLv < 3 and hLv >= (qLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A021', 3, false)
    endif

    // 4. Max W
    if wLv < 3 and hLv >= (wLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A022', 3, false)
    endif

    // 5. Max E
    if eLv < 3 and hLv >= (eLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A023', 3, false)
    endif

    // 6. Stat bonus
    return AI_ForceLearnSkill(h, 'Aamk', 10, false)
endfunction

function AI_LearnSkillForWild takes unit h returns boolean
    local integer hLv = GetHeroLevel(h)
    local integer qLv = GetUnitAbilityLevel(h, 'A031')
    local integer wLv = GetUnitAbilityLevel(h, 'A032')
    local integer eLv = GetUnitAbilityLevel(h, 'A033')
    local integer dLv = GetUnitAbilityLevel(h, 'A035')

    if GetUnitAbilityLevel(h, 'A034') == 0 then
        call UnitAddAbility(h, 'A034')
    endif

    // 1. Ultimate D (A035 众野之怒) at Lv 6/8/10
    if hLv >= 10 and dLv < 3 then
        return AI_ForceLearnSkill(h, 'A035', 3, false)
    endif
    if hLv >= 8 and dLv < 2 then
        return AI_ForceLearnSkill(h, 'A035', 3, false)
    endif
    if hLv >= 6 and dLv < 1 then
        return AI_ForceLearnSkill(h, 'A035', 3, false)
    endif

    // 2. Learn unlearned basic skills
    if qLv == 0 then
        return AI_ForceLearnSkill(h, 'A031', 3, false)
    endif
    if wLv == 0 then
        return AI_ForceLearnSkill(h, 'A032', 3, false)
    endif
    if eLv == 0 then
        return AI_ForceLearnSkill(h, 'A033', 3, false)
    endif

    // 3. Max Q
    if qLv < 3 and hLv >= (qLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A031', 3, false)
    endif

    // 4. Max W
    if wLv < 3 and hLv >= (wLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A032', 3, false)
    endif

    // 5. Max E
    if eLv < 3 and hLv >= (eLv * 2 + 1) then
        return AI_ForceLearnSkill(h, 'A033', 3, false)
    endif

    // 6. Stat bonus
    return AI_ForceLearnSkill(h, 'Aamk', 10, false)
endfunction

function AI_AutoLearnSkills takes unit h returns nothing
    local integer uId = 0
    local boolean learned = false

    if h == null or IsUnitType(h, UNIT_TYPE_DEAD) or GetPlayerController(GetOwningPlayer(h)) != MAP_CONTROL_COMPUTER then
        return
    endif
    set uId = GetUnitTypeId(h)
    if GetHeroSkillPoints(h) <= 0 then
        return
    endif

    loop
        exitwhen GetHeroSkillPoints(h) <= 0
        set learned = false
        if uId == 'H002' then
            set learned = AI_LearnSkillForDreamMaster(h)
        elseif uId == 'H003' then
            set learned = AI_LearnSkillForNinja(h)
        elseif uId == 'H004' then
            set learned = AI_LearnSkillForStrain(h)
        elseif uId == 'H005' then
            set learned = AI_LearnSkillForWild(h)
        endif
        if not learned then
            exitwhen true
        endif
    endloop
endfunction

function AI_SpawnCustomHeroForPlayer takes integer pId, real x, real y, real facing returns unit
    local integer hTypeId = 'H002'
    local unit h = null
    if udg_AI_HeroMode[pId] == 2 then
        set hTypeId = 'H003'
    elseif udg_AI_HeroMode[pId] == 3 then
        set hTypeId = 'H004'
    elseif udg_AI_HeroMode[pId] == 4 then
        set hTypeId = 'H005'
    endif
    set h = CreateUnit(Player(pId), hTypeId, x, y, facing)
    call RemoveGuardPosition(h)
    set udg_AI_CustomHero[pId] = h
    set udg_AI_HeroSpawned[pId] = true
    set udg_AI_DeadTimer[pId] = 0.0
    set udg_AI_AltarTimer[pId] = 0.0
    set udg_AI_WaitTimer[pId] = 0.0
    set udg_AI_CastCD_Q[pId] = 0.0
    set udg_AI_CastCD_W[pId] = 0.0
    set udg_AI_CastCD_E[pId] = 0.0
    set udg_AI_CastCD_R[pId] = 0.0

    call UnitAddItemById(h, 'stwp')

    if hTypeId == 'H003' then
        set udg_Ninja_TrueHero[pId] = h
    elseif hTypeId == 'H004' then
        set udg_Strain_Hero[pId] = h
        call Strain_InitHero(h)
    elseif hTypeId == 'H005' then
        set udg_Wild_Hero[pId] = h
        call Wild_InitHero(h)
    endif

    call AI_AutoLearnSkills(h)

    call SetPlayerTechMaxAllowed(Player(pId), 'H002', 1)
    call SetPlayerTechMaxAllowed(Player(pId), 'H003', 1)
    call SetPlayerTechMaxAllowed(Player(pId), 'H004', 1)
    call SetPlayerTechMaxAllowed(Player(pId), 'H005', 1)

    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", h, "origin"))

    return h
endfunction

//***************************************************************************
//*
//*  Human Player Invulnerable Refuge System (测试酒馆·无敌避难所)
//*
//***************************************************************************

function Refuge_IsInvulnerable takes unit u returns boolean
    if u == null then
        return false
    endif
    return GetUnitAbilityLevel(u, 'Avul') > 0 or BlzIsUnitInvulnerable(u) or GetUnitTypeId(u) == 'n003'
endfunction

function Refuge_InitForPlayer takes player p returns nothing
    local integer pId = GetPlayerId(p)
    local real startX = GetStartLocationX(GetPlayerStartLocation(p))
    local real startY = GetStartLocationY(GetPlayerStartLocation(p))
    local real minX = GetRectMinX(bj_mapInitialPlayableArea) + 600.0
    local real maxX = GetRectMaxX(bj_mapInitialPlayableArea) - 600.0
    local real minY = GetRectMinY(bj_mapInitialPlayableArea) + 600.0
    local real maxY = GetRectMaxY(bj_mapInitialPlayableArea) - 600.0
    local real bestX = minX
    local real bestY = minY
    local real minD = 9999999999.0
    local real dx = 0.0
    local real dy = 0.0
    local real d = 0.0
    local real searchR = 0.0
    local real searchAngle = 0.0
    local real testX = minX
    local real testY = minY
    local boolean found = false
    local unit u = null

    // Check corner 0 (Bottom-Left)
    set dx = startX - minX
    set dy = startY - minY
    set d = dx * dx + dy * dy
    if d < minD then
        set minD = d
        set bestX = minX
        set bestY = minY
    endif

    // Check corner 1 (Top-Left)
    set dx = startX - minX
    set dy = startY - maxY
    set d = dx * dx + dy * dy
    if d < minD then
        set minD = d
        set bestX = minX
        set bestY = maxY
    endif

    // Check corner 2 (Bottom-Right)
    set dx = startX - maxX
    set dy = startY - minY
    set d = dx * dx + dy * dy
    if d < minD then
        set minD = d
        set bestX = maxX
        set bestY = minY
    endif

    // Check corner 3 (Top-Right)
    set dx = startX - maxX
    set dy = startY - maxY
    set d = dx * dx + dy * dy
    if d < minD then
        set minD = d
        set bestX = maxX
        set bestY = maxY
    endif

    // Spiral search around closest corner for buildable & walkable point
    set testX = bestX
    set testY = bestY
    set searchR = 0.0
    set searchAngle = 0.0
    loop
        exitwhen searchR > 1500.0 or found
        set testX = bestX + searchR * Cos(searchAngle)
        set testY = bestY + searchR * Sin(searchAngle)
        if testX >= minX - 300.0 and testX <= maxX + 300.0 and testY >= minY - 300.0 and testY <= maxY + 300.0 then
            if not IsTerrainPathable(testX, testY, PATHING_TYPE_BUILDABILITY) and not IsTerrainPathable(testX, testY, PATHING_TYPE_WALKABILITY) then
                set found = true
            endif
        endif
        if not found then
            set searchAngle = searchAngle + 0.5
            set searchR = searchR + 5.093
        endif
    endloop

    if not found then
        set testX = startX + 800.0
        set testY = startY + 800.0
    endif

    set u = CreateUnit(p, 'n003', testX, testY, 270.0)
    call SetUnitInvulnerable(u, true)
    set udg_RefugeBuilding[pId] = u

    if GetLocalPlayer() == p then
        call PingMinimapEx(testX, testY, 8.0, 0, 255, 0, true)
    endif
    call DisplayTimedTextToPlayer(p, 0, 0, 10.0, "|cff00ff00[测试避难所]|r 已在地图角落生成无敌避难所：主基地被摧毁也不会判负，阵亡英雄可在此复活。输入 |-refuge|r 可迁至英雄身旁。")

    set u = null
    set p = null
endfunction

function Refuge_OnStartTimer takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local integer i = 0
    call PauseTimer(t)
    call DestroyTimer(t)
    set t = null

    set i = 0
    loop
        exitwhen i > 7
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_USER then
            call Refuge_InitForPlayer(Player(i))
        endif
        set i = i + 1
    endloop
endfunction

function Refuge_OnHeroDeath takes unit h returns nothing
    local player p = GetOwningPlayer(h)
    local integer pId = GetPlayerId(p)
    local integer i = 0
    local boolean alreadyInList = false

    if GetPlayerController(p) == MAP_CONTROL_USER and udg_RefugeBuilding[pId] != null then
        // Check if hero already in death list
        set i = 0
        loop
            exitwhen i >= udg_RefugeDeadCount
            if udg_RefugeDeadUnit[i] == h then
                set alreadyInList = true
            endif
            set i = i + 1
        endloop

        if not alreadyInList then
            set udg_RefugeDeadUnit[udg_RefugeDeadCount] = h
            set udg_RefugeDeadTime[udg_RefugeDeadCount] = 0.0
            set udg_RefugeDeadCount = udg_RefugeDeadCount + 1
            call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[避难所]|r 英雄阵亡，避难所将在15秒后免费自动复活英雄（也可在避难所立即购买复活）。")
        endif
    endif

    set p = null
endfunction

function Refuge_Relocate takes player p returns nothing
    local integer pId = GetPlayerId(p)
    local unit heroU = null
    local group g = null
    local unit u = null
    local real tx = 0.0
    local real ty = 0.0
    local real searchR = 250.0
    local real searchAngle = 0.0
    local real px = 0.0
    local real py = 0.0
    local boolean found = false
    local unit ref = null

    // 1. Locate living hero
    if udg_Strain_Hero[pId] != null and not IsUnitType(udg_Strain_Hero[pId], UNIT_TYPE_DEAD) and GetWidgetLife(udg_Strain_Hero[pId]) > 0.405 then
        set heroU = udg_Strain_Hero[pId]
    elseif udg_Ninja_TrueHero[pId] != null and not IsUnitType(udg_Ninja_TrueHero[pId], UNIT_TYPE_DEAD) and GetWidgetLife(udg_Ninja_TrueHero[pId]) > 0.405 then
        set heroU = udg_Ninja_TrueHero[pId]
    elseif udg_AI_CustomHero[pId] != null and not IsUnitType(udg_AI_CustomHero[pId], UNIT_TYPE_DEAD) and GetWidgetLife(udg_AI_CustomHero[pId]) > 0.405 then
        set heroU = udg_AI_CustomHero[pId]
    else
        set g = CreateGroup()
        call GroupEnumUnitsOfPlayer(g, p, null)
        loop
            set u = FirstOfGroup(g)
            exitwhen u == null or heroU != null
            call GroupRemoveUnit(g, u)
            if IsUnitType(u, UNIT_TYPE_HERO) and not IsUnitType(u, UNIT_TYPE_DEAD) and GetWidgetLife(u) > 0.405 and not IsUnitIllusion(u) and not IsUnitInGroup(u, udg_FakeHeroGroup) then
                set heroU = u
            endif
        endloop
        call DestroyGroup(g)
        set g = null
        set u = null
    endif

    if heroU != null then
        set tx = GetUnitX(heroU)
        set ty = GetUnitY(heroU)
    else
        set tx = GetStartLocationX(GetPlayerStartLocation(p))
        set ty = GetStartLocationY(GetPlayerStartLocation(p))
    endif

    // 2. Spiral search nearby buildable & walkable point
    set px = tx
    set py = ty
    loop
        exitwhen searchR > 800.0 or found
        set px = tx + searchR * Cos(searchAngle)
        set py = ty + searchR * Sin(searchAngle)
        if not IsTerrainPathable(px, py, PATHING_TYPE_BUILDABILITY) and not IsTerrainPathable(px, py, PATHING_TYPE_WALKABILITY) then
            set found = true
        else
            set searchAngle = searchAngle + 0.6
            set searchR = searchR + 8.0
        endif
    endloop

    if not found then
        set px = tx + 200.0
        set py = ty + 200.0
    endif

    // 3. Move or Recreate Refuge
    set ref = udg_RefugeBuilding[pId]
    if ref != null and not IsUnitType(ref, UNIT_TYPE_DEAD) and GetWidgetLife(ref) > 0.405 then
        call SetUnitPosition(ref, px, py)
    else
        set ref = CreateUnit(p, 'n003', px, py, 270.0)
        call SetUnitInvulnerable(ref, true)
        set udg_RefugeBuilding[pId] = ref
    endif

    if GetLocalPlayer() == p then
        call PingMinimapEx(px, py, 4.0, 0, 255, 0, false)
    endif
    call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试避难所]|r 避难所已成功迁移至当前位置！")

    set ref = null
    set heroU = null
    set p = null
endfunction

function Refuge_ProcessRevives takes nothing returns nothing
    local integer i = 0
    local unit u = null
    local integer pId = 0
    local unit ref = null

    loop
        exitwhen i >= udg_RefugeDeadCount
        set u = udg_RefugeDeadUnit[i]
        if u == null or not IsUnitType(u, UNIT_TYPE_DEAD) or GetWidgetLife(u) > 0.405 then
            // Already alive or invalid: remove from death queue
            set udg_RefugeDeadCount = udg_RefugeDeadCount - 1
            set udg_RefugeDeadUnit[i] = udg_RefugeDeadUnit[udg_RefugeDeadCount]
            set udg_RefugeDeadTime[i] = udg_RefugeDeadTime[udg_RefugeDeadCount]
            set udg_RefugeDeadUnit[udg_RefugeDeadCount] = null
            set i = i - 1
        else
            set udg_RefugeDeadTime[i] = udg_RefugeDeadTime[i] + 1.0
            if udg_RefugeDeadTime[i] >= 15.0 then
                set pId = GetPlayerId(GetOwningPlayer(u))
                set ref = udg_RefugeBuilding[pId]
                if ref != null and not IsUnitType(ref, UNIT_TYPE_DEAD) and GetWidgetLife(ref) > 0.405 then
                    call ReviveHero(u, GetUnitX(ref), GetUnitY(ref) - 150.0, true)
                    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", GetUnitX(ref), GetUnitY(ref) - 150.0))
                    call DisplayTimedTextToPlayer(Player(pId), 0, 0, 6.0, "|cff00ff00[避难所复活]|r 你的英雄已在无敌避难所免费自动复活！")
                else
                    call ReviveHero(u, GetStartLocationX(GetPlayerStartLocation(Player(pId))), GetStartLocationY(GetPlayerStartLocation(Player(pId))), true)
                    call DisplayTimedTextToPlayer(Player(pId), 0, 0, 6.0, "|cff00ff00[避难所复活]|r 你的英雄已在出生点复活！")
                endif
                set ref = null

                set udg_RefugeDeadCount = udg_RefugeDeadCount - 1
                set udg_RefugeDeadUnit[i] = udg_RefugeDeadUnit[udg_RefugeDeadCount]
                set udg_RefugeDeadTime[i] = udg_RefugeDeadTime[udg_RefugeDeadCount]
                set udg_RefugeDeadUnit[udg_RefugeDeadCount] = null
                set i = i - 1
            endif
        endif
        set u = null
        set i = i + 1
    endloop
endfunction

function AI_HasEnemyInRange takes player p, real x, real y, real radius returns boolean
    local unit enumU = null
    call GroupClear(udg_EnumGroup)
    call GroupEnumUnitsInRange(udg_EnumGroup, x, y, radius, null)
    loop
        set enumU = FirstOfGroup(udg_EnumGroup)
        exitwhen enumU == null
        call GroupRemoveUnit(udg_EnumGroup, enumU)
        if IsUnitEnemy(enumU, p) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and GetWidgetLife(enumU) > 0.405 and GetUnitTypeId(enumU) != 'u000' and not IsUnitInvisible(enumU, p) and not Refuge_IsInvulnerable(enumU) then
            call GroupClear(udg_EnumGroup)
            set enumU = null
            return true
        endif
    endloop
    set enumU = null
    return false
endfunction

function AI_FindStrategicTarget takes integer pId, real hx, real hy returns nothing
    local player p = Player(pId)
    local unit h = udg_AI_CustomHero[pId]
    local integer hLv = 0
    local unit enumU = null
    local unit bestCreep = null
    local real minCreepD = 999999999.0
    local unit bestPlayerEnemy = null
    local real minPlayerD = 999999999.0
    local unit bestAnyEnemy = null
    local real minAnyD = 999999999.0
    local unit targetU = null
    local real dx = 0.0
    local real dy = 0.0
    local real d = 0.0
    local integer ownerId = 0

    set udg_AI_TargetChanged = false

    if h != null and not IsUnitType(h, UNIT_TYPE_DEAD) and GetWidgetLife(h) > 0.405 then
        set hLv = GetHeroLevel(h)
    endif

    // 1. Check if existing locked target is still alive and an enemy
    if udg_AI_LockedTarget[pId] != null then
        if not IsUnitType(udg_AI_LockedTarget[pId], UNIT_TYPE_DEAD) and GetWidgetLife(udg_AI_LockedTarget[pId]) > 0.405 and IsUnitEnemy(udg_AI_LockedTarget[pId], p) and not Refuge_IsInvulnerable(udg_AI_LockedTarget[pId]) then
            set udg_AI_TargetFound = true
            set udg_AI_TargetX = GetUnitX(udg_AI_LockedTarget[pId])
            set udg_AI_TargetY = GetUnitY(udg_AI_LockedTarget[pId])
            set p = null
            set h = null
            return
        else
            set udg_AI_LockedTarget[pId] = null
        endif
    endif

    // 2. Target died or was null: scan map for new target
    call GroupClear(udg_EnumGroup)
    call GroupEnumUnitsInRect(udg_EnumGroup, bj_mapInitialPlayableArea, null)
    loop
        set enumU = FirstOfGroup(udg_EnumGroup)
        exitwhen enumU == null
        call GroupRemoveUnit(udg_EnumGroup, enumU)
        if IsUnitEnemy(enumU, p) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and GetWidgetLife(enumU) > 0.405 and GetUnitTypeId(enumU) != 'u000' and not IsUnitInvisible(enumU, p) and not Refuge_IsInvulnerable(enumU) then
            set dx = GetUnitX(enumU) - hx
            set dy = GetUnitY(enumU) - hy
            set d = dx * dx + dy * dy
            if d < minAnyD then
                set bestAnyEnemy = enumU
                set minAnyD = d
            endif

            set ownerId = GetPlayerId(GetOwningPlayer(enumU))
            if ownerId == PLAYER_NEUTRAL_AGGRESSIVE then
                // Creep candidate within 4500.0 range (4500^2 = 20250000.0)
                if d <= 20250000.0 and d < minCreepD then
                    set bestCreep = enumU
                    set minCreepD = d
                endif
            else
                // Living enemy player unit or building
                if d < minPlayerD then
                    set bestPlayerEnemy = enumU
                    set minPlayerD = d
                endif
            endif
        endif
    endloop

    // 3. Selection Priority:
    // Prioritize enemy player units/structures whenever combat units >= 4 OR hero level >= 2
    if (hLv >= 2 or udg_AI_CombatCount >= 4) and bestPlayerEnemy != null then
        set targetU = bestPlayerEnemy
    elseif bestCreep != null then
        set targetU = bestCreep
    elseif bestPlayerEnemy != null then
        set targetU = bestPlayerEnemy
    elseif bestAnyEnemy != null then
        set targetU = bestAnyEnemy
    endif

    if targetU != null then
        set udg_AI_LockedTarget[pId] = targetU
        set udg_AI_TargetFound = true
        set udg_AI_TargetChanged = true
        set udg_AI_TargetX = GetUnitX(targetU)
        set udg_AI_TargetY = GetUnitY(targetU)
    else
        set udg_AI_LockedTarget[pId] = null
        set udg_AI_TargetFound = false
        set udg_AI_TargetChanged = false
        set udg_AI_TargetX = 0.0
        set udg_AI_TargetY = 0.0
    endif

    set p = null
    set h = null
    set enumU = null
    set bestCreep = null
    set bestPlayerEnemy = null
    set bestAnyEnemy = null
    set targetU = null
endfunction

function AI_CommandArmyForPlayer takes integer pId returns nothing
    local player p = Player(pId)
    local unit h = udg_AI_CustomHero[pId]
    local real hx = 0.0
    local real hy = 0.0
    local unit th = null
    local unit enumU = null
    local integer ord = 0
    local integer uOrd = 0
    local real ux = 0.0
    local real uy = 0.0
    local boolean heroAlive = false
    local boolean canOrderArmy = false

    if h != null and not IsUnitType(h, UNIT_TYPE_DEAD) and GetWidgetLife(h) > 0.405 then
        set heroAlive = true
        set hx = GetUnitX(h)
        set hy = GetUnitY(h)
    else
        set th = AI_GetPlayerTownHall(p)
        if th != null then
            set hx = GetUnitX(th)
            set hy = GetUnitY(th)
            set th = null
        else
            set hx = GetStartLocationX(GetPlayerStartLocation(p))
            set hy = GetStartLocationY(GetPlayerStartLocation(p))
        endif
    endif

    // Count combat units and populate udg_AI_CombatGroup
    call GroupClear(udg_AI_ArmyGroup)
    call GroupClear(udg_AI_CombatGroup)
    call GroupEnumUnitsOfPlayer(udg_AI_ArmyGroup, p, null)
    set udg_AI_CombatCount = 0

    loop
        set enumU = FirstOfGroup(udg_AI_ArmyGroup)
        exitwhen enumU == null
        call GroupRemoveUnit(udg_AI_ArmyGroup, enumU)
        if not IsUnitType(enumU, UNIT_TYPE_DEAD) and GetWidgetLife(enumU) > 0.405 and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and not IsUnitType(enumU, UNIT_TYPE_PEON) and GetUnitTypeId(enumU) != 'u000' then
            if enumU != h then
                set udg_AI_CombatCount = udg_AI_CombatCount + 1
                call GroupAddUnit(udg_AI_CombatGroup, enumU)
            endif
        endif
    endloop

    // Find strategic target (updates udg_AI_LockedTarget and udg_AI_TargetChanged)
    call AI_FindStrategicTarget(pId, hx, hy)

    if udg_AI_TargetFound then
        // Strip all AI guard positions for computer player p
        call RemoveAllGuardPositions(p)

        // 1. Hero Order
        if heroAlive then
            call RemoveGuardPosition(h)
            set ord = GetUnitCurrentOrder(h)
            // Only if h is NOT currently casting our custom spells (852089 blizzard, 852579 charm, 852123 mirrorimage, 852594 summongrizzly)
            if not (ord == 852089 or ord == 852579 or ord == 852123 or ord == 852594) then
                // NOT fleeing at low HP (GetWidgetLife(h) > MaxLife * 0.25 or H003)
                if (GetWidgetLife(h) > GetUnitState(h, UNIT_STATE_MAX_LIFE) * 0.25 or GetUnitTypeId(h) == 'H003') then
                    // Only issue order if not fighting AND (not already attacking OR target changed)
                    if not AI_HasEnemyInRange(p, hx, hy, 650.0) then
                        if ord != 851983 or udg_AI_TargetChanged then
                            call IssuePointOrder(h, "attack", udg_AI_TargetX, udg_AI_TargetY)
                        endif
                    endif
                endif
            endif
        endif

        // 2. Combat Army & Clones Order
        // Whenever the computer has >= 3 combat units (or h is alive and marching)
        set canOrderArmy = (udg_AI_CombatCount >= 3) or heroAlive
        if canOrderArmy then
            loop
                set enumU = FirstOfGroup(udg_AI_CombatGroup)
                exitwhen enumU == null
                call GroupRemoveUnit(udg_AI_CombatGroup, enumU)
                call RemoveGuardPosition(enumU)
                set uOrd = GetUnitCurrentOrder(enumU)
                // Exclude lumber harvesters (e.g. ghouls: 852018 harvest, 852020 returnresources)
                if uOrd != 852018 and uOrd != 852020 then
                    set ux = GetUnitX(enumU)
                    set uy = GetUnitY(enumU)
                    // Only issue order if not in active combat
                    if not AI_HasEnemyInRange(p, ux, uy, 650.0) then
                        if uOrd != 851983 or udg_AI_TargetChanged then
                            call IssuePointOrder(enumU, "attack", udg_AI_TargetX, udg_AI_TargetY)
                        endif
                    endif
                endif
            endloop
        endif
    endif

    call GroupClear(udg_AI_CombatGroup)
    set p = null
    set h = null
    set enumU = null
endfunction

function AI_TacticalLoop takes nothing returns nothing
    local integer i = 0
    local unit h = null
    local integer hTypeId = 0
    local integer heroLv = 0
    local real hx = 0.0
    local real hy = 0.0
    local integer enemyCount = 0
    local unit bestEnemy = null
    local boolean bestIsHero = false
    local real bestLife = 0.0
    local unit clusterEnemy = null
    local unit nearestEnemy = null
    local real minD = 99999999.0
    local real dx = 0.0
    local real dy = 0.0
    local real d = 0.0
    local unit enumU = null
    local group g = null
    local unit altar = null
    local unit th = null
    local integer curOrder = 0
    local boolean doCommand = false
    local integer abil = 0

    set udg_AI_CommandTick = udg_AI_CommandTick + 1
    if udg_AI_CommandTick >= 4 then
        set udg_AI_CommandTick = 0
        set doCommand = true
    endif

    set i = 0
    loop
        exitwhen i > 7
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_USER then
            if udg_Wild_MorphCD[i] > 0.0 then
                set udg_Wild_MorphCD[i] = udg_Wild_MorphCD[i] - 1.0
            endif
        endif
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
            if udg_AI_HeroMode[i] > 0 then
                // Decrement Cooldowns
                if udg_Wild_MorphCD[i] > 0.0 then
                    set udg_Wild_MorphCD[i] = udg_Wild_MorphCD[i] - 1.0
                endif
                if udg_AI_CastCD_Q[i] > 0.0 then
                    set udg_AI_CastCD_Q[i] = udg_AI_CastCD_Q[i] - 1.0
                endif
                if udg_AI_CastCD_W[i] > 0.0 then
                    set udg_AI_CastCD_W[i] = udg_AI_CastCD_W[i] - 1.0
                endif
                if udg_AI_CastCD_E[i] > 0.0 then
                    set udg_AI_CastCD_E[i] = udg_AI_CastCD_E[i] - 1.0
                endif
                if udg_AI_CastCD_R[i] > 0.0 then
                    set udg_AI_CastCD_R[i] = udg_AI_CastCD_R[i] - 1.0
                endif

                // 1. Check if custom hero needs to be spawned / replaced
                if not udg_AI_HeroSpawned[i] then
                    // Case 1: Check if standard hero exists to replace
                    set g = CreateGroup()
                    call GroupEnumUnitsOfPlayer(g, Player(i), null)
                    loop
                        set enumU = FirstOfGroup(g)
                        exitwhen enumU == null
                        call GroupRemoveUnit(g, enumU)
                        if IsUnitType(enumU, UNIT_TYPE_HERO) and GetUnitTypeId(enumU) != 'H002' and GetUnitTypeId(enumU) != 'H003' and GetUnitTypeId(enumU) != 'H004' and GetUnitTypeId(enumU) != 'H005' and not IsUnitIllusion(enumU) and not IsUnitInGroup(enumU, udg_FakeHeroGroup) then
                            set hx = GetUnitX(enumU)
                            set hy = GetUnitY(enumU)
                            set d = GetUnitFacing(enumU)
                            call RemoveUnit(enumU)
                            call AI_SpawnCustomHeroForPlayer(i, hx, hy, d)
                            call GroupClear(g)
                        endif
                    endloop
                    call DestroyGroup(g)
                    set g = null

                    // Case 2: Check altar or townhall timing fallback
                    if not udg_AI_HeroSpawned[i] then
                        set altar = AI_GetPlayerAltar(Player(i))
                        if altar != null then
                            set udg_AI_AltarTimer[i] = udg_AI_AltarTimer[i] + 1.0
                            if udg_AI_AltarTimer[i] >= 20.0 then
                                call AI_SpawnCustomHeroForPlayer(i, GetUnitX(altar), GetUnitY(altar) - 150.0, 270.0)
                            endif
                        else
                            set udg_AI_WaitTimer[i] = udg_AI_WaitTimer[i] + 1.0
                            if udg_AI_WaitTimer[i] >= 60.0 then
                                set th = AI_GetPlayerTownHall(Player(i))
                                if th != null then
                                    call AI_SpawnCustomHeroForPlayer(i, GetUnitX(th) + 150.0, GetUnitY(th), 270.0)
                                else
                                    call AI_SpawnCustomHeroForPlayer(i, GetStartLocationX(GetPlayerStartLocation(Player(i))), GetStartLocationY(GetPlayerStartLocation(Player(i))), 270.0)
                                endif
                                set th = null
                            endif
                        endif
                        set altar = null
                    endif
                endif

                // 2. Check if hero is dead & manage revival
                set h = udg_AI_CustomHero[i]
                if h != null and (IsUnitType(h, UNIT_TYPE_DEAD) or GetWidgetLife(h) <= 0.405) then
                    set udg_AI_DeadTimer[i] = udg_AI_DeadTimer[i] + 1.0
                    set altar = AI_GetPlayerAltar(Player(i))
                    if altar != null then
                        if udg_AI_DeadTimer[i] >= 25.0 then
                            call ReviveHero(h, GetUnitX(altar), GetUnitY(altar) - 150.0, true)
                            set udg_AI_DeadTimer[i] = 0.0
                            call AI_AutoLearnSkills(h)
                        endif
                    else
                        if udg_AI_DeadTimer[i] >= 35.0 then
                            call ReviveHero(h, GetStartLocationX(GetPlayerStartLocation(Player(i))), GetStartLocationY(GetPlayerStartLocation(Player(i))), true)
                            set udg_AI_DeadTimer[i] = 0.0
                            call AI_AutoLearnSkills(h)
                        endif
                    endif
                    set altar = null
                endif

                // 3. Tactical combat decisions when hero is alive
                if h != null and not IsUnitType(h, UNIT_TYPE_DEAD) and GetWidgetLife(h) > 0.405 then
                    set hTypeId = GetUnitTypeId(h)
                    set hx = GetUnitX(h)
                    set hy = GetUnitY(h)
                    set enemyCount = 0
                    set bestEnemy = null
                    set bestIsHero = false
                    set bestLife = 0.0
                    set clusterEnemy = null
                    set nearestEnemy = null
                    set minD = 99999999.0

                    call AI_AutoLearnSkills(h)

                    // Scan for enemies in combat range (800.0)
                    call GroupClear(udg_EnumGroup)
                    call GroupEnumUnitsInRange(udg_EnumGroup, hx, hy, 800.0, null)
                    loop
                        set enumU = FirstOfGroup(udg_EnumGroup)
                        exitwhen enumU == null
                        call GroupRemoveUnit(udg_EnumGroup, enumU)
                        if IsUnitEnemy(enumU, Player(i)) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(enumU) != 'u000' and not IsUnitInGroup(enumU, udg_FakeHeroGroup) and not Refuge_IsInvulnerable(enumU) then
                            set enemyCount = enemyCount + 1
                            set dx = GetUnitX(enumU) - hx
                            set dy = GetUnitY(enumU) - hy
                            set d = SquareRoot(dx * dx + dy * dy)
                            if d < minD then
                                set minD = d
                                set nearestEnemy = enumU
                            endif

                            if clusterEnemy == null and d <= 600.0 then
                                set clusterEnemy = enumU
                            endif

                            if bestEnemy == null then
                                set bestEnemy = enumU
                                set bestIsHero = IsUnitType(enumU, UNIT_TYPE_HERO)
                                set bestLife = GetUnitState(enumU, UNIT_STATE_MAX_LIFE)
                            else
                                if IsUnitType(enumU, UNIT_TYPE_HERO) and not bestIsHero then
                                    set bestEnemy = enumU
                                    set bestIsHero = true
                                    set bestLife = GetUnitState(enumU, UNIT_STATE_MAX_LIFE)
                                elseif (IsUnitType(enumU, UNIT_TYPE_HERO) == bestIsHero) and (GetUnitState(enumU, UNIT_STATE_MAX_LIFE) > bestLife) then
                                    set bestEnemy = enumU
                                    set bestLife = GetUnitState(enumU, UNIT_STATE_MAX_LIFE)
                                endif
                            endif
                        endif
                    endloop

                    if hTypeId == 'H002' then
                        // Dream Master Tactical Brain
                        // Cast E: A003 Mass Illusion
                        if GetUnitAbilityLevel(h, 'A003') > 0 and udg_AI_CastCD_E[i] <= 0.0 and GetUnitState(h, UNIT_STATE_MANA) >= 80.0 and clusterEnemy != null then
                            call IssuePointOrder(h, "cloudoffog", GetUnitX(clusterEnemy), GetUnitY(clusterEnemy))
                            set udg_AI_CastCD_E[i] = 14.0
                        endif

                        // Cast W: A002 Possession
                        if GetUnitAbilityLevel(h, 'A002') > 0 and udg_AI_CastCD_W[i] <= 0.0 and GetUnitState(h, UNIT_STATE_MANA) >= 70.0 and bestEnemy != null then
                            call IssueTargetOrder(h, "charm", bestEnemy)
                            set udg_AI_CastCD_W[i] = 18.0
                        endif

                        // Cast Q: A001 Mirror Image
                        if GetUnitAbilityLevel(h, 'A001') > 0 and udg_AI_CastCD_Q[i] <= 0.0 and GetUnitState(h, UNIT_STATE_MANA) >= 100.0 and (enemyCount >= 1 or GetWidgetLife(h) < GetUnitState(h, UNIT_STATE_MAX_LIFE) * 0.75) then
                            call IssueImmediateOrder(h, "mirrorimage")
                            set udg_AI_CastCD_Q[i] = 16.0
                        endif

                        // Command nearby clones to fight
                        if nearestEnemy != null then
                            call GroupClear(udg_EnumGroup)
                            call GroupEnumUnitsInRange(udg_EnumGroup, hx, hy, 1000.0, null)
                            loop
                                set enumU = FirstOfGroup(udg_EnumGroup)
                                exitwhen enumU == null
                                call GroupRemoveUnit(udg_EnumGroup, enumU)
                                if GetOwningPlayer(enumU) == Player(i) and enumU != h and not IsUnitType(enumU, UNIT_TYPE_DEAD) and GetWidgetLife(enumU) > 0.405 then
                                    if IsUnitType(enumU, UNIT_TYPE_SUMMONED) or IsUnitIllusion(enumU) or IsUnitInGroup(enumU, udg_FakeHeroGroup) then
                                        set curOrder = GetUnitCurrentOrder(enumU)
                                        if curOrder == 0 or curOrder == 851972 or curOrder == 851973 then
                                            call IssuePointOrder(enumU, "attack", GetUnitX(nearestEnemy), GetUnitY(nearestEnemy))
                                        endif
                                    endif
                                endif
                            endloop
                        endif

                    elseif hTypeId == 'H003' then
                        // Ninja Tactical Brain
                        if GetUnitAbilityLevel(h, 'A012') > 0 and not udg_Ninja_AuraOn[i] then
                            set udg_Ninja_AuraOn[i] = true
                            if udg_Ninja_AuraFx[i] == null then
                                set udg_Ninja_AuraFx[i] = AddSpecialEffectTarget("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl", h, "origin")
                            endif
                        endif

                        // Cast R: A014
                        if GetUnitAbilityLevel(h, 'A014') > 0 and udg_AI_CastCD_R[i] <= 0.0 and GetUnitState(h, UNIT_STATE_MANA) >= 120.0 and enemyCount >= 1 then
                            call IssueImmediateOrder(h, "summongrizzly")
                            set udg_AI_CastCD_R[i] = 60.0
                        endif

                        // Command nearby ninja clones to fight
                        if nearestEnemy != null then
                            call GroupClear(udg_EnumGroup)
                            call GroupEnumUnitsInRange(udg_EnumGroup, hx, hy, 1000.0, null)
                            loop
                                set enumU = FirstOfGroup(udg_EnumGroup)
                                exitwhen enumU == null
                                call GroupRemoveUnit(udg_EnumGroup, enumU)
                                if GetOwningPlayer(enumU) == Player(i) and enumU != h and not IsUnitType(enumU, UNIT_TYPE_DEAD) and GetWidgetLife(enumU) > 0.405 then
                                    if GetUnitTypeId(enumU) == 'u002' or GetUnitTypeId(enumU) == 'u001' or IsUnitType(enumU, UNIT_TYPE_SUMMONED) then
                                        set curOrder = GetUnitCurrentOrder(enumU)
                                        if curOrder == 0 or curOrder == 851972 or curOrder == 851973 then
                                            call IssuePointOrder(enumU, "attack", GetUnitX(nearestEnemy), GetUnitY(nearestEnemy))
                                        endif
                                    endif
                                endif
                            endloop
                        endif

                    elseif hTypeId == 'H005' then
                        // Hero #4: The Wild Avatar Tactical AI
                        set heroLv = GetHeroLevel(h)
                        // 1. Cast Ultimate D (A035 众野之怒)
                        if udg_AI_CastCD_R[i] <= 0.0 and GetUnitAbilityLevel(h, 'A035') > 0 and GetUnitState(h, UNIT_STATE_MANA) >= 175.0 and enemyCount >= 2 then
                            call IssueImmediateOrder(h, "starfall")
                            set udg_AI_CastCD_R[i] = 110.0
                        endif

                        // 2. Morph if cooldown ready
                        if udg_Wild_MorphCD[i] <= 0.0 then
                            if enemyCount >= 3 or GetWidgetLife(h) < (GetUnitState(h, UNIT_STATE_MAX_LIFE) * 0.45) then
                                call Wild_DoMorph(h, 3, heroLv, 1)
                            elseif enemyCount >= 1 then
                                call Wild_DoMorph(h, 1, heroLv, 2)
                            else
                                call Wild_DoMorph(h, 2, heroLv, 2)
                            endif
                        endif

                        // 3. Cast signature form abilities in combat
                        if udg_AI_CastCD_W[i] <= 0.0 and enemyCount >= 1 and nearestEnemy != null then
                            set abil = udg_Wild_CurrentAbil[i]
                            if abil == 'ACst' then
                                call IssueImmediateOrder(h, "stomp")
                                set udg_AI_CastCD_W[i] = 8.0
                            elseif abil == 'ACro' then
                                call IssueImmediateOrder(h, "roar")
                                set udg_AI_CastCD_W[i] = 12.0
                            elseif abil == 'ACsh' then
                                call IssuePointOrder(h, "shockwave", GetUnitX(nearestEnemy), GetUnitY(nearestEnemy))
                                set udg_AI_CastCD_W[i] = 8.0
                            elseif abil == 'ACtb' then
                                call IssueTargetOrder(h, "thunderbolt", nearestEnemy)
                                set udg_AI_CastCD_W[i] = 7.0
                            elseif abil == 'ACen' then
                                call IssueTargetOrder(h, "ensnare", nearestEnemy)
                                set udg_AI_CastCD_W[i] = 10.0
                            elseif abil == 'ACsw' then
                                call IssueTargetOrder(h, "slow", nearestEnemy)
                                set udg_AI_CastCD_W[i] = 6.0
                            elseif abil == 'ACpu' then
                                call IssueTargetOrder(h, "purge", nearestEnemy)
                                set udg_AI_CastCD_W[i] = 8.0
                            elseif abil == 'ACls' then
                                call IssueTargetOrder(h, "lightningshield", h)
                                set udg_AI_CastCD_W[i] = 10.0
                            elseif abil == 'ACfn' then
                                call IssueTargetOrder(h, "frostnova", nearestEnemy)
                                set udg_AI_CastCD_W[i] = 8.0
                            elseif abil == 'ACbl' then
                                call IssueTargetOrder(h, "bloodlust", h)
                                set udg_AI_CastCD_W[i] = 8.0
                            elseif abil == 'ACfl' then
                                call IssueTargetOrder(h, "forkedlightning", nearestEnemy)
                                set udg_AI_CastCD_W[i] = 8.0
                            elseif abil == 'AChx' then
                                call IssueTargetOrder(h, "hex", nearestEnemy)
                                set udg_AI_CastCD_W[i] = 10.0
                            elseif abil == 'ACf2' then
                                call IssueTargetOrder(h, "frostarmor", h)
                                set udg_AI_CastCD_W[i] = 8.0
                            endif
                        endif
                    elseif hTypeId == 'H004' then
                        // Hero #3 Primordial Strain Tactical Brain
                        // 1. If burrowed and enemy is close: unburrow to knockup and strike!
                        if udg_Strain_Burrowed[i] then
                            if nearestEnemy != null and minD <= 220.0 then
                                call IssueImmediateOrder(h, "windwalk")
                            endif
                        else
                            // 2. Cast W (A022 捕食吞噬) on low-HP target
                            if udg_AI_CastCD_W[i] <= 0.0 and GetUnitAbilityLevel(h, 'A022') > 0 and udg_Strain_DigestTimer[i] <= 0.0 and GetUnitState(h, UNIT_STATE_MANA) >= 75.0 then
                                call GroupClear(udg_EnumGroup)
                                call GroupEnumUnitsInRange(udg_EnumGroup, hx, hy, 300.0, null)
                                loop
                                    set enumU = FirstOfGroup(udg_EnumGroup)
                                    exitwhen enumU == null
                                    call GroupRemoveUnit(udg_EnumGroup, enumU)
                                    if IsUnitEnemy(enumU, Player(i)) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(enumU) != 'u000' and not IsUnitInGroup(enumU, udg_FakeHeroGroup) and not Refuge_IsInvulnerable(enumU) then
                                        if IsUnitType(enumU, UNIT_TYPE_HERO) or IsHeroUnitId(GetUnitTypeId(enumU)) then
                                            if GetWidgetLife(enumU) <= (GetUnitState(h, UNIT_STATE_MAX_LIFE) * 0.10) or GetWidgetLife(enumU) <= (GetUnitState(enumU, UNIT_STATE_MAX_LIFE) * 0.28) then
                                                set bestEnemy = enumU
                                                exitwhen true
                                            endif
                                        else
                                            if GetWidgetLife(enumU) <= (GetUnitState(h, UNIT_STATE_MAX_LIFE) * 0.10) or GetWidgetLife(enumU) <= (GetUnitState(enumU, UNIT_STATE_MAX_LIFE) * 0.35) then
                                                set bestEnemy = enumU
                                            endif
                                        endif
                                    endif
                                endloop
                                if bestEnemy != null then
                                    call IssueTargetOrder(h, "devour", bestEnemy)
                                    set udg_AI_CastCD_W[i] = 25.0 - 5.0 * I2R(GetUnitAbilityLevel(h, 'A022'))
                                endif
                            endif

                            // 3. Cast Q (A021 渊潜掠影) in combat or when low HP
                            if udg_AI_CastCD_Q[i] <= 0.0 and GetUnitAbilityLevel(h, 'A021') > 0 and GetUnitState(h, UNIT_STATE_MANA) >= 50.0 and (enemyCount >= 1 or GetWidgetLife(h) < (GetUnitState(h, UNIT_STATE_MAX_LIFE) * 0.50)) then
                                call IssueImmediateOrder(h, "windwalk")
                                set udg_AI_CastCD_Q[i] = 12.0
                            endif

                            // 4. Cast E (A023 拟态伪装) when out of combat to prepare ambush
                            if udg_AI_CastCD_E[i] <= 0.0 and GetUnitAbilityLevel(h, 'A023') > 0 and not udg_Strain_MimicActive[i] and udg_Strain_MimicType[i] != 0 and enemyCount == 0 then
                                call IssueImmediateOrder(h, "ambush")
                                set udg_AI_CastCD_E[i] = 20.0
                            endif

                            // 5. Cast Stolen Abilities (Slot 1 or Slot 2)
                            if udg_AI_CastCD_R[i] <= 0.0 and enemyCount >= 1 and nearestEnemy != null then
                                set abil = udg_Strain_StolenAbil1[i]
                                if abil == 0 then
                                    set abil = udg_Strain_StolenAbil2[i]
                                endif
                                if abil != 0 then
                                    if abil == 'AOwk' then
                                        call IssueImmediateOrder(h, "windwalk")
                                    elseif abil == 'AHtb' or abil == 'ACtb' then
                                        call IssueTargetOrder(h, "thunderbolt", nearestEnemy)
                                    elseif abil == 'AHtc' or abil == 'ACst' then
                                        call IssueImmediateOrder(h, "stomp")
                                    elseif abil == 'AOcl' then
                                        call IssueTargetOrder(h, "chainlightning", nearestEnemy)
                                    elseif abil == 'AUdc' then
                                        call IssueTargetOrder(h, "deathcoil", nearestEnemy)
                                    elseif abil == 'AUim' then
                                        call IssuePointOrder(h, "impale", GetUnitX(nearestEnemy), GetUnitY(nearestEnemy))
                                    elseif abil == 'A001' then
                                        call IssueImmediateOrder(h, "mirrorimage")
                                    elseif abil == 'A014' then
                                        call IssueImmediateOrder(h, "summongrizzly")
                                    elseif abil == 'ACbl' then
                                        call IssueTargetOrder(h, "bloodlust", h)
                                    elseif abil == 'ACls' then
                                        call IssueTargetOrder(h, "lightningshield", h)
                                    elseif abil == 'ACpu' then
                                        call IssueTargetOrder(h, "purge", nearestEnemy)
                                    elseif abil == 'ACro' then
                                        call IssueImmediateOrder(h, "roar")
                                    elseif abil == 'ACif' then
                                        call IssueTargetOrder(h, "innerfire", h)
                                    elseif abil == 'ACsw' then
                                        call IssueTargetOrder(h, "slow", nearestEnemy)
                                    elseif abil == 'AChx' then
                                        call IssueTargetOrder(h, "hex", nearestEnemy)
                                    elseif abil == 'ACsh' then
                                        call IssuePointOrder(h, "shockwave", GetUnitX(nearestEnemy), GetUnitY(nearestEnemy))
                                    elseif abil == 'ACfl' then
                                        call IssueTargetOrder(h, "forkedlightning", nearestEnemy)
                                    elseif abil == 'ACfn' then
                                        call IssueTargetOrder(h, "frostnova", nearestEnemy)
                                    elseif abil == 'ACf2' then
                                        call IssueTargetOrder(h, "frostarmor", h)
                                    elseif abil == 'ACen' then
                                        call IssueTargetOrder(h, "ensnare", nearestEnemy)
                                    elseif abil == 'ACrj' then
                                        call IssueTargetOrder(h, "rejuvenation", h)
                                    elseif abil == 'ACcs' then
                                        call IssueTargetOrder(h, "curse", nearestEnemy)
                                    endif
                                    set udg_AI_CastCD_R[i] = 8.0
                                endif
                            endif
                        endif
                    endif

                    set h = null
                    set bestEnemy = null
                    set clusterEnemy = null
                    set nearestEnemy = null
                endif

                // 4. Strategic Army Commander (Every 4.0 seconds)
                if doCommand then
                    call AI_CommandArmyForPlayer(i)
                endif
            endif
        endif
        set i = i + 1
    endloop
endfunction

function DM_CapTimerLoop takes nothing returns nothing
    local integer i = 0
    local unit u = null
    local integer pId = 0
    local unit th = null
    local unit dmgSrc = null
    local integer aLv = 0
    local real pct = 0.0
    local real drain = 0.0
    local real curHP = 0.0
    local unit enumU = null
    local integer kLv = 0
    local player ko = null
    local group auraTargets = null
    local group auraSources = null
    local unit srcU = null

    // 1. Process Dream Master possession duration
    loop
        exitwhen i >= udg_CapCount
        set udg_CapDuration[i] = udg_CapDuration[i] - 1.0
        set u = udg_CapUnit[i]
        if u == null or IsUnitType(u, UNIT_TYPE_DEAD) then
            if u != null and udg_CapOrigOwner[i] != null then
                call SetUnitOwner(u, udg_CapOrigOwner[i], true)
            endif
            call DM_RemoveCapIndex(i)
            set i = i - 1
        elseif udg_CapDuration[i] <= 0.0 then
            call SetUnitOwner(u, udg_CapOrigOwner[i], true)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", u, "origin"))
            call DM_RemoveCapIndex(i)
            set i = i - 1
        endif
        set u = null
        set i = i + 1
    endloop

    // 2. Process Ninja Aura (A012) - 900.0 Radius around body and all living clones, deduplicated per cycle
    set pId = 0
    loop
        exitwhen pId > 7
        set th = udg_Ninja_TrueHero[pId]
        if th != null and udg_Ninja_AuraOn[pId] then
            set aLv = GetUnitAbilityLevel(th, 'A012')
            if aLv > 0 then
                set pct = 0.01 * I2R(aLv)
                set auraTargets = CreateGroup()
                set auraSources = CreateGroup()

                // Add true hero if alive
                if not IsUnitType(th, UNIT_TYPE_DEAD) and GetWidgetLife(th) > 0.405 then
                    call GroupAddUnit(auraSources, th)
                endif

                // Add all living clones (u002, u001) from CloneGroup
                if udg_Ninja_CloneGroup[pId] != null then
                    call GroupClear(udg_EnumGroup)
                    call GroupAddGroup(udg_Ninja_CloneGroup[pId], udg_EnumGroup)
                    loop
                        set srcU = FirstOfGroup(udg_EnumGroup)
                        exitwhen srcU == null
                        call GroupRemoveUnit(udg_EnumGroup, srcU)
                        if not IsUnitType(srcU, UNIT_TYPE_DEAD) and GetWidgetLife(srcU) > 0.405 then
                            call GroupAddUnit(auraSources, srcU)
                        endif
                    endloop
                endif

                // Collect 900.0 range enemies around every living aura source (GroupAddUnit automatically deduplicates)
                loop
                    set srcU = FirstOfGroup(auraSources)
                    exitwhen srcU == null
                    call GroupRemoveUnit(auraSources, srcU)
                    call GroupClear(udg_EnumGroup)
                    call GroupEnumUnitsInRange(udg_EnumGroup, GetUnitX(srcU), GetUnitY(srcU), 900.0, null)
                    loop
                        set enumU = FirstOfGroup(udg_EnumGroup)
                        exitwhen enumU == null
                        call GroupRemoveUnit(udg_EnumGroup, enumU)
                        if IsUnitEnemy(enumU, Player(pId)) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(enumU) != 'u000' then
                            call GroupAddUnit(auraTargets, enumU)
                        endif
                    endloop
                endloop

                // Apply aura drain once per target in auraTargets
                loop
                    set enumU = FirstOfGroup(auraTargets)
                    exitwhen enumU == null
                    call GroupRemoveUnit(auraTargets, enumU)
                    set drain = GetUnitState(enumU, UNIT_STATE_MAX_LIFE) * pct
                    set curHP = GetWidgetLife(enumU)
                    if curHP > 1.5 then
                        if curHP - drain > 1.0 then
                            call SetWidgetLife(enumU, curHP - drain)
                        else
                            call SetWidgetLife(enumU, 1.0)
                        endif
                    endif
                endloop

                call DestroyGroup(auraTargets)
                call DestroyGroup(auraSources)
                set auraTargets = null
                set auraSources = null
            endif
        endif
        set pId = pId + 1
    endloop

    // 3. Process Karma Curse Drain (A013 Lv2 & Lv3)
    set i = 0
    loop
        exitwhen i >= udg_KarmaCount
        set u = udg_KarmaUnit[i]
        if u == null or IsUnitType(u, UNIT_TYPE_DEAD) or GetWidgetLife(u) <= 0.405 then
            call Ninja_RemoveKarmaIndex(i)
            set i = i - 1
        else
            set kLv = udg_KarmaLevel[i]
            if kLv >= 2 then
                if kLv == 2 then
                    set pct = 0.01
                else
                    set pct = 0.02
                endif
                set drain = GetUnitState(u, UNIT_STATE_MAX_LIFE) * pct
                set curHP = GetWidgetLife(u)
                if curHP > 1.5 then
                    if curHP - drain > 1.0 then
                        call SetWidgetLife(u, curHP - drain)
                    else
                        call SetWidgetLife(u, 1.0)
                    endif
                endif
            endif
        endif
        set u = null
        set i = i + 1
    endloop

    // 3.5. Process Hero #3 Digestion Timer Countdown
    set pId = 0
    loop
        exitwhen pId > 7
        if udg_Strain_DigestTimer[pId] > 0.0 then
            set udg_Strain_DigestTimer[pId] = udg_Strain_DigestTimer[pId] - 1.0
            if udg_Strain_DigestTimer[pId] <= 0.0 then
                if udg_Strain_DigestFx[pId] != null then
                    call DestroyEffect(udg_Strain_DigestFx[pId])
                    set udg_Strain_DigestFx[pId] = null
                endif
                set u = udg_Strain_Hero[pId]
                if u == null then
                    set u = udg_AI_CustomHero[pId]
                endif
                if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) then
                    call SetWidgetLife(u, GetWidgetLife(u) + GetUnitState(u, UNIT_STATE_MAX_LIFE) * 0.25)
                    call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MANA) + GetUnitState(u, UNIT_STATE_MAX_MANA) * 0.25)
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIhe\\AIheTarget.mdl", u, "origin"))
                    set udg_Strain_MimicType[pId] = udg_Strain_DigestType[pId]
                    set udg_Strain_MimicOwner[pId] = udg_Strain_DigestOwner[pId]
                    call Strain_OnDigestComplete(u, pId)
                endif
                set u = null
            endif
        endif
        set pId = pId + 1
    endloop

    // 3.6. Enforce Crippled Heroes Max HP and Mana clamp
    set i = 0
    loop
        exitwhen i >= udg_Strain_CrippledCount
        set u = udg_Strain_CrippledHero[i]
        if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) then
            if BlzGetUnitMaxHP(u) > udg_Strain_CrippledHP[i] then
                call BlzSetUnitMaxHP(u, udg_Strain_CrippledHP[i])
                if GetWidgetLife(u) > I2R(udg_Strain_CrippledHP[i]) then
                    call SetWidgetLife(u, I2R(udg_Strain_CrippledHP[i]))
                endif
            endif
            if BlzGetUnitMaxMana(u) > udg_Strain_CrippledMana[i] then
                call BlzSetUnitMaxMana(u, udg_Strain_CrippledMana[i])
                if GetUnitState(u, UNIT_STATE_MANA) > I2R(udg_Strain_CrippledMana[i]) then
                    call SetUnitState(u, UNIT_STATE_MANA, I2R(udg_Strain_CrippledMana[i]))
                endif
            endif
        endif
        set u = null
        set i = i + 1
    endloop

    // 3.8. Process Human Player Refuge Dead Hero Auto-Revival
    call Refuge_ProcessRevives()

    // 3.9. Process Wild Wrath Duration Countdown
    set pId = 0
    loop
        exitwhen pId > 15
        if udg_Wild_WrathTimer[pId] > 0.0 then
            set udg_Wild_WrathTimer[pId] = udg_Wild_WrathTimer[pId] - 1.0
        endif
        set pId = pId + 1
    endloop

    // 4. Custom Hero AI Tactical Loop
    call AI_TacticalLoop()
endfunction

function DM_CloneOneUnit takes unit caster, unit orig, real tx, real ty returns nothing
    local player p = GetOwningPlayer(caster)
    local integer uId = GetUnitTypeId(orig)
    local unit clone = null
    local unit dummy = null
    local boolean hasAgh = GetUnitAbilityLevel(caster, 'A004') > 0
    local boolean success = false
    local integer itemSlot = 0
    local item itm = null

    if IsUnitType(orig, UNIT_TYPE_HERO) or IsHeroUnitId(uId) then
        // Hero target (Real Hero OR Fake Hero/Hero Illusion):
        // First try to create an engine-native Hero Illusion via Wand of Illusion (852274)
        set dummy = CreateUnit(p, 'u000', GetUnitX(orig), GetUnitY(orig), 0.0)
        if hasAgh then
            call UnitAddAbility(dummy, 'A00J')
        else
            call UnitAddAbility(dummy, 'A00I')
        endif
        set success = IssueTargetOrderById(dummy, 852274, orig)
        call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
        set dummy = null

        if not success then
            // If the native Wand of Illusion rejected targeting an existing illusion,
            // create clone with full active skills, matching level & items,
            // but completely stripped of hero properties (no altar revival, no XP gain, no hero icon):
            set clone = CreateUnit(p, uId, tx, ty, GetUnitFacing(orig))
            call RemoveGuardPosition(clone)
            call UnitRemoveType(clone, UNIT_TYPE_HERO)
            call UnitAddType(clone, UNIT_TYPE_SUMMONED)
            call SuspendHeroXP(clone, true)
            call SetHeroLevel(clone, GetHeroLevel(orig), false)
            set itemSlot = 0
            loop
                exitwhen itemSlot >= 6
                set itm = UnitItemInSlot(orig, itemSlot)
                if itm != null then
                    call UnitAddItemById(clone, GetItemTypeId(itm))
                endif
                set itemSlot = itemSlot + 1
            endloop
            set itm = null
            call GroupAddUnit(udg_FakeHeroGroup, clone)
            call UnitApplyTimedLife(clone, 'BTLF', 900.0)
            call SetUnitVertexColor(clone, 100, 150, 255, 180)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl", clone, "origin"))
            if GetPlayerController(p) == MAP_CONTROL_COMPUTER then
                call IssuePointOrder(clone, "attack", GetUnitX(orig), GetUnitY(orig))
            endif
            set clone = null
        else
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl", orig, "origin"))
        endif
    else
        // Non-hero target (includes Peasants, Peons, Wisps, Acolytes, Creeps, Spellcasters):
        // Clone with full active skills, 15-minute duration, blue illusion tint
        set clone = CreateUnit(p, uId, tx, ty, GetUnitFacing(orig))
        call RemoveGuardPosition(clone)
        call UnitAddType(clone, UNIT_TYPE_SUMMONED)
        call UnitApplyTimedLife(clone, 'BTLF', 900.0)
        call SetUnitVertexColor(clone, 100, 150, 255, 180)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl", clone, "origin"))
        if GetPlayerController(p) == MAP_CONTROL_COMPUTER then
            call IssuePointOrder(clone, "attack", GetUnitX(orig), GetUnitY(orig))
        endif
        set clone = null
    endif

    set p = null
endfunction

function DM_CastMassIllusion takes unit caster, real targetX, real targetY returns nothing
    local integer lv = GetUnitAbilityLevel(caster, 'A003')
    local boolean hasAgh = GetUnitAbilityLevel(caster, 'A004') > 0
    local real radius = 250.0
    local unit enumU = null
    local real ox = 0.0
    local real oy = 0.0
    local real spawnX = 0.0
    local real spawnY = 0.0

    if lv == 2 then
        set radius = 350.0
    elseif lv >= 3 then
        set radius = 450.0
    endif
    if hasAgh then
        set radius = radius + 100.0
    endif

    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", targetX, targetY))

    call GroupClear(udg_EnumGroup)
    call GroupEnumUnitsInRange(udg_EnumGroup, targetX, targetY, radius, null)

    loop
        set enumU = FirstOfGroup(udg_EnumGroup)
        exitwhen enumU == null
        call GroupRemoveUnit(udg_EnumGroup, enumU)

        // Copy ALL living non-structure units (including peasants, wisps, peons, acolytes, creeps, heroes)
        if not IsUnitType(enumU, UNIT_TYPE_DEAD) and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(enumU) != 'u000' then
            set ox = GetUnitX(enumU)
            set oy = GetUnitY(enumU)
            set spawnX = ox + 40.0
            set spawnY = oy + 40.0
            call DM_CloneOneUnit(caster, enumU, spawnX, spawnY)
        endif
    endloop
endfunction

function DM_CastPossession takes unit caster, unit target returns nothing
    local integer lv = GetUnitAbilityLevel(caster, 'A002')
    local player casterPlayer = GetOwningPlayer(caster)
    local player origPlayer = GetOwningPlayer(target)
    local real dur = 30.0
    local integer idx = 0
    local boolean hasAgh = GetUnitAbilityLevel(caster, 'A004') > 0

    if target == null or origPlayer == casterPlayer then
        return
    endif

    if lv == 2 then
        set dur = 120.0
    elseif lv >= 3 then
        if hasAgh then
            set dur = 999999.0
        else
            set dur = 600.0
        endif
    endif

    set idx = DM_FindCapIndex(target)
    if idx >= 0 then
        set udg_CapDuration[idx] = dur
    else
        if udg_CapCount < 128 then
            set udg_CapUnit[udg_CapCount] = target
            set udg_CapOrigOwner[udg_CapCount] = origPlayer
            set udg_CapDuration[udg_CapCount] = dur
            set udg_CapCount = udg_CapCount + 1
        endif
    endif

    call SetUnitOwner(target, casterPlayer, true)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Possession\\PossessionTarget.mdl", target, "chest"))

    set casterPlayer = null
    set origPlayer = null
endfunction

function DM_OnCastMirror takes unit caster returns nothing
    if udg_DM_StealthCount < 32 then
        set udg_DM_StealthUnit[udg_DM_StealthCount] = caster
        set udg_DM_StealthTimer[udg_DM_StealthCount] = 0.40
        set udg_DM_StealthCount = udg_DM_StealthCount + 1
    endif
endfunction

function DM_OnSpellEffect takes nothing returns boolean
    local unit caster = GetTriggerUnit()
    local integer abil = GetSpellAbilityId()
    local integer pId = 0
    local unit ult = null
    local integer tier = 0
    local player victimP = null

    if abil == 'A001' then
        call DM_OnCastMirror(caster)
    elseif abil == 'A002' then
        call DM_CastPossession(caster, GetSpellTargetUnit())
    elseif abil == 'A003' then
        call DM_CastMassIllusion(caster, GetSpellTargetX(), GetSpellTargetY())
    elseif abil == 'A012' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set udg_Ninja_TrueHero[pId] = Ninja_GetTrueHero(GetOwningPlayer(caster))
        set udg_Ninja_AuraOn[pId] = not udg_Ninja_AuraOn[pId]
        if udg_Ninja_AuraOn[pId] then
            if udg_Ninja_AuraFx[pId] == null then
                set udg_Ninja_AuraFx[pId] = AddSpecialEffectTarget("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl", caster, "origin")
            endif
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl", caster, "origin"))
        else
            if udg_Ninja_AuraFx[pId] != null then
                call DestroyEffect(udg_Ninja_AuraFx[pId])
                set udg_Ninja_AuraFx[pId] = null
            endif
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl", caster, "origin"))
        endif
    elseif abil == 'A014' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        // Cap u001 at most 1 alive per player
        if udg_Ninja_CloneGroup[pId] != null then
            call GroupClear(udg_EnumGroup)
            call GroupAddGroup(udg_Ninja_CloneGroup[pId], udg_EnumGroup)
            loop
                set ult = FirstOfGroup(udg_EnumGroup)
                exitwhen ult == null
                call GroupRemoveUnit(udg_EnumGroup, ult)
                if GetUnitTypeId(ult) == 'u001' and not IsUnitType(ult, UNIT_TYPE_DEAD) then
                    call GroupRemoveUnit(udg_Ninja_CloneGroup[pId], ult)
                    call RemoveUnit(ult)
                endif
            endloop
        endif
        set ult = CreateUnit(GetOwningPlayer(caster), 'u001', GetUnitX(caster) + 70.0, GetUnitY(caster) + 70.0, GetUnitFacing(caster))
        call UnitAddType(ult, UNIT_TYPE_SUMMONED)
        call UnitApplyTimedLife(ult, 'BTLF', 180.0)
        call UnitAddAbility(ult, 'A015')
        call SetUnitAbilityLevel(ult, 'A015', 3)
        if udg_Ninja_CloneGroup[pId] == null then
            set udg_Ninja_CloneGroup[pId] = CreateGroup()
        endif
        call GroupAddUnit(udg_Ninja_CloneGroup[pId], ult)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Vengeance\\VengeanceAvenger.mdl", ult, "origin"))
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", GetUnitX(ult), GetUnitY(ult)))
        set ult = null
    elseif abil == 'A021' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set udg_Strain_Hero[pId] = caster
        if udg_Strain_Burrowed[pId] then
            call Strain_Unburrow(caster, pId)
        else
            if udg_Strain_MimicActive[pId] then
                call Strain_BreakMimicry(caster, pId)
                set udg_Strain_AmbushReady[pId] = false
            endif
            set udg_Strain_Burrowed[pId] = true
            set udg_Strain_BurrowTimer[pId] = 15.0 + 5.0 * I2R(GetUnitAbilityLevel(caster, 'A021'))
            call SetUnitPathing(caster, false)
            call SetUnitMoveSpeed(caster, 522.0)
            call SetUnitVertexColor(caster, 120, 95, 65, 110)
            call UnitAddAbility(caster, 'Abun')
            call UnitAddAbility(caster, 'A027')
            set ult = CreateUnit(GetOwningPlayer(caster), 'u000', GetUnitX(caster), GetUnitY(caster), 0.0)
            call UnitAddAbility(ult, 'A00V')
            call IssueTargetOrderById(ult, 852069, caster)
            call UnitApplyTimedLife(ult, 'BTLF', 1.0)
            set ult = null
            call DestroyEffect(AddSpecialEffectTarget("Objects\\Spawnmodels\\Undead\\ImpaleTargetDust\\ImpaleTargetDust.mdl", caster, "origin"))
        endif
    elseif abil == 'A022' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set ult = GetSpellTargetUnit()
        set udg_Strain_Hero[pId] = caster
        set udg_Strain_DigestSkillLv[pId] = IMaxBJ(1, GetUnitAbilityLevel(caster, 'A022'))
        if ult != null then
            set udg_Strain_DigestType[pId] = GetUnitTypeId(ult)
            set udg_Strain_DigestOwner[pId] = GetOwningPlayer(ult)
            set udg_Strain_DigestIsHero[pId] = IsUnitType(ult, UNIT_TYPE_HERO) or IsHeroUnitId(GetUnitTypeId(ult))
            set udg_Strain_DigestVictimLv[pId] = IMaxBJ(1, GetUnitLevel(ult))
            if not udg_Strain_DigestIsHero[pId] then
                if GetUnitState(ult, UNIT_STATE_MAX_MANA) > 0.5 then
                    set udg_Strain_DigestFeedType[pId] = 3
                elseif IsUnitType(ult, UNIT_TYPE_RANGED_ATTACKER) then
                    set udg_Strain_DigestFeedType[pId] = 2
                else
                    set udg_Strain_DigestFeedType[pId] = 1
                endif
                call Strain_CaptureRealUnitSkills(pId, ult)
            else
                set udg_Strain_DigestFeedType[pId] = 0
                // Execute cascading attribute and HP/Mana drain BEFORE killing target hero!
                call Strain_DrainEnemyHero(caster, ult)
            endif
            set udg_Strain_DigestTimer[pId] = 8.0 - 1.5 * I2R(GetUnitAbilityLevel(caster, 'A022'))
            call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\Devour\\DevourEffectArt.mdl", GetUnitX(ult), GetUnitY(ult)))
            call DestroyEffect(AddSpecialEffect("Objects\\Spawnmodels\\Human\\HumanLargeDeathExplode\\HumanLargeDeathExplode.mdl", GetUnitX(ult), GetUnitY(ult)))
            call SetUnitExploded(ult, true)
            call UnitDamageTarget(caster, ult, 999999.0, true, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_UNIVERSAL, WEAPON_TYPE_WHOKNOWS)
            if udg_Strain_DigestFx[pId] != null then
                call DestroyEffect(udg_Strain_DigestFx[pId])
            endif
            set udg_Strain_DigestFx[pId] = AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\CorrosiveBreath\\ChimaeraAcidTargetArt.mdl", caster, "origin")
            set ult = null
        endif
    elseif abil == 'A023' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set udg_Strain_Hero[pId] = caster
        if udg_Strain_MimicActive[pId] then
            call Strain_BreakMimicry(caster, pId)
            set udg_Strain_AmbushReady[pId] = false
        else
            if udg_Strain_MimicType[pId] == 0 then
                call DisplayTimedTextToPlayer(GetOwningPlayer(caster), 0, 0, 3.0, "|cffffcc00[拟态伪装]|r 尚未消化任何猎物样本，请先使用W【捕食吞噬】！")
            else
                if udg_Strain_Burrowed[pId] then
                    call Strain_Unburrow(caster, pId)
                endif
                set udg_Strain_MimicActive[pId] = true
                set udg_Strain_AmbushReady[pId] = true
                call SetUnitVertexColor(caster, 255, 255, 255, 0)
                call SetUnitPathing(caster, false)
                call UnitAddAbility(caster, 'A027')
                set ult = CreateUnit(GetOwningPlayer(caster), 'u000', GetUnitX(caster), GetUnitY(caster), 0.0)
                call UnitAddAbility(ult, 'A00V')
                call IssueTargetOrderById(ult, 852069, caster)
                call UnitApplyTimedLife(ult, 'BTLF', 1.0)
                set ult = null

                set victimP = udg_Strain_MimicOwner[pId]
                if victimP == null then
                    set victimP = Player(PLAYER_NEUTRAL_PASSIVE)
                endif
                set ult = CreateUnit(victimP, udg_Strain_MimicType[pId], GetUnitX(caster), GetUnitY(caster), GetUnitFacing(caster))
                if IsUnitType(ult, UNIT_TYPE_HERO) or IsHeroUnitId(udg_Strain_MimicType[pId]) then
                    call UnitRemoveType(ult, UNIT_TYPE_HERO)
                    call UnitAddType(ult, UNIT_TYPE_SUMMONED)
                    call SuspendHeroXP(ult, true)
                    call GroupAddUnit(udg_FakeHeroGroup, ult)
                endif
                call UnitAddAbility(ult, 'Abun')
                call SetUnitPathing(ult, false)
                call RemoveGuardPosition(ult)
                call SetUnitMoveSpeed(ult, 522.0)

                set udg_Strain_MimicActor[pId] = ult
                set ult = null
                set victimP = null

                call SetPlayerAllianceStateBJ(Player(PLAYER_NEUTRAL_AGGRESSIVE), GetOwningPlayer(caster), bj_ALLIANCE_NEUTRAL)
                call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl", GetUnitX(caster), GetUnitY(caster)))
            endif
        endif
    elseif abil == 'A024' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set udg_Strain_Hero[pId] = caster
        call Strain_ShowGeneDialog(GetOwningPlayer(caster), pId)
    elseif abil == 'A031' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set udg_Wild_Hero[pId] = caster
        if GetPlayerController(GetOwningPlayer(caster)) == MAP_CONTROL_USER then
            call Wild_ShowTierDialog(GetOwningPlayer(caster), 1)
        endif
    elseif abil == 'A032' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set udg_Wild_Hero[pId] = caster
        if GetPlayerController(GetOwningPlayer(caster)) == MAP_CONTROL_USER then
            call Wild_ShowTierDialog(GetOwningPlayer(caster), 2)
        endif
    elseif abil == 'A033' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set udg_Wild_Hero[pId] = caster
        if GetPlayerController(GetOwningPlayer(caster)) == MAP_CONTROL_USER then
            call Wild_ShowTierDialog(GetOwningPlayer(caster), 3)
        endif
    elseif abil == 'A034' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set udg_Wild_Hero[pId] = caster
        call Wild_RevertToAvatar(caster)
    elseif abil == 'A035' then
        call Wild_CastWrath(caster)
    endif

    // Hero #3 Stolen Skill Resonance Overload (Supports both Slot 1 and Slot 2)
    set pId = GetPlayerId(GetOwningPlayer(caster))
    if GetUnitTypeId(caster) == 'H004' then
        set tier = 0
        if abil == udg_Strain_StolenAbil1[pId] and udg_Strain_EvoTier1[pId] >= 2 then
            set tier = udg_Strain_EvoTier1[pId]
        elseif abil == udg_Strain_StolenAbil2[pId] and udg_Strain_EvoTier2[pId] >= 2 then
            set tier = udg_Strain_EvoTier2[pId]
        elseif abil == udg_Strain_StolenHeroAbil[pId] and udg_Strain_EvoTier[pId] >= 2 then
            set tier = udg_Strain_EvoTier[pId]
        endif
        if tier >= 2 then
            call SetUnitState(caster, UNIT_STATE_MANA, GetUnitState(caster, UNIT_STATE_MANA) + 60.0)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIre\\AIreTarget.mdl", caster, "origin"))
            call GroupClear(udg_EnumGroup)
            call GroupEnumUnitsInRange(udg_EnumGroup, GetUnitX(caster), GetUnitY(caster), 350.0, null)
            loop
                set ult = FirstOfGroup(udg_EnumGroup)
                exitwhen ult == null
                call GroupRemoveUnit(udg_EnumGroup, ult)
                if IsUnitEnemy(ult, GetOwningPlayer(caster)) and not IsUnitType(ult, UNIT_TYPE_DEAD) and not IsUnitType(ult, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(ult) != 'u000' then
                    call UnitDamageTarget(caster, ult, I2R(GetHeroAgi(caster, true)) * 2.0 * I2R(tier), true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\CorrosiveBreath\\ChimaeraAcidTargetArt.mdl", ult, "chest"))
                endif
            endloop
            set ult = null
        endif
    endif

    set caster = null
    return false
endfunction

function DM_OnSpellCast takes nothing returns boolean
    local unit caster = GetTriggerUnit()
    local integer hIdx = DM_GetHeroIndex(caster)
    local integer abilId = GetSpellAbilityId()
    local integer pId = 0
    local unit tgt = null
    local real maxHP = 0.0
    local real curHP = 0.0
    local real casterMaxHP = 0.0
    local boolean isHero = false

    if hIdx >= 0 and udg_DM_InStealth[hIdx] then
        if abilId != 'A001' then
            call DM_BreakInvisibility(caster, null)
        endif
    endif

    if abilId == 'A022' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set tgt = GetSpellTargetUnit()
        if udg_Strain_DigestTimer[pId] > 0.0 then
            call IssueImmediateOrder(caster, "stop")
            call DisplayTimedTextToPlayer(GetOwningPlayer(caster), 0, 0, 3.0, "|cffffcc00[捕食吞噬]|r 正在消化猎物中，请等待消化完成！")
        elseif tgt != null then
            set casterMaxHP = GetUnitState(caster, UNIT_STATE_MAX_LIFE)
            set maxHP = GetUnitState(tgt, UNIT_STATE_MAX_LIFE)
            set curHP = GetWidgetLife(tgt)
            set isHero = IsUnitType(tgt, UNIT_TYPE_HERO) or IsHeroUnitId(GetUnitTypeId(tgt))
            if curHP > (casterMaxHP * 0.10) then
                if (isHero and curHP > (maxHP * 0.28)) or (not isHero and curHP > (maxHP * 0.35)) then
                    call IssueImmediateOrder(caster, "stop")
                    if GetPlayerController(GetOwningPlayer(caster)) == MAP_CONTROL_USER then
                        call DisplayTimedTextToPlayer(GetOwningPlayer(caster), 0, 0, 3.0, "|cffffcc00[捕食吞噬]|r 目标生命值过高（需低于自身上限10%[" + I2S(R2I(casterMaxHP * 0.10)) + "]，或普通单位<35%/英雄<28%）！")
                    endif
                endif
            endif
        endif
        set tgt = null
    endif

    if GetUnitTypeId(caster) == 'H004' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        if udg_Strain_Burrowed[pId] and abilId != 'A021' then
            call Strain_Unburrow(caster, pId)
        endif
        if udg_Strain_MimicActive[pId] and abilId != 'A023' and abilId != 'A024' then
            call Strain_BreakMimicry(caster, pId)
            set udg_Strain_AmbushReady[pId] = false
        endif
    endif

    set caster = null
    return false
endfunction

function DM_OnUnitAttacked takes nothing returns boolean
    local unit attacker = GetAttacker()
    local unit target = GetTriggerUnit()
    local integer pId = 0
    local integer attTypeId = 0
    local integer crRange = 128
    local real dx = 0.0
    local real dy = 0.0
    local real dist = 0.0

    if attacker != null then
        set attTypeId = GetUnitTypeId(attacker)
        if attTypeId == 'H004' then
            set pId = GetPlayerId(GetOwningPlayer(attacker))
            if udg_Strain_MimicActive[pId] then
                set udg_Strain_AmbushReady[pId] = true
                call Strain_BreakMimicry(attacker, pId)
            endif
        elseif attTypeId == 'H005' and target != null then
            set pId = GetPlayerId(GetOwningPlayer(attacker))
            if udg_Wild_IsMorphed[pId] then
                set crRange = Wild_GetCreepRange(udg_Wild_CurrentFormType[pId], udg_Wild_CurrentFormLevel[pId], 1)
            else
                set crRange = 600
            endif
            if crRange >= 400 then
                set dx = GetUnitX(target) - GetUnitX(attacker)
                set dy = GetUnitY(target) - GetUnitY(attacker)
                set dist = SquareRoot(dx * dx + dy * dy)
                if dist > 160.0 then
                    call DestroyEffect(AddSpecialEffectTarget(Wild_GetCreepMissileArt(BlzGetUnitSkin(attacker)), target, "chest"))
                endif
            endif
        endif
    endif

    set attacker = null
    set target = null
    return false
endfunction

function DM_OnDamaged takes nothing returns boolean
    local unit src = GetEventDamageSource()
    local unit tgt = GetTriggerUnit()
    local integer hIdx = -1
    local integer pId = 0
    local unit c = null
    local real oldX = 0.0
    local real oldY = 0.0
    local real nx = 0.0
    local real ny = 0.0
    local real nf = 0.0
    local real nhp = 0.0
    local real maxHP = 0.0
    local integer qLv = 0
    local real dmg = 0.0
    local integer eLv = 0
    local integer tier = 0
    local unit enumU = null

    if udg_Strain_DamageLock then
        return false
    endif

    if src != null and tgt != null and GetEventDamage() > 0.0 then
        set dmg = GetEventDamage()

        set hIdx = DM_GetHeroIndex(src)
        if hIdx >= 0 and udg_DM_InStealth[hIdx] then
            call DM_BreakInvisibility(src, tgt)
        endif

        // Hero #3: The Primordial Strain (H004) Damage Interactions
        if GetUnitTypeId(src) == 'H004' then
            set pId = GetPlayerId(GetOwningPlayer(src))
            set udg_Strain_Hero[pId] = src

            // Unburrow if attacking
            if udg_Strain_Burrowed[pId] then
                call Strain_Unburrow(src, pId)
            endif

            set udg_Strain_DamageLock = true

            // Ambush Critical Strike from Mimicry
            if udg_Strain_MimicActive[pId] or udg_Strain_AmbushReady[pId] then
                if udg_Strain_MimicActive[pId] then
                    call Strain_BreakMimicry(src, pId)
                endif
                set udg_Strain_AmbushReady[pId] = false
                set eLv = GetUnitAbilityLevel(src, 'A023')
                if eLv == 1 then
                    call UnitDamageTarget(src, tgt, dmg * 0.50, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                elseif eLv == 2 then
                    call UnitDamageTarget(src, tgt, dmg * 0.75, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                else
                    call UnitDamageTarget(src, tgt, dmg * 1.00, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                endif
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\CriticalStrike\\CriticalStrike.mdl", tgt, "overhead"))
            endif

            // Gene On-Attack Effects
            set tier = udg_Strain_EvoTier[pId]
            if udg_Strain_GeneCat[pId] == 2 then
                // Cat 2: Poison
                if tier == 2 then
                    call UnitDamageTarget(src, tgt, 30.0, false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl", tgt, "chest"))
                elseif tier >= 3 then
                    call GroupClear(udg_EnumGroup)
                    call GroupEnumUnitsInRange(udg_EnumGroup, GetUnitX(tgt), GetUnitY(tgt), 300.0, null)
                    loop
                        set enumU = FirstOfGroup(udg_EnumGroup)
                        exitwhen enumU == null
                        call GroupRemoveUnit(udg_EnumGroup, enumU)
                        if IsUnitEnemy(enumU, GetOwningPlayer(src)) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(enumU) != 'u000' then
                            call UnitDamageTarget(src, enumU, 55.0 + 1.0 * I2R(GetHeroAgi(src, true)), false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\PoisonSting\\PoisonStingTarget.mdl", enumU, "chest"))
                        endif
                    endloop
                    set enumU = null
                endif
            elseif udg_Strain_GeneCat[pId] == 3 then
                // Cat 3: Bloodlust Lifesteal + Bonus Damage + Visual + AoE Ally Heal
                call SetWidgetLife(src, GetWidgetLife(src) + 0.15 * I2R(tier) * dmg)
                call UnitDamageTarget(src, tgt, 20.0 * I2R(tier), false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\Bloodlust\\BloodlustTarget.mdl", src, "origin"))
                if tier >= 3 then
                    call GroupClear(udg_EnumGroup)
                    call GroupEnumUnitsInRange(udg_EnumGroup, GetUnitX(src), GetUnitY(src), 450.0, null)
                    loop
                        set enumU = FirstOfGroup(udg_EnumGroup)
                        exitwhen enumU == null
                        call GroupRemoveUnit(udg_EnumGroup, enumU)
                        if not IsUnitEnemy(enumU, GetOwningPlayer(src)) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(enumU) != 'u000' then
                            call SetWidgetLife(enumU, GetWidgetLife(enumU) + 0.10 * dmg)
                            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Items\\AIhe\\AIheTarget.mdl", enumU, "origin"))
                        endif
                    endloop
                    set enumU = null
                endif
            elseif udg_Strain_GeneCat[pId] == 4 then
                // Cat 4: Lightning Strike + Thunderclap AoE
                call UnitDamageTarget(src, tgt, 35.0 * I2R(tier), false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl", tgt, "chest"))
                if tier >= 3 then
                    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", GetUnitX(src), GetUnitY(src)))
                    call GroupClear(udg_EnumGroup)
                    call GroupEnumUnitsInRange(udg_EnumGroup, GetUnitX(src), GetUnitY(src), 300.0, null)
                    loop
                        set enumU = FirstOfGroup(udg_EnumGroup)
                        exitwhen enumU == null
                        call GroupRemoveUnit(udg_EnumGroup, enumU)
                        if IsUnitEnemy(enumU, GetOwningPlayer(src)) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(enumU) != 'u000' then
                            call UnitDamageTarget(src, enumU, 250.0, false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                        endif
                    endloop
                    set enumU = null
                endif
            endif

            set udg_Strain_DamageLock = false
        endif

        // When H004 takes damage: Cat 1 Shield Damage Reflection
        if GetUnitTypeId(tgt) == 'H004' then
            set pId = GetPlayerId(GetOwningPlayer(tgt))
            if udg_Strain_GeneCat[pId] == 1 and udg_Strain_EvoTier[pId] >= 3 and src != null then
                set udg_Strain_DamageLock = true
                call UnitDamageTarget(tgt, src, dmg * 0.50, false, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Defend\\DefendCaster.mdl", tgt, "origin"))
                set udg_Strain_DamageLock = false
            endif
        endif

        // Ninja (A011) - Pre-lethal swap
        if GetUnitTypeId(tgt) == 'H003' and not IsUnitInGroup(tgt, udg_FakeHeroGroup) and not IsUnitIllusion(tgt) then
            set pId = GetPlayerId(GetOwningPlayer(tgt))
            set udg_Ninja_TrueHero[pId] = tgt
            if GetEventDamage() >= (GetWidgetLife(tgt) - 1.0) then
                set c = Ninja_PickLivingClone(pId)
                if c != null then
                    // Hero survived via clone swap! Do not mark killer with Karma
                    set oldX = GetUnitX(tgt)
                    set oldY = GetUnitY(tgt)
                    set nx = GetUnitX(c)
                    set ny = GetUnitY(c)
                    set nf = GetUnitFacing(c)
                    set nhp = GetWidgetLife(c)

                    call GroupRemoveUnit(udg_Ninja_CloneGroup[pId], c)
                    call GroupRemoveUnit(udg_FakeHeroGroup, c)
                    call RemoveUnit(c)
                    set c = null

                    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageDeathCaster.mdl", oldX, oldY))
                    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl", oldX, oldY))

                    set maxHP = GetUnitState(tgt, UNIT_STATE_MAX_LIFE)
                    set qLv = GetUnitAbilityLevel(tgt, 'A011')
                    if qLv == 2 and nhp < (maxHP * 0.30) then
                        set nhp = maxHP * 0.30
                    elseif qLv >= 3 and nhp < (maxHP * 0.50) then
                        set nhp = maxHP * 0.50
                    endif

                    call SetWidgetLife(tgt, maxHP)
                    if udg_Ninja_PendingCount < 32 then
                        set udg_Ninja_PendingHealUnit[udg_Ninja_PendingCount] = tgt
                        set udg_Ninja_PendingHealHP[udg_Ninja_PendingCount] = RMaxBJ(nhp, maxHP * 0.35)
                        set udg_Ninja_PendingCount = udg_Ninja_PendingCount + 1
                    endif

                    call SetUnitX(tgt, nx)
                    call SetUnitY(tgt, ny)
                    call SetUnitFacing(tgt, nf)
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl", tgt, "origin"))
                endif
            endif
        endif
    endif

    set src = null
    set tgt = null
    return false
endfunction

function DM_OnHeroRevivable takes nothing returns boolean
    local unit rev = GetRevivableUnit()
    if rev != null and (IsUnitInGroup(rev, udg_FakeHeroGroup) or IsUnitIllusion(rev)) then
        call RemoveUnit(rev)
    endif
    set rev = null
    return false
endfunction

function DM_OnUnitDeath takes nothing returns boolean
    local unit dead = GetTriggerUnit()
    local unit killer = GetKillingUnit()
    local player deadOwner = GetOwningPlayer(dead)
    local integer deadPId = GetPlayerId(deadOwner)
    local integer deadType = GetUnitTypeId(dead)
    local real deadX = GetUnitX(dead)
    local real deadY = GetUnitY(dead)
    local real deadFacing = GetUnitFacing(dead)
    local boolean isFakeHero = IsUnitInGroup(dead, udg_FakeHeroGroup)
    local boolean isIllusion = IsUnitIllusion(dead)
    local boolean isAnyClone = false
    local integer idx = -1
    local integer kIdx = -1
    local player ko = null
    local integer klv = 0
    local boolean hasLivingNinja = false
    local player kp = null
    local unit th = null
    local integer eLv = 0
    local unit c = null
    local real nx = 0.0
    local real ny = 0.0
    local real nhp = 0.0
    local integer i = 0
    local item it = null
    local player killerOwner = null
    local integer killerPId = -1

    // Anti-recursion lock
    if udg_Ninja_DeathLock then
        set dead = null
        set killer = null
        set deadOwner = null
        return false
    endif
    set udg_Ninja_DeathLock = true

    set isAnyClone = Ninja_IsAnyClone(dead)

    // 1. Dream Master Possession Return
    set idx = DM_FindCapIndex(dead)
    if idx >= 0 then
        call SetUnitOwner(dead, udg_CapOrigOwner[idx], true)
        call DM_RemoveCapIndex(idx)
    endif

    // 1.5. Clean up Hero #3 state on death
    if deadType == 'H004' then
        if udg_Strain_Burrowed[deadPId] then
            call Strain_Unburrow(dead, deadPId)
        endif
        if udg_Strain_MimicActive[deadPId] then
            call Strain_BreakMimicry(dead, deadPId)
            set udg_Strain_AmbushReady[deadPId] = false
        endif
        if udg_Strain_DigestFx[deadPId] != null then
            call DestroyEffect(udg_Strain_DigestFx[deadPId])
            set udg_Strain_DigestFx[deadPId] = null
            set udg_Strain_DigestTimer[deadPId] = 0.0
        endif
    endif

    // 1.6. Clean up Hero #4 state on death
    if deadType == 'H005' then
        if udg_Wild_IsMorphed[deadPId] then
            call Wild_RevertToAvatar(dead)
        endif
    endif

    // 1.7. Thrall item removal on death
    if deadType == 'u003' then
        set i = 0
        loop
            exitwhen i > 5
            set it = UnitItemInSlot(dead, i)
            if it != null then
                call RemoveItem(it)
            endif
            set i = i + 1
        endloop
        set it = null
    endif

    // 1.8. Thrall Enslavement Check (Hero #4 为虎作伥)
    if killer != null then
        set killerOwner = GetOwningPlayer(killer)
        if killerOwner != null and IsUnitEnemy(dead, killerOwner) and not IsUnitType(dead, UNIT_TYPE_STRUCTURE) and not isIllusion and not isFakeHero and not isAnyClone and deadType != 'u000' and deadType != 'u001' and deadType != 'u002' and deadType != 'u003' then
            set killerPId = GetPlayerId(killerOwner)
            if killerPId >= 0 and killerPId <= 15 then
                if IsUnitInGroup(killer, udg_Wild_ArmyGroup) or (udg_Wild_WrathTimer[killerPId] > 0.0) then
                    if IsUnitType(dead, UNIT_TYPE_HERO) then
                        call Wild_EnslaveHero(killerPId, dead)
                    else
                        call Wild_EnslaveCreep(killerPId, dead)
                    endif
                endif
            endif
        endif
        set killerOwner = null
    endif

    // 2. Ninja Karma Mark (ONLY TRUE HERO H003 marks killer; clones NEVER mark killer!)
    if deadType == 'H003' and not isFakeHero and not isIllusion and not isAnyClone and killer != null and IsUnitEnemy(killer, deadOwner) then
        set eLv = GetUnitAbilityLevel(dead, 'A013')
        if eLv > 0 then
            call Ninja_MarkKarma(killer, deadOwner, eLv)
        endif
    endif

    // 3. Ninja Karma Rebirth (One mark triggers strictly ONE rebirth/spawn, then consumed)
    set kIdx = Ninja_FindKarmaIndex(dead)
    if kIdx >= 0 then
        set ko = udg_KarmaOwner[kIdx]
        set klv = udg_KarmaLevel[kIdx]
        call Ninja_RemoveKarmaIndex(kIdx)

        if ko != null then
            set th = Ninja_GetTrueHero(ko)
            set hasLivingNinja = false
            if th != null and not IsUnitType(th, UNIT_TYPE_DEAD) and GetWidgetLife(th) > 0.405 then
                set hasLivingNinja = true
            elseif Ninja_PickLivingClone(GetPlayerId(ko)) != null then
                set hasLivingNinja = true
            endif

            if not hasLivingNinja and th != null then
                call ReviveHero(th, deadX, deadY, true)
                call SetUnitFacing(th, deadFacing)
                call SetWidgetLife(th, GetUnitState(th, UNIT_STATE_MAX_LIFE))
                call SetUnitState(th, UNIT_STATE_MANA, GetUnitState(th, UNIT_STATE_MAX_MANA))
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl", th, "origin"))
                if GetLocalPlayer() == ko then
                    call SelectUnit(th, true)
                endif
            else
                // Exactly 1 clone respawn, respects 3/5/7 hard cap
                call Ninja_SpawnClone(ko, deadX, deadY, deadFacing)
            endif
            set th = null
            set ko = null
        endif
    endif

    // 4. Ninja Clone on Kill (A011): Clones CANNOT be cloned; victims must not be any clone!
    if killer != null and not IsUnitType(dead, UNIT_TYPE_STRUCTURE) and not isAnyClone and deadType != 'u000' and deadType != 'u001' and deadType != 'u002' and deadType != 'H003' and not isFakeHero and not isIllusion and (GetUnitTypeId(killer) == 'H003' or GetUnitTypeId(killer) == 'u002' or GetUnitTypeId(killer) == 'u001') then
        set kp = GetOwningPlayer(killer)
        set th = Ninja_GetTrueHero(kp)
        if GetUnitAbilityLevel(killer, 'A011') > 0 or (th != null and GetUnitAbilityLevel(th, 'A011') > 0) or GetPlayerController(kp) == MAP_CONTROL_COMPUTER or GetUnitTypeId(killer) == 'u001' then
            call Ninja_SpawnClone(kp, deadX, deadY, deadFacing)
        endif
        set kp = null
        set th = null
    endif

    // 5. Ninja Clone Swap Fallback (True Hero death swap into living clone)
    if deadType == 'H003' and not isFakeHero and not isIllusion and not isAnyClone then
        set c = Ninja_PickLivingClone(deadPId)
        if c != null then
            set nx = GetUnitX(c)
            set ny = GetUnitY(c)
            set nhp = GetWidgetLife(c)
            call GroupRemoveUnit(udg_Ninja_CloneGroup[deadPId], c)
            call GroupRemoveUnit(udg_FakeHeroGroup, c)
            call SetUnitExploded(c, true)
            call RemoveUnit(c)
            set c = null

            call ReviveHero(dead, nx, ny, false)
            call SetWidgetLife(dead, RMaxBJ(nhp, GetUnitState(dead, UNIT_STATE_MAX_LIFE) * 0.35))
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl", dead, "origin"))
            if GetLocalPlayer() == deadOwner then
                call SelectUnit(dead, true)
            endif
        endif
    endif

    // 6. Cleanup Fake Hero / Clone (Explode cleanly, no unit spawned)
    if isAnyClone or isFakeHero or deadType == 'u002' or deadType == 'u001' then
        if udg_Ninja_CloneGroup[deadPId] != null then
            call GroupRemoveUnit(udg_Ninja_CloneGroup[deadPId], dead)
        endif
        call GroupRemoveUnit(udg_FakeHeroGroup, dead)
        call SetUnitOwner(dead, Player(PLAYER_NEUTRAL_PASSIVE), false)
        call SetUnitExploded(dead, true)
        call RemoveUnit(dead)
    endif

    // 7. Human Player Refuge Auto-Revive Registration
    if IsUnitType(dead, UNIT_TYPE_HERO) and not isFakeHero and not isIllusion and not isAnyClone and deadType != 'u001' and deadType != 'u002' then
        if IsUnitType(dead, UNIT_TYPE_DEAD) or GetWidgetLife(dead) <= 0.405 then
            call Refuge_OnHeroDeath(dead)
        endif
    endif

    set dead = null
    set killer = null
    set deadOwner = null
    set udg_Ninja_DeathLock = false
    return false
endfunction

function TM_ApplyAIConfig takes nothing returns nothing
    local integer i = 0
    local group g = null
    local unit u = null
    local boolean hasCustom = false

    set i = 0
    loop
        exitwhen i > 7
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
            if udg_AI_HeroMode[i] > 0 then
                set hasCustom = true
                if not udg_AI_HeroSpawned[i] then
                    set g = CreateGroup()
                    call GroupEnumUnitsOfPlayer(g, Player(i), null)
                    loop
                        set u = FirstOfGroup(g)
                        exitwhen u == null
                        call GroupRemoveUnit(g, u)
                        if IsUnitType(u, UNIT_TYPE_HERO) and GetUnitTypeId(u) != 'H002' and GetUnitTypeId(u) != 'H003' and GetUnitTypeId(u) != 'H004' and not IsUnitIllusion(u) and not IsUnitInGroup(u, udg_FakeHeroGroup) then
                            call AI_SpawnCustomHeroForPlayer(i, GetUnitX(u), GetUnitY(u), GetUnitFacing(u))
                            call RemoveUnit(u)
                            call GroupClear(g)
                        endif
                    endloop
                    call DestroyGroup(g)
                    set g = null
                endif
            endif
        endif
        set i = i + 1
    endloop
endfunction

function TM_ShowMainDialog takes player p returns nothing
    if p == null then
        return
    endif
    set udg_TM_PromptPlayer = p
    call DialogDisplay(p, udg_TM_MainDialog, false)
    call DialogClear(udg_TM_MainDialog)
    call DialogSetMessage(udg_TM_MainDialog, "【测试模式选择】(鼠标点击或按数字键1-6)")
    set udg_TM_BtnNormal = DialogAddButton(udg_TM_MainDialog, "[1] 正常模式（使用原有英雄）", 49)
    set udg_TM_BtnMode1All = DialogAddButton(udg_TM_MainDialog, "[2] 测试模式一：全部电脑出【幻梦大师】", 50)
    set udg_TM_BtnMode2All = DialogAddButton(udg_TM_MainDialog, "[3] 测试模式二：全部电脑出【魔音忍者】", 51)
    set udg_TM_BtnMode3All = DialogAddButton(udg_TM_MainDialog, "[4] 测试模式三：全部电脑出【异种之源】", 52)
    set udg_TM_BtnMode4All = DialogAddButton(udg_TM_MainDialog, "[5] 测试模式四：全部电脑出【万灵化身】", 53)
    set udg_TM_BtnCustom = DialogAddButton(udg_TM_MainDialog, "[6] 精细配置：指定玩家的英雄...", 54)
    call DialogDisplay(p, udg_TM_MainDialog, true)
endfunction

function TM_ShowSlotDialog takes player p returns nothing
    local integer i = 0
    local string lbl = ""
    if p == null then
        return
    endif
    set udg_TM_PromptPlayer = p
    call DialogDisplay(p, udg_TM_SlotDialog, false)
    call DialogClear(udg_TM_SlotDialog)
    call DialogSetMessage(udg_TM_SlotDialog, "【精细配置】点击切换英雄 (确定后生效)")
    set i = 0
    loop
        exitwhen i > 7
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
            if udg_AI_HeroMode[i] == 1 then
                set lbl = "玩家 " + I2S(i + 1) + "：【幻梦大师】 (点击切换)"
            elseif udg_AI_HeroMode[i] == 2 then
                set lbl = "玩家 " + I2S(i + 1) + "：【魔音忍者】 (点击切换)"
            elseif udg_AI_HeroMode[i] == 3 then
                set lbl = "玩家 " + I2S(i + 1) + "：【异种之源】 (点击切换)"
            elseif udg_AI_HeroMode[i] == 4 then
                set lbl = "玩家 " + I2S(i + 1) + "：【万灵化身】 (点击切换)"
            else
                set lbl = "玩家 " + I2S(i + 1) + "：【常规默认英雄】 (点击切换)"
            endif
            set udg_TM_SlotBtn[i] = DialogAddButton(udg_TM_SlotDialog, lbl, 0)
        else
            set udg_TM_SlotBtn[i] = null
        endif
        set i = i + 1
    endloop
    set udg_TM_SlotConfirm = DialogAddButton(udg_TM_SlotDialog, "[9] 确定配置并开始", 57)
    set udg_TM_SlotBack = DialogAddButton(udg_TM_SlotDialog, "[0] 返回上一菜单", 48)
    call DialogDisplay(p, udg_TM_SlotDialog, true)
endfunction

function TM_OnMainDialogClicked takes nothing returns nothing
    local button b = GetClickedButton()
    local player p = GetTriggerPlayer()
    local integer i = 0
    if p == null then
        set p = udg_TM_PromptPlayer
    endif

    call DialogDisplay(p, udg_TM_MainDialog, false)

    if b == udg_TM_BtnNormal then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 0
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 正常模式：使用原有英雄 (随时输入 -test 可重选)")
        call TM_ApplyAIConfig()
    elseif b == udg_TM_BtnMode1All then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 1
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式一：全部电脑出【幻梦大师】！(随时输入 -test 可重选)")
        call TM_ApplyAIConfig()
    elseif b == udg_TM_BtnMode2All then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 2
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式二：全部电脑出【魔音忍者】！(随时输入 -test 可重选)")
        call TM_ApplyAIConfig()
    elseif b == udg_TM_BtnMode3All then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 3
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式三：全部电脑出【异种之源】！(随时输入 -test 可重选)")
        call TM_ApplyAIConfig()
    elseif b == udg_TM_BtnMode4All then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 4
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式四：全部电脑出【万灵化身】！(随时输入 -test 可重选)")
        call TM_ApplyAIConfig()
    elseif b == udg_TM_BtnCustom then
        call TM_ShowSlotDialog(p)
    endif

    set b = null
    set p = null
endfunction

function TM_OnSlotDialogClicked takes nothing returns nothing
    local button b = GetClickedButton()
    local player p = GetTriggerPlayer()
    local integer i = 0
    if p == null then
        set p = udg_TM_PromptPlayer
    endif

    if b == udg_TM_SlotConfirm then
        call DialogDisplay(p, udg_TM_SlotDialog, false)
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 英雄配置精细设定已生效！(随时输入 -test 可重选)")
        call TM_ApplyAIConfig()
    elseif b == udg_TM_SlotBack then
        call DialogDisplay(p, udg_TM_SlotDialog, false)
        call TM_ShowMainDialog(p)
    else
        set i = 0
        loop
            exitwhen i > 7
            if b == udg_TM_SlotBtn[i] then
                if udg_AI_HeroMode[i] == 0 then
                    set udg_AI_HeroMode[i] = 1
                elseif udg_AI_HeroMode[i] == 1 then
                    set udg_AI_HeroMode[i] = 2
                elseif udg_AI_HeroMode[i] == 2 then
                    set udg_AI_HeroMode[i] = 3
                elseif udg_AI_HeroMode[i] == 3 then
                    set udg_AI_HeroMode[i] = 4
                else
                    set udg_AI_HeroMode[i] = 0
                endif
                call TM_ShowSlotDialog(p)
                set b = null
                set p = null
                return
            endif
            set i = i + 1
        endloop
    endif

    set b = null
    set p = null
endfunction

function TM_SpawnSandboxTargets takes player p returns nothing
    local group g = CreateGroup()
    local unit u = null
    local real hx = 0.0
    local real hy = 0.0
    local unit targetU = null
    local integer pId = 0
    local real maxHP = 0.0

    if p == null then
        return
    endif
    set pId = GetPlayerId(p)

    call GroupEnumUnitsOfPlayer(g, p, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if IsUnitType(u, UNIT_TYPE_HERO) and not IsUnitIllusion(u) and not IsUnitInGroup(u, udg_FakeHeroGroup) then
            set hx = GetUnitX(u)
            set hy = GetUnitY(u)
            set u = null
            exitwhen true
        endif
    endloop
    call DestroyGroup(g)
    set g = null

    if hx == 0.0 and hy == 0.0 then
        set hx = GetStartLocationX(GetPlayerStartLocation(p))
        set hy = GetStartLocationY(GetPlayerStartLocation(p))
    endif

    // Reset digestion timer & cooldown for instant repeated testing
    set udg_Strain_DigestTimer[pId] = 0.0
    if udg_Strain_DigestFx[pId] != null then
        call DestroyEffect(udg_Strain_DigestFx[pId])
        set udg_Strain_DigestFx[pId] = null
    endif
    if udg_Strain_Hero[pId] != null then
        call UnitResetCooldown(udg_Strain_Hero[pId])
    endif

    // 1. Footman (hfoo) - Melee, Defend -> A025
    set targetU = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'hfoo', hx + 180.0, hy + 120.0, 180.0)
    call UnitAddAbility(targetU, 'Adef')
    call SetWidgetLife(targetU, GetUnitState(targetU, UNIT_STATE_MAX_LIFE) * 0.20)
    call PauseUnit(targetU, true)

    // 2. Grunt (ogru) - White-meat creep, NO skills -> +HP only, no dialog
    set targetU = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'ogru', hx + 180.0, hy + 60.0, 180.0)
    call SetWidgetLife(targetU, GetUnitState(targetU, UNIT_STATE_MAX_LIFE) * 0.20)
    call PauseUnit(targetU, true)

    // 3. Dryad (edry) - Slow Poison -> A026
    set targetU = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'edry', hx + 180.0, hy, 180.0)
    call UnitAddAbility(targetU, 'Aspo')
    call SetWidgetLife(targetU, GetUnitState(targetU, UNIT_STATE_MAX_LIFE) * 0.20)
    call PauseUnit(targetU, true)

    // 4. Shaman (oshm) - Magical caster -> Bloodlust (ACbl) / Lightning Shield (ACls) / Purge (ACpu)
    set targetU = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'oshm', hx + 180.0, hy - 60.0, 180.0)
    call UnitAddAbility(targetU, 'Ablo')
    call UnitAddAbility(targetU, 'Alsh')
    call UnitAddAbility(targetU, 'Apgr')
    call SetWidgetLife(targetU, GetUnitState(targetU, UNIT_STATE_MAX_LIFE) * 0.20)
    call PauseUnit(targetU, true)

    // Reset Wild Avatar D cooldown & give A035 for instant testing
    if udg_Wild_Hero[pId] != null then
        call UnitResetCooldown(udg_Wild_Hero[pId])
        set udg_Wild_MorphCD[pId] = 0.0
        if GetUnitAbilityLevel(udg_Wild_Hero[pId], 'A035') == 0 then
            call UnitAddAbility(udg_Wild_Hero[pId], 'A035')
        endif
        call SetUnitState(udg_Wild_Hero[pId], UNIT_STATE_MANA, I2R(BlzGetUnitMaxMana(udg_Wild_Hero[pId])))
        call DisplayTimedTextToPlayer(p, 0, 0, 4.0, "|cff00ff00[沙盒测试]|r 万灵化身【众野之怒】冷却已重置，法力已回满！")
    endif

    // 5. Blademaster (Obla) - Reusable Hero: preserves drained stats across devours & Thrall testing!
    if udg_Test_DummyHero != null then
        if IsUnitType(udg_Test_DummyHero, UNIT_TYPE_DEAD) or GetWidgetLife(udg_Test_DummyHero) <= 0.405 then
            call ReviveHero(udg_Test_DummyHero, hx + 180.0, hy - 120.0, false)
        else
            call SetUnitPosition(udg_Test_DummyHero, hx + 180.0, hy - 120.0)
        endif
        set maxHP = GetUnitState(udg_Test_DummyHero, UNIT_STATE_MAX_LIFE)
        if maxHP > 1.0 then
            call SetWidgetLife(udg_Test_DummyHero, RMaxBJ(1.0, maxHP * 0.20))
        else
            call SetWidgetLife(udg_Test_DummyHero, 1.0)
        endif
        call PauseUnit(udg_Test_DummyHero, true)
    else
        set udg_Test_DummyHero = CreateUnit(Player(PLAYER_NEUTRAL_AGGRESSIVE), 'Obla', hx + 180.0, hy - 120.0, 180.0)
        call SetWidgetLife(udg_Test_DummyHero, GetUnitState(udg_Test_DummyHero, UNIT_STATE_MAX_LIFE) * 0.20)
        call PauseUnit(udg_Test_DummyHero, true)
    endif

    // Give Dummy Blademaster items & critical strike for Thrall Enslavement test
    if GetUnitAbilityLevel(udg_Test_DummyHero, 'AOcr') == 0 then
        call UnitAddAbility(udg_Test_DummyHero, 'AOcr')
        call SetUnitAbilityLevel(udg_Test_DummyHero, 'AOcr', 3)
    endif
    if UnitItemInSlot(udg_Test_DummyHero, 0) == null then
        call UnitAddItemById(udg_Test_DummyHero, 'bspd')
        call UnitAddItemById(udg_Test_DummyHero, 'clov')
        call UnitAddItemById(udg_Test_DummyHero, 'rhth')
    endif

    set targetU = null
    call DisplayTimedTextToPlayer(p, 0, 0, 8.0, "|cff00ff00[沙盒测试]|r 已生成5个测试靶子（步兵[防御->异种甲壳]/兽人步兵[纯白肉无技能]/树妖[慢毒->异种剧毒]/萨满[嗜血/电盾/净化]/剑圣[英雄]），W吞噬已就绪！")
endfunction

function TM_OnChatCommand takes nothing returns nothing
    local string s = StringCase(GetEventPlayerChatString(), false)
    local player p = GetTriggerPlayer()
    local integer i = 0
    if p == null then
        set p = udg_TM_PromptPlayer
    endif

    if s == "-test" or s == "-mode" then
        call TM_ShowMainDialog(p)
    elseif s == "-m0" then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 0
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 正常模式：使用原有默认英雄。")
        call TM_ApplyAIConfig()
    elseif s == "-m1" then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 1
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式一：全部电脑出【幻梦大师】！")
        call TM_ApplyAIConfig()
    elseif s == "-m2" then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 2
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式二：全部电脑出【魔音忍者】！")
        call TM_ApplyAIConfig()
    elseif s == "-m3" then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 3
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式三：全部电脑出【异种之源】！")
        call TM_ApplyAIConfig()
    elseif s == "-m4" then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 4
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式四：全部电脑出【万灵化身】！")
        call TM_ApplyAIConfig()
    elseif s == "-spawn" then
        call TM_SpawnSandboxTargets(p)
    elseif s == "-refuge" then
        call Refuge_Relocate(p)
    endif

    set p = null
endfunction

function TM_GetFirstHumanPlayer takes nothing returns player
    local integer i = 0
    loop
        exitwhen i > 7
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_USER then
            return Player(i)
        endif
        set i = i + 1
    endloop
    return null
endfunction

function TM_OnStartTimer takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local player p = TM_GetFirstHumanPlayer()
    call PauseTimer(t)
    call DestroyTimer(t)
    set t = null
    if p != null then
        call TM_ShowMainDialog(p)
    endif
    set p = null
endfunction

function AI_OnHeroLevel takes nothing returns boolean
    local unit h = GetLevelingUnit()
    if h != null and (GetUnitTypeId(h) == 'H002' or GetUnitTypeId(h) == 'H003' or GetUnitTypeId(h) == 'H004' or GetUnitTypeId(h) == 'H005') then
        if GetPlayerController(GetOwningPlayer(h)) == MAP_CONTROL_COMPUTER then
            call AI_AutoLearnSkills(h)
        endif
    endif
    set h = null
    return false
endfunction

function AI_OnUnitTrainFinish takes nothing returns boolean
    local unit trained = GetTrainedUnit()
    local player p = null
    local integer pId = 0
    local real hx = 0.0
    local real hy = 0.0
    local real hf = 0.0

    if trained != null then
        set p = GetOwningPlayer(trained)
        set pId = GetPlayerId(p)
        if GetUnitTypeId(trained) == 'H004' then
            set udg_Strain_Hero[pId] = trained
            call Strain_InitHero(trained)
        elseif GetUnitTypeId(trained) == 'H005' then
            set udg_Wild_Hero[pId] = trained
            call Wild_InitHero(trained)
        endif
        if GetPlayerController(p) == MAP_CONTROL_COMPUTER then
            if udg_AI_HeroMode[pId] > 0 and not IsUnitType(trained, UNIT_TYPE_PEON) then
                call RemoveGuardPosition(trained)
            endif
            if GetUnitTypeId(trained) == 'H005' then
                set udg_Wild_Hero[pId] = trained
                set udg_AI_CustomHero[pId] = trained
                set udg_AI_HeroSpawned[pId] = true
                call AI_AutoLearnSkills(trained)
            elseif GetUnitTypeId(trained) == 'H004' then
                set udg_AI_CustomHero[pId] = trained
                set udg_AI_HeroSpawned[pId] = true
                call AI_AutoLearnSkills(trained)
            elseif GetUnitTypeId(trained) == 'H003' then
                set udg_Ninja_TrueHero[pId] = trained
                set udg_AI_CustomHero[pId] = trained
                set udg_AI_HeroSpawned[pId] = true
                call AI_AutoLearnSkills(trained)
            elseif GetUnitTypeId(trained) == 'H002' then
                set udg_AI_CustomHero[pId] = trained
                set udg_AI_HeroSpawned[pId] = true
                call AI_AutoLearnSkills(trained)
            elseif udg_AI_HeroMode[pId] > 0 and not udg_AI_HeroSpawned[pId] and IsUnitType(trained, UNIT_TYPE_HERO) and not IsUnitIllusion(trained) and not IsUnitInGroup(trained, udg_FakeHeroGroup) then
                set hx = GetUnitX(trained)
                set hy = GetUnitY(trained)
                set hf = GetUnitFacing(trained)
                call RemoveUnit(trained)
                call AI_SpawnCustomHeroForPlayer(pId, hx, hy, hf)
            endif
        endif
    endif

    set trained = null
    set p = null
    return false
endfunction

function DM_InitTriggers takes nothing returns nothing
    local trigger tAttack = CreateTrigger()
    local trigger tEffect = CreateTrigger()
    local trigger tCast = CreateTrigger()
    local trigger tDeath = CreateTrigger()
    local trigger tDamage = CreateTrigger()
    local trigger tRevive = CreateTrigger()
    local trigger tSkill = CreateTrigger()
    local trigger tTrain = CreateTrigger()
    local trigger tLevel = CreateTrigger()
    local trigger tMainDialog = CreateTrigger()
    local trigger tSlotDialog = CreateTrigger()
    local trigger tChat = CreateTrigger()
    local trigger tGeneDialog = CreateTrigger()
    local trigger tHeroDialog = CreateTrigger()
    local trigger tReplaceDialog = CreateTrigger()
    local trigger tWildDialog = CreateTrigger()
    local timer tmrCap = CreateTimer()
    local timer tmrStealth = CreateTimer()
    local timer tmrStart = CreateTimer()
    local timer tmrRefuge = CreateTimer()
    local integer i = 0

    set udg_EnumGroup = CreateGroup()
    set udg_FakeHeroGroup = CreateGroup()
    set udg_AI_ArmyGroup = CreateGroup()
    set udg_AI_CombatGroup = CreateGroup()

    set i = 0
    loop
        exitwhen i > 15
        set udg_Ninja_CloneGroup[i] = CreateGroup()
        set udg_Ninja_AuraOn[i] = false
        set udg_Ninja_AuraFx[i] = null
        set udg_Ninja_TrueHero[i] = null

        // Initialize AI variables
        set udg_AI_HeroMode[i] = 0
        set udg_AI_CustomHero[i] = null
        set udg_AI_LockedTarget[i] = null
        set udg_AI_HeroSpawned[i] = false
        set udg_AI_CastCD_Q[i] = 0.0
        set udg_AI_CastCD_W[i] = 0.0
        set udg_AI_CastCD_E[i] = 0.0
        set udg_AI_CastCD_R[i] = 0.0
        set udg_AI_DeadTimer[i] = 0.0
        set udg_AI_AltarTimer[i] = 0.0
        set udg_AI_WaitTimer[i] = 0.0
        set udg_TM_SlotBtn[i] = null

        // Initialize Strain variables
        set udg_Strain_Burrowed[i] = false
        set udg_Strain_BurrowTimer[i] = 0.0
        set udg_Strain_DigestTimer[i] = 0.0
        set udg_Strain_DigestFeedType[i] = 0
        set udg_Strain_DigestVictimLv[i] = 1
        set udg_Strain_DigestSkillLv[i] = 1
        set udg_Strain_TotalBonusHP[i] = 0
        set udg_Strain_TotalBonusAtk[i] = 0
        set udg_Strain_TotalBonusMana[i] = 0
        set udg_Strain_DigestType[i] = 0
        set udg_Strain_DigestOwner[i] = null
        set udg_Strain_DigestIsHero[i] = false
        set udg_Strain_DigestFx[i] = null
        set udg_Strain_MimicActive[i] = false
        set udg_Strain_AmbushReady[i] = false
        set udg_Strain_MimicType[i] = 0
        set udg_Strain_MimicOwner[i] = null
        set udg_Strain_MimicActor[i] = null
        set udg_Strain_GeneCat[i] = 0
        set udg_Strain_EvoTier[i] = 0
        set udg_Strain_StolenHeroAbil[i] = 0
        set udg_Strain_CandidateAbil0[i] = 0
        set udg_Strain_CandidateAbil1[i] = 0
        set udg_Strain_CandidateAbil2[i] = 0
        set udg_Strain_CandidateAbil3[i] = 0
        set udg_Strain_CandidateCount[i] = 0
        set udg_Strain_StolenAbil1[i] = 0
        set udg_Strain_StolenAbil2[i] = 0
        set udg_Strain_EvoTier1[i] = 0
        set udg_Strain_EvoTier2[i] = 0
        set udg_Strain_PendingNewAbil[i] = 0
        set udg_Strain_Hero[i] = null

        set udg_Wild_Hero[i] = null
        set udg_Wild_IsMorphed[i] = false
        set udg_Wild_CurrentForm[i] = 0
        set udg_Wild_CurrentFormType[i] = 0
        set udg_Wild_CurrentFormLevel[i] = 0
        set udg_Wild_CurrentAbil[i] = 0
        set udg_Wild_StoredManaRatio[i] = 1.0
        set udg_Wild_MorphCD[i] = 0.0

        set i = i + 1
    endloop

    // Initialize Test Mode Dialogs
    set udg_TM_MainDialog = DialogCreate()
    set udg_TM_SlotDialog = DialogCreate()

    call TriggerRegisterDialogEvent(tMainDialog, udg_TM_MainDialog)
    call TriggerAddAction(tMainDialog, function TM_OnMainDialogClicked)

    call TriggerRegisterDialogEvent(tSlotDialog, udg_TM_SlotDialog)
    call TriggerAddAction(tSlotDialog, function TM_OnSlotDialogClicked)

    // Initialize Strain Dialogs
    set udg_Strain_GeneDialog = DialogCreate()
    set udg_Strain_HeroDialog = DialogCreate()
    set udg_Strain_ReplaceDialog = DialogCreate()

    call TriggerRegisterDialogEvent(tGeneDialog, udg_Strain_GeneDialog)
    call TriggerAddAction(tGeneDialog, function Strain_OnGeneDialogClick)

    call TriggerRegisterDialogEvent(tHeroDialog, udg_Strain_HeroDialog)
    call TriggerAddAction(tHeroDialog, function Strain_OnHeroDialogClick)

    call TriggerRegisterDialogEvent(tReplaceDialog, udg_Strain_ReplaceDialog)
    call TriggerAddAction(tReplaceDialog, function Strain_OnReplaceDialogClick)

    // Initialize Wild Avatar Dialog & Groups
    set udg_Wild_MorphDialog = DialogCreate()
    call Wild_InitCreepTemplates()
    set udg_Wild_ArmyGroup = CreateGroup()
    set udg_Wild_ArmyTimer = CreateTimer()
    call TimerStart(udg_Wild_ArmyTimer, 2.00, true, function Wild_ArmyPushLoop)

    call TriggerRegisterDialogEvent(tWildDialog, udg_Wild_MorphDialog)
    call TriggerAddAction(tWildDialog, function Wild_OnMorphDialogClick)

    set i = 0
    loop
        exitwhen i > 7
        call TriggerRegisterPlayerChatEvent(tChat, Player(i), "-", false)
        set i = i + 1
    endloop
    call TriggerAddAction(tChat, function TM_OnChatCommand)

    call TriggerRegisterAnyUnitEventBJ(tAttack, EVENT_PLAYER_UNIT_ATTACKED)
    call TriggerAddCondition(tAttack, Condition(function DM_OnUnitAttacked))

    call TriggerRegisterAnyUnitEventBJ(tEffect, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(tEffect, Condition(function DM_OnSpellEffect))

    call TriggerRegisterAnyUnitEventBJ(tCast, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(tCast, Condition(function DM_OnSpellCast))

    call TriggerRegisterAnyUnitEventBJ(tDeath, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(tDeath, Condition(function DM_OnUnitDeath))

    call TriggerRegisterAnyUnitEventBJ(tRevive, EVENT_PLAYER_HERO_REVIVABLE)
    call TriggerAddCondition(tRevive, Condition(function DM_OnHeroRevivable))

    call TriggerRegisterAnyUnitEventBJ(tDamage, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(tDamage, Condition(function DM_OnDamaged))

    call TriggerRegisterAnyUnitEventBJ(tSkill, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(tSkill, Condition(function Ninja_OnHeroSkill))

    call TriggerRegisterAnyUnitEventBJ(tTrain, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(tTrain, Condition(function AI_OnUnitTrainFinish))

    call TriggerRegisterAnyUnitEventBJ(tLevel, EVENT_PLAYER_HERO_LEVEL)
    call TriggerAddCondition(tLevel, Condition(function AI_OnHeroLevel))

    call TimerStart(tmrCap, 1.0, true, function DM_CapTimerLoop)
    call TimerStart(tmrStealth, 0.05, true, function DM_StealthLoop)
    call TimerStart(tmrStart, 1.00, false, function TM_OnStartTimer)
    call TimerStart(tmrRefuge, 1.50, false, function Refuge_OnStartTimer)

    set tAttack = null
    set tEffect = null
    set tCast = null
    set tDeath = null
    set tDamage = null
    set tRevive = null
    set tSkill = null
    set tTrain = null
    set tLevel = null
    set tMainDialog = null
    set tSlotDialog = null
    set tChat = null
    set tGeneDialog = null
    set tHeroDialog = null
    set tReplaceDialog = null
    set tmrCap = null
    set tmrStealth = null
    set tmrStart = null
    set tmrRefuge = null
endfunction



function main takes nothing returns nothing
    call DM_InitTriggers()
    call SetCameraBounds( -9472.0 + GetCameraMargin(CAMERA_MARGIN_LEFT), -7680.0 + GetCameraMargin(CAMERA_MARGIN_BOTTOM), 9472.0 - GetCameraMargin(CAMERA_MARGIN_RIGHT), 7168.0 - GetCameraMargin(CAMERA_MARGIN_TOP), -9472.0 + GetCameraMargin(CAMERA_MARGIN_LEFT), 7168.0 - GetCameraMargin(CAMERA_MARGIN_TOP), 9472.0 - GetCameraMargin(CAMERA_MARGIN_RIGHT), -7680.0 + GetCameraMargin(CAMERA_MARGIN_BOTTOM) )
    call SetDayNightModels( "Environment\\DNC\\DNCLordaeron\\DNCLordaeronTerrain\\DNCLordaeronTerrain.mdl", "Environment\\DNC\\DNCLordaeron\\DNCLordaeronUnit\\DNCLordaeronUnit.mdl" )
    call NewSoundEnvironment( "Default" )
    call SetAmbientDaySound( "LordaeronSummerDay" )
    call SetAmbientNightSound( "LordaeronSummerNight" )
    call SetMapMusic( "Music", true, 0 )
    call CreateAllUnits(  )
    call InitBlizzard(  )
    call InitGlobals(  )
    call InitCustomTriggers(  )
    call RunInitializationTriggers(  )

endfunction

