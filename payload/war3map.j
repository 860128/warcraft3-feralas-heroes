//===========================================================================
//===========================================================================
// Ninja (魔音忍者) Core System
//===========================================================================

function Ninja_GetTrueHero takes player p returns unit
    local integer pId = GetPlayerId(p)
    local unit u = null
    local group g = null
    if udg_Ninja_TrueHero[pId] != null and GetUnitTypeId(udg_Ninja_TrueHero[pId]) == 'H003' then
        return udg_Ninja_TrueHero[pId]
    endif
    set g = CreateGroup()
    call GroupEnumUnitsOfPlayer(g, p, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if GetUnitTypeId(u) == 'H003' and not IsUnitInGroup(u, udg_FakeHeroGroup) and not IsUnitIllusion(u) then
            set udg_Ninja_TrueHero[pId] = u
            call DestroyGroup(g)
            set g = null
            return u
        endif
    endloop
    call DestroyGroup(g)
    set g = null
    return null
endfunction

function Ninja_SpawnClone takes player p, real x, real y, real facing returns unit
    local integer pId = GetPlayerId(p)
    local unit trueHero = Ninja_GetTrueHero(p)
    local real dur = 120.0
    local integer lv = 0
    local unit clone = null
    local integer itemSlot = 0
    local item itm = null

    if trueHero != null then
        set lv = GetUnitAbilityLevel(trueHero, 'A011')
    endif
    if lv <= 1 then
        set dur = 120.0
    elseif lv == 2 then
        set dur = 240.0
    else
        set dur = 600.0
    endif

    set clone = CreateUnit(p, 'u002', x, y, facing)
    call UnitAddType(clone, UNIT_TYPE_SUMMONED)

    if trueHero != null and lv > 0 then
        call UnitAddAbility(clone, 'A015')
        call SetUnitAbilityLevel(clone, 'A015', lv)
    endif

    if trueHero != null then
        set itemSlot = 0
        loop
            exitwhen itemSlot >= 6
            set itm = UnitItemInSlot(trueHero, itemSlot)
            if itm != null then
                call UnitAddItemById(clone, GetItemTypeId(itm))
            endif
            set itemSlot = itemSlot + 1
        endloop
        set itm = null
    endif

    call GroupAddUnit(udg_FakeHeroGroup, clone)
    if udg_Ninja_CloneGroup[pId] == null then
        set udg_Ninja_CloneGroup[pId] = CreateGroup()
    endif
    call GroupAddUnit(udg_Ninja_CloneGroup[pId], clone)

    call UnitApplyTimedLife(clone, 'BTLF', dur)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl", clone, "origin"))

    set trueHero = null
    return clone
endfunction

function Ninja_PickLivingClone takes integer pId returns unit
    local group g = udg_Ninja_CloneGroup[pId]
    local group tempG = null
    local unit u = null
    local unit pick = null

    if g == null then
        return null
    endif

    set tempG = CreateGroup()
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) and GetWidgetLife(u) > 0.405 then
            if pick == null then
                set pick = u
            endif
            call GroupAddUnit(tempG, u)
        endif
    endloop

    loop
        set u = FirstOfGroup(tempG)
        exitwhen u == null
        call GroupRemoveUnit(tempG, u)
        call GroupAddUnit(g, u)
    endloop

    call DestroyGroup(tempG)
    set tempG = null
    set g = null
    return pick
endfunction

function Ninja_FindKarmaIndex takes unit u returns integer
    local integer i = 0
    loop
        exitwhen i >= udg_KarmaCount
        if udg_KarmaUnit[i] == u then
            return i
        endif
        set i = i + 1
    endloop
    return -1
endfunction

function Ninja_RemoveKarmaIndex takes integer idx returns nothing
    if idx >= 0 and idx < udg_KarmaCount then
        if udg_KarmaFx[idx] != null then
            call DestroyEffect(udg_KarmaFx[idx])
            set udg_KarmaFx[idx] = null
        endif
        if udg_KarmaUnit[idx] != null then
            call SetUnitVertexColor(udg_KarmaUnit[idx], 255, 255, 255, 255)
        endif
        set udg_KarmaUnit[idx] = udg_KarmaUnit[udg_KarmaCount - 1]
        set udg_KarmaOwner[idx] = udg_KarmaOwner[udg_KarmaCount - 1]
        set udg_KarmaLevel[idx] = udg_KarmaLevel[udg_KarmaCount - 1]
        set udg_KarmaFx[idx] = udg_KarmaFx[udg_KarmaCount - 1]
        set udg_KarmaUnit[udg_KarmaCount - 1] = null
        set udg_KarmaOwner[udg_KarmaCount - 1] = null
        set udg_KarmaFx[udg_KarmaCount - 1] = null
        set udg_KarmaCount = udg_KarmaCount - 1
    endif
endfunction

function Ninja_MarkKarma takes unit killer, player ninjaOwner, integer lv returns nothing
    local integer idx = -1
    if killer == null or IsUnitType(killer, UNIT_TYPE_STRUCTURE) or GetUnitTypeId(killer) == 'u000' then
        return
    endif
    set idx = Ninja_FindKarmaIndex(killer)
    if idx >= 0 then
        set udg_KarmaOwner[idx] = ninjaOwner
        if lv > udg_KarmaLevel[idx] then
            set udg_KarmaLevel[idx] = lv
        endif
        if udg_KarmaFx[idx] == null then
            set udg_KarmaFx[idx] = AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Curse\\CurseTarget.mdl", killer, "overhead")
        endif
    else
        if udg_KarmaCount < 128 then
            set udg_KarmaUnit[udg_KarmaCount] = killer
            set udg_KarmaOwner[udg_KarmaCount] = ninjaOwner
            set udg_KarmaLevel[udg_KarmaCount] = lv
            set udg_KarmaFx[udg_KarmaCount] = AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Curse\\CurseTarget.mdl", killer, "overhead")
            set udg_KarmaCount = udg_KarmaCount + 1
        endif
    endif
    call SetUnitVertexColor(killer, 255, 140, 255, 255)
endfunction

function Ninja_OnHeroSkill takes nothing returns boolean
    local unit hero = GetTriggerUnit()
    local integer pId = 0
    local group g = null
    local unit u = null
    local integer qLv = 0
    if GetUnitTypeId(hero) == 'H003' then
        set pId = GetPlayerId(GetOwningPlayer(hero))
        if not IsUnitInGroup(hero, udg_FakeHeroGroup) and not IsUnitIllusion(hero) then
            set udg_Ninja_TrueHero[pId] = hero
        endif
        if GetLearnedSkill() == 'A012' and GetUnitAbilityLevel(hero, 'A012') == 1 then
            set udg_Ninja_AuraOn[pId] = true
            if udg_Ninja_AuraFx[pId] == null then
                set udg_Ninja_AuraFx[pId] = AddSpecialEffectTarget("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl", hero, "origin")
            endif
        endif
        if GetLearnedSkill() == 'A011' then
            set qLv = GetUnitAbilityLevel(hero, 'A011')
            if qLv > 0 and udg_Ninja_CloneGroup[pId] != null then
                set g = CreateGroup()
                call GroupAddGroup(udg_Ninja_CloneGroup[pId], g)
                loop
                    set u = FirstOfGroup(g)
                    exitwhen u == null
                    call GroupRemoveUnit(g, u)
                    if GetUnitTypeId(u) == 'u002' and not IsUnitType(u, UNIT_TYPE_DEAD) then
                        if GetUnitAbilityLevel(u, 'A015') == 0 then
                            call UnitAddAbility(u, 'A015')
                        endif
                        call SetUnitAbilityLevel(u, 'A015', qLv)
                    endif
                endloop
                call DestroyGroup(g)
                set g = null
            endif
        endif
    endif
    set hero = null
    return false
endfunction

// Dream Master (幻梦大师) v1.3 Core System
//===========================================================================

function DM_GetHeroIndex takes unit u returns integer
    local integer i = 0
    loop
        exitwhen i >= udg_DM_HeroCount
        if udg_DM_Hero[i] == u then
            return i
        endif
        set i = i + 1
    endloop
    if udg_DM_HeroCount < 32 then
        set udg_DM_Hero[udg_DM_HeroCount] = u
        set udg_DM_InStealth[udg_DM_HeroCount] = false
        set udg_DM_Backstab[udg_DM_HeroCount] = false
        set udg_DM_StealthDuration[udg_DM_HeroCount] = 0.0
        set udg_DM_HeroCount = udg_DM_HeroCount + 1
        return udg_DM_HeroCount - 1
    endif
    return -1
endfunction

function DM_FindCapIndex takes unit u returns integer
    local integer i = 0
    loop
        exitwhen i >= udg_CapCount
        if udg_CapUnit[i] == u then
            return i
        endif
        set i = i + 1
    endloop
    return -1
endfunction

function DM_RemoveCapIndex takes integer idx returns nothing
    if idx >= 0 and idx < udg_CapCount then
        set udg_CapUnit[idx] = udg_CapUnit[udg_CapCount - 1]
        set udg_CapOrigOwner[idx] = udg_CapOrigOwner[udg_CapCount - 1]
        set udg_CapDuration[idx] = udg_CapDuration[udg_CapCount - 1]
        set udg_CapUnit[udg_CapCount - 1] = null
        set udg_CapOrigOwner[udg_CapCount - 1] = null
        set udg_CapCount = udg_CapCount - 1
    endif
endfunction

function DM_BreakInvisibility takes unit hero, unit victim returns nothing
    local integer hIdx = DM_GetHeroIndex(hero)
    local integer lv = 1
    local boolean hasAgh = false
    local real dmg = 60.0

    if hIdx < 0 or not udg_DM_InStealth[hIdx] then
        return
    endif

    set udg_DM_InStealth[hIdx] = false
    call UnitRemoveBuffBJ('Binv', hero)
    call SetUnitVertexColor(hero, 255, 255, 255, 255)
    call SetUnitMoveSpeed(hero, 320.0)

    if victim != null and udg_DM_Backstab[hIdx] then
        set udg_DM_Backstab[hIdx] = false
        set lv = GetUnitAbilityLevel(hero, 'A001')
        set hasAgh = GetUnitAbilityLevel(hero, 'A004') > 0
        if lv == 2 then
            set dmg = 100.0
        elseif lv >= 3 then
            set dmg = 150.0
        endif
        if hasAgh then
            set dmg = dmg + 100.0
        endif

        call UnitDamageTarget(hero, victim, dmg, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_NORMAL, WEAPON_TYPE_WHOKNOWS)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WindWalk\\WindWalkTarget.mdl", victim, "chest"))
    endif
endfunction

function DM_StealthLoop takes nothing returns nothing
    local integer i = 0
    local unit u = null
    local player p = null
    local unit dummy = null
    local integer hIdx = -1
    local boolean hasAgh = false
    local integer lv = 1
    local real dur = 30.0

    // 1. Process pending stealth queue
    set i = 0
    loop
        exitwhen i >= udg_DM_StealthCount
        set udg_DM_StealthTimer[i] = udg_DM_StealthTimer[i] - 0.05
        if udg_DM_StealthTimer[i] <= 0.0 then
            set u = udg_DM_StealthUnit[i]
            set udg_DM_StealthUnit[i] = udg_DM_StealthUnit[udg_DM_StealthCount - 1]
            set udg_DM_StealthTimer[i] = udg_DM_StealthTimer[udg_DM_StealthCount - 1]
            set udg_DM_StealthUnit[udg_DM_StealthCount - 1] = null
            set udg_DM_StealthCount = udg_DM_StealthCount - 1
            set i = i - 1

            if u != null and not IsUnitType(u, UNIT_TYPE_DEAD) then
                set p = GetOwningPlayer(u)
                set dummy = CreateUnit(p, 'u000', GetUnitX(u), GetUnitY(u), 0.0)
                call UnitAddAbility(dummy, 'A00V')
                call IssueTargetOrder(dummy, "invisibility", u)
                call UnitApplyTimedLife(dummy, 'BTLF', 1.0)
                set dummy = null
                set p = null

                call SetUnitVertexColor(u, 130, 150, 255, 120)
                call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\WindWalk\\WindWalkTarget.mdl", u, "origin"))

                set hIdx = DM_GetHeroIndex(u)
                set hasAgh = GetUnitAbilityLevel(u, 'A004') > 0
                set lv = GetUnitAbilityLevel(u, 'A001')
                set dur = 30.0 + I2R(lv) * 5.0

                if hasAgh then
                    call SetUnitMoveSpeed(u, 522.0)
                else
                    call SetUnitMoveSpeed(u, 400.0)
                endif

                if hIdx >= 0 then
                    set udg_DM_InStealth[hIdx] = true
                    set udg_DM_Backstab[hIdx] = true
                    set udg_DM_StealthDuration[hIdx] = dur
                endif
            endif
            set u = null
        endif
        set i = i + 1
    endloop

    // 2. Check active stealth duration
    set i = 0
    loop
        exitwhen i >= udg_DM_HeroCount
        if udg_DM_InStealth[i] then
            set udg_DM_StealthDuration[i] = udg_DM_StealthDuration[i] - 0.05
            if udg_DM_StealthDuration[i] <= 0.0 or IsUnitType(udg_DM_Hero[i], UNIT_TYPE_DEAD) then
                call DM_BreakInvisibility(udg_DM_Hero[i], null)
            endif
        endif
        set i = i + 1
    endloop

    // 3. Process Ninja pending heal
    set i = 0
    loop
        exitwhen i >= udg_Ninja_PendingCount
        if udg_Ninja_PendingHealUnit[i] != null and not IsUnitType(udg_Ninja_PendingHealUnit[i], UNIT_TYPE_DEAD) then
            call SetWidgetLife(udg_Ninja_PendingHealUnit[i], udg_Ninja_PendingHealHP[i])
        endif
        set udg_Ninja_PendingHealUnit[i] = null
        set i = i + 1
    endloop
    set udg_Ninja_PendingCount = 0
endfunction

function AI_GetPlayerAltar takes player p returns unit
    local group g = CreateGroup()
    local unit u = null
    local unit altar = null
    local integer uId = 0
    call GroupEnumUnitsOfPlayer(g, p, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        set uId = GetUnitTypeId(u)
        if (uId == 'halt' or uId == 'oalt' or uId == 'uaod' or uId == 'eate') and not IsUnitType(u, UNIT_TYPE_DEAD) and GetWidgetLife(u) > 0.405 then
            set altar = u
            call GroupClear(g)
        endif
    endloop
    call DestroyGroup(g)
    set g = null
    set u = null
    return altar
endfunction

function AI_GetPlayerTownHall takes player p returns unit
    local group g = CreateGroup()
    local unit u = null
    local unit th = null
    local integer uId = 0
    call GroupEnumUnitsOfPlayer(g, p, null)
    loop
        set u = FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        set uId = GetUnitTypeId(u)
        if (uId == 'htow' or uId == 'hkee' or uId == 'hcas' or uId == 'ogre' or uId == 'ostr' or uId == 'ofrt' or uId == 'unpl' or uId == 'unp1' or uId == 'unp2' or uId == 'etol' or uId == 'etoa' or uId == 'etot') and not IsUnitType(u, UNIT_TYPE_DEAD) and GetWidgetLife(u) > 0.405 then
            set th = u
            call GroupClear(g)
        endif
    endloop
    call DestroyGroup(g)
    set g = null
    set u = null
    return th
endfunction

function AI_AutoLearnSkills takes unit h returns nothing
    local integer pts = 0
    local integer prevPts = 0
    local integer uId = 0
    if h == null or IsUnitType(h, UNIT_TYPE_DEAD) then
        return
    endif
    set uId = GetUnitTypeId(h)
    set pts = GetHeroSkillPoints(h)
    if pts <= 0 then
        return
    endif

    if uId == 'H002' then
        loop
            exitwhen pts <= 0
            set prevPts = pts
            call SelectHeroSkill(h, 'A004')
            if GetHeroSkillPoints(h) == prevPts then
                call SelectHeroSkill(h, 'A003')
            endif
            if GetHeroSkillPoints(h) == prevPts then
                call SelectHeroSkill(h, 'A001')
            endif
            if GetHeroSkillPoints(h) == prevPts then
                call SelectHeroSkill(h, 'A002')
            endif
            if GetHeroSkillPoints(h) == prevPts then
                call SelectHeroSkill(h, 'Aamk')
            endif
            set pts = GetHeroSkillPoints(h)
            if pts == prevPts then
                exitwhen true
            endif
        endloop
    elseif uId == 'H003' then
        loop
            exitwhen pts <= 0
            set prevPts = pts
            call SelectHeroSkill(h, 'A014')
            if GetHeroSkillPoints(h) == prevPts then
                call SelectHeroSkill(h, 'A011')
            endif
            if GetHeroSkillPoints(h) == prevPts then
                call SelectHeroSkill(h, 'A013')
            endif
            if GetHeroSkillPoints(h) == prevPts then
                call SelectHeroSkill(h, 'A012')
            endif
            if GetHeroSkillPoints(h) == prevPts then
                call SelectHeroSkill(h, 'Aamk')
            endif
            set pts = GetHeroSkillPoints(h)
            if pts == prevPts then
                exitwhen true
            endif
        endloop
    endif
endfunction

function AI_SpawnCustomHeroForPlayer takes integer pId, real x, real y, real facing returns unit
    local integer hTypeId = 'H002'
    local unit h = null
    if udg_AI_HeroMode[pId] == 2 then
        set hTypeId = 'H003'
    endif
    set h = CreateUnit(Player(pId), hTypeId, x, y, facing)
    set udg_AI_CustomHero[pId] = h
    set udg_AI_HeroSpawned[pId] = true
    set udg_AI_DeadTimer[pId] = 0.0
    set udg_AI_AltarTimer[pId] = 0.0
    set udg_AI_WaitTimer[pId] = 0.0
    set udg_AI_CastCD_Q[pId] = 0.0
    set udg_AI_CastCD_W[pId] = 0.0
    set udg_AI_CastCD_E[pId] = 0.0
    set udg_AI_CastCD_R[pId] = 0.0

    call UnitAddItemById(h, 'stwp')

    if hTypeId == 'H003' then
        set udg_Ninja_TrueHero[pId] = h
    endif

    call AI_AutoLearnSkills(h)

    call SetPlayerTechMaxAllowed(Player(pId), 'H002', 1)
    call SetPlayerTechMaxAllowed(Player(pId), 'H003', 1)

    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", h, "origin"))

    return h
endfunction

function AI_TacticalLoop takes nothing returns nothing
    local integer i = 0
    local unit h = null
    local integer hTypeId = 0
    local real hx = 0.0
    local real hy = 0.0
    local integer enemyCount = 0
    local unit bestEnemy = null
    local boolean bestIsHero = false
    local real bestLife = 0.0
    local unit clusterEnemy = null
    local unit nearestEnemy = null
    local real minD = 99999999.0
    local real dx = 0.0
    local real dy = 0.0
    local real d = 0.0
    local unit enumU = null
    local group g = null
    local unit altar = null
    local unit th = null
    local integer curOrder = 0

    set i = 0
    loop
        exitwhen i > 7
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
            if udg_AI_HeroMode[i] > 0 then
                // Decrement Cooldowns
                if udg_AI_CastCD_Q[i] > 0.0 then
                    set udg_AI_CastCD_Q[i] = udg_AI_CastCD_Q[i] - 1.0
                endif
                if udg_AI_CastCD_W[i] > 0.0 then
                    set udg_AI_CastCD_W[i] = udg_AI_CastCD_W[i] - 1.0
                endif
                if udg_AI_CastCD_E[i] > 0.0 then
                    set udg_AI_CastCD_E[i] = udg_AI_CastCD_E[i] - 1.0
                endif
                if udg_AI_CastCD_R[i] > 0.0 then
                    set udg_AI_CastCD_R[i] = udg_AI_CastCD_R[i] - 1.0
                endif

                // 1. Check if custom hero needs to be spawned / replaced
                if not udg_AI_HeroSpawned[i] then
                    // Case 1: Check if standard hero exists to replace
                    set g = CreateGroup()
                    call GroupEnumUnitsOfPlayer(g, Player(i), null)
                    loop
                        set enumU = FirstOfGroup(g)
                        exitwhen enumU == null
                        call GroupRemoveUnit(g, enumU)
                        if IsUnitType(enumU, UNIT_TYPE_HERO) and GetUnitTypeId(enumU) != 'H002' and GetUnitTypeId(enumU) != 'H003' and not IsUnitIllusion(enumU) and not IsUnitInGroup(enumU, udg_FakeHeroGroup) then
                            set hx = GetUnitX(enumU)
                            set hy = GetUnitY(enumU)
                            set d = GetUnitFacing(enumU)
                            call RemoveUnit(enumU)
                            call AI_SpawnCustomHeroForPlayer(i, hx, hy, d)
                            call GroupClear(g)
                        endif
                    endloop
                    call DestroyGroup(g)
                    set g = null

                    // Case 2: Check altar or townhall timing fallback
                    if not udg_AI_HeroSpawned[i] then
                        set altar = AI_GetPlayerAltar(Player(i))
                        if altar != null then
                            set udg_AI_AltarTimer[i] = udg_AI_AltarTimer[i] + 1.0
                            if udg_AI_AltarTimer[i] >= 20.0 then
                                call AI_SpawnCustomHeroForPlayer(i, GetUnitX(altar), GetUnitY(altar) - 150.0, 270.0)
                            endif
                        else
                            set udg_AI_WaitTimer[i] = udg_AI_WaitTimer[i] + 1.0
                            if udg_AI_WaitTimer[i] >= 60.0 then
                                set th = AI_GetPlayerTownHall(Player(i))
                                if th != null then
                                    call AI_SpawnCustomHeroForPlayer(i, GetUnitX(th) + 150.0, GetUnitY(th), 270.0)
                                else
                                    call AI_SpawnCustomHeroForPlayer(i, GetStartLocationX(GetPlayerStartLocation(Player(i))), GetStartLocationY(GetPlayerStartLocation(Player(i))), 270.0)
                                endif
                                set th = null
                            endif
                        endif
                        set altar = null
                    endif
                endif

                // 2. Check Auto-Revive for dead custom hero
                set h = udg_AI_CustomHero[i]
                if h != null and IsUnitType(h, UNIT_TYPE_DEAD) then
                    set altar = AI_GetPlayerAltar(Player(i))
                    if altar != null then
                        set udg_AI_DeadTimer[i] = udg_AI_DeadTimer[i] + 1.0
                        if udg_AI_DeadTimer[i] < 25.0 then
                            call IssueImmediateOrderById(altar, GetUnitTypeId(h))
                            call IssueNeutralImmediateOrderById(Player(i), altar, GetUnitTypeId(h))
                        else
                            call ReviveHero(h, GetUnitX(altar), GetUnitY(altar) - 150.0, true)
                            set udg_AI_DeadTimer[i] = 0.0
                            call AI_AutoLearnSkills(h)
                            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl", h, "origin"))
                        endif
                    endif
                    set altar = null
                else
                    set udg_AI_DeadTimer[i] = 0.0
                endif

                // 3. Tactical Brain for living custom hero
                if h != null and not IsUnitType(h, UNIT_TYPE_DEAD) and GetWidgetLife(h) > 0.405 then
                    set hx = GetUnitX(h)
                    set hy = GetUnitY(h)
                    set hTypeId = GetUnitTypeId(h)

                    // Auto-learn skills
                    call AI_AutoLearnSkills(h)

                    // Scan 900.0 range for enemies
                    set enemyCount = 0
                    set bestEnemy = null
                    set bestIsHero = false
                    set bestLife = 0.0
                    set clusterEnemy = null
                    set nearestEnemy = null
                    set minD = 99999999.0

                    call GroupClear(udg_EnumGroup)
                    call GroupEnumUnitsInRange(udg_EnumGroup, hx, hy, 900.0, null)
                    loop
                        set enumU = FirstOfGroup(udg_EnumGroup)
                        exitwhen enumU == null
                        call GroupRemoveUnit(udg_EnumGroup, enumU)
                        if IsUnitEnemy(enumU, Player(i)) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and GetWidgetLife(enumU) > 0.405 and GetUnitTypeId(enumU) != 'u000' then
                            set dx = GetUnitX(enumU) - hx
                            set dy = GetUnitY(enumU) - hy
                            set d = dx * dx + dy * dy
                            if nearestEnemy == null or d < minD then
                                set nearestEnemy = enumU
                                set minD = d
                            endif

                            if not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) then
                                set enemyCount = enemyCount + 1
                                if clusterEnemy == null then
                                    set clusterEnemy = enumU
                                endif

                                if IsUnitType(enumU, UNIT_TYPE_HERO) then
                                    if not bestIsHero or GetWidgetLife(enumU) > bestLife then
                                        set bestEnemy = enumU
                                        set bestIsHero = true
                                        set bestLife = GetWidgetLife(enumU)
                                    endif
                                elseif not bestIsHero then
                                    if bestEnemy == null or GetWidgetLife(enumU) > bestLife then
                                        set bestEnemy = enumU
                                        set bestLife = GetWidgetLife(enumU)
                                    endif
                                endif
                            endif
                        endif
                    endloop

                    // Tactical decision tree based on Hero Type
                    if hTypeId == 'H002' then
                        // 幻梦大师 Tactical Brain
                        // Cast E: A003 万象皆虚
                        if GetUnitAbilityLevel(h, 'A003') > 0 and udg_AI_CastCD_E[i] <= 0.0 and GetUnitState(h, UNIT_STATE_MANA) >= 120.0 and enemyCount >= 2 and clusterEnemy != null then
                            call IssuePointOrder(h, "blizzard", GetUnitX(clusterEnemy), GetUnitY(clusterEnemy))
                            set udg_AI_CastCD_E[i] = 30.0
                        // Cast W: A002 幻梦奴役
                        elseif GetUnitAbilityLevel(h, 'A002') > 0 and udg_AI_CastCD_W[i] <= 0.0 and GetUnitState(h, UNIT_STATE_MANA) >= 100.0 and bestEnemy != null then
                            call IssueTargetOrder(h, "charm", bestEnemy)
                            set udg_AI_CastCD_W[i] = 25.0
                        // Cast Q: A001 镜像与潜行
                        elseif GetUnitAbilityLevel(h, 'A001') > 0 and udg_AI_CastCD_Q[i] <= 0.0 and GetUnitState(h, UNIT_STATE_MANA) >= 100.0 and (enemyCount >= 1 or GetWidgetLife(h) < GetUnitState(h, UNIT_STATE_MAX_LIFE) * 0.75) then
                            call IssueImmediateOrder(h, "mirrorimage")
                            set udg_AI_CastCD_Q[i] = 16.0
                        endif

                        // Command nearby clones to fight
                        if nearestEnemy != null then
                            call GroupClear(udg_EnumGroup)
                            call GroupEnumUnitsInRange(udg_EnumGroup, hx, hy, 1000.0, null)
                            loop
                                set enumU = FirstOfGroup(udg_EnumGroup)
                                exitwhen enumU == null
                                call GroupRemoveUnit(udg_EnumGroup, enumU)
                                if GetOwningPlayer(enumU) == Player(i) and enumU != h and not IsUnitType(enumU, UNIT_TYPE_DEAD) and GetWidgetLife(enumU) > 0.405 then
                                    if IsUnitType(enumU, UNIT_TYPE_SUMMONED) or IsUnitIllusion(enumU) or IsUnitInGroup(enumU, udg_FakeHeroGroup) then
                                        set curOrder = GetUnitCurrentOrder(enumU)
                                        if curOrder == 0 or curOrder == 851972 or curOrder == 851973 then
                                            call IssuePointOrder(enumU, "attack", GetUnitX(nearestEnemy), GetUnitY(nearestEnemy))
                                        endif
                                    endif
                                endif
                            endloop
                        endif

                    elseif hTypeId == 'H003' then
                        // 魔音忍者 Tactical Brain
                        // Ensure Aura is on once A012 is learned
                        if GetUnitAbilityLevel(h, 'A012') > 0 and not udg_Ninja_AuraOn[i] then
                            set udg_Ninja_AuraOn[i] = true
                            if udg_Ninja_AuraFx[i] == null then
                                set udg_Ninja_AuraFx[i] = AddSpecialEffectTarget("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl", h, "origin")
                            endif
                        endif

                        // Cast R: A014 独断万古
                        if GetUnitAbilityLevel(h, 'A014') > 0 and udg_AI_CastCD_R[i] <= 0.0 and GetUnitState(h, UNIT_STATE_MANA) >= 120.0 and enemyCount >= 1 then
                            call IssueImmediateOrder(h, "summongrizzly")
                            set udg_AI_CastCD_R[i] = 60.0
                        endif

                        // Command nearby ninja clones to fight
                        if nearestEnemy != null then
                            call GroupClear(udg_EnumGroup)
                            call GroupEnumUnitsInRange(udg_EnumGroup, hx, hy, 1000.0, null)
                            loop
                                set enumU = FirstOfGroup(udg_EnumGroup)
                                exitwhen enumU == null
                                call GroupRemoveUnit(udg_EnumGroup, enumU)
                                if GetOwningPlayer(enumU) == Player(i) and enumU != h and not IsUnitType(enumU, UNIT_TYPE_DEAD) and GetWidgetLife(enumU) > 0.405 then
                                    if GetUnitTypeId(enumU) == 'u002' or GetUnitTypeId(enumU) == 'u001' or IsUnitType(enumU, UNIT_TYPE_SUMMONED) then
                                        set curOrder = GetUnitCurrentOrder(enumU)
                                        if curOrder == 0 or curOrder == 851972 or curOrder == 851973 then
                                            call IssuePointOrder(enumU, "attack", GetUnitX(nearestEnemy), GetUnitY(nearestEnemy))
                                        endif
                                    endif
                                endif
                            endloop
                        endif
                    endif

                    set h = null
                    set bestEnemy = null
                    set clusterEnemy = null
                    set nearestEnemy = null
                endif
            endif
        endif
        set i = i + 1
    endloop
endfunction

function DM_CapTimerLoop takes nothing returns nothing
    local integer i = 0
    local unit u = null
    local integer pId = 0
    local unit th = null
    local unit dmgSrc = null
    local integer aLv = 0
    local real pct = 0.0
    local real drain = 0.0
    local unit enumU = null
    local integer kLv = 0
    local player ko = null

    // 1. Process Dream Master possession duration
    loop
        exitwhen i >= udg_CapCount
        set udg_CapDuration[i] = udg_CapDuration[i] - 1.0
        set u = udg_CapUnit[i]
        if u == null or IsUnitType(u, UNIT_TYPE_DEAD) then
            if u != null and udg_CapOrigOwner[i] != null then
                call SetUnitOwner(u, udg_CapOrigOwner[i], true)
            endif
            call DM_RemoveCapIndex(i)
            set i = i - 1
        elseif udg_CapDuration[i] <= 0.0 then
            call SetUnitOwner(u, udg_CapOrigOwner[i], true)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\DispelMagic\\DispelMagicTarget.mdl", u, "origin"))
            call DM_RemoveCapIndex(i)
            set i = i - 1
        endif
        set u = null
        set i = i + 1
    endloop

    // 2. Process Ninja Aura (A012)
    set pId = 0
    loop
        exitwhen pId > 7
        set th = udg_Ninja_TrueHero[pId]
        if th != null and udg_Ninja_AuraOn[pId] then
            set dmgSrc = null
            if not IsUnitType(th, UNIT_TYPE_DEAD) then
                set dmgSrc = th
            else
                set dmgSrc = Ninja_PickLivingClone(pId)
            endif
            if dmgSrc != null then
                set aLv = GetUnitAbilityLevel(th, 'A012')
                if aLv > 0 then
                    set pct = 0.01 * I2R(aLv)
                    call GroupClear(udg_EnumGroup)
                    call GroupEnumUnitsInRect(udg_EnumGroup, bj_mapInitialPlayableArea, null)
                    loop
                        set enumU = FirstOfGroup(udg_EnumGroup)
                        exitwhen enumU == null
                        call GroupRemoveUnit(udg_EnumGroup, enumU)
                        if IsUnitEnemy(enumU, Player(pId)) and not IsUnitType(enumU, UNIT_TYPE_DEAD) and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(enumU) != 'u000' then
                            set drain = GetUnitState(enumU, UNIT_STATE_MAX_LIFE) * pct
                            if GetWidgetLife(enumU) > (drain + 1.0) then
                                call SetWidgetLife(enumU, GetWidgetLife(enumU) - drain)
                            else
                                call UnitDamageTarget(dmgSrc, enumU, drain + 100.0, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL, WEAPON_TYPE_WHOKNOWS)
                            endif
                        endif
                    endloop
                endif
            endif
        endif
        set pId = pId + 1
    endloop

    // 3. Process Karma Curse Drain (A013 Lv2 & Lv3)
    set i = 0
    loop
        exitwhen i >= udg_KarmaCount
        set u = udg_KarmaUnit[i]
        if u == null or IsUnitType(u, UNIT_TYPE_DEAD) or GetWidgetLife(u) <= 0.405 then
            call Ninja_RemoveKarmaIndex(i)
            set i = i - 1
        else
            set kLv = udg_KarmaLevel[i]
            if kLv >= 2 then
                if kLv == 2 then
                    set pct = 0.01
                else
                    set pct = 0.02
                endif
                set drain = GetUnitState(u, UNIT_STATE_MAX_LIFE) * pct
                if GetWidgetLife(u) > (drain + 1.0) then
                    call SetWidgetLife(u, GetWidgetLife(u) - drain)
                else
                    set ko = udg_KarmaOwner[i]
                    set dmgSrc = Ninja_GetTrueHero(ko)
                    if dmgSrc == null or IsUnitType(dmgSrc, UNIT_TYPE_DEAD) then
                        set dmgSrc = Ninja_PickLivingClone(GetPlayerId(ko))
                    endif
                    if dmgSrc == null then
                        set dmgSrc = u
                    endif
                    call UnitDamageTarget(dmgSrc, u, drain + 100.0, true, false, ATTACK_TYPE_HERO, DAMAGE_TYPE_UNIVERSAL, WEAPON_TYPE_WHOKNOWS)
                    if i < udg_KarmaCount and udg_KarmaUnit[i] != u then
                        set i = i - 1
                    endif
                endif
            endif
        endif
        set u = null
        set i = i + 1
    endloop

    // 4. Custom Hero AI Tactical Loop
    call AI_TacticalLoop()
endfunction

function DM_CloneOneUnit takes unit caster, unit orig, real tx, real ty returns nothing
    local player p = GetOwningPlayer(caster)
    local integer uId = GetUnitTypeId(orig)
    local unit clone = null
    local unit dummy = null
    local boolean hasAgh = GetUnitAbilityLevel(caster, 'A004') > 0
    local boolean success = false
    local integer itemSlot = 0
    local item itm = null

    if IsUnitType(orig, UNIT_TYPE_HERO) or IsHeroUnitId(uId) then
        // Hero target (Real Hero OR Fake Hero/Hero Illusion):
        // First try to create an engine-native Hero Illusion via Wand of Illusion (852274)
        set dummy = CreateUnit(p, 'u000', GetUnitX(orig), GetUnitY(orig), 0.0)
        if hasAgh then
            call UnitAddAbility(dummy, 'A00J')
        else
            call UnitAddAbility(dummy, 'A00I')
        endif
        set success = IssueTargetOrderById(dummy, 852274, orig)
        call UnitApplyTimedLife(dummy, 'BTLF', 2.0)
        set dummy = null

        if not success then
            // If the native Wand of Illusion rejected targeting an existing illusion,
            // create clone with full active skills, matching level & items,
            // but completely stripped of hero properties (no altar revival, no XP gain, no hero icon):
            set clone = CreateUnit(p, uId, tx, ty, GetUnitFacing(orig))
            call UnitRemoveType(clone, UNIT_TYPE_HERO)
            call UnitAddType(clone, UNIT_TYPE_SUMMONED)
            call SuspendHeroXP(clone, true)
            call SetHeroLevel(clone, GetHeroLevel(orig), false)
            set itemSlot = 0
            loop
                exitwhen itemSlot >= 6
                set itm = UnitItemInSlot(orig, itemSlot)
                if itm != null then
                    call UnitAddItemById(clone, GetItemTypeId(itm))
                endif
                set itemSlot = itemSlot + 1
            endloop
            set itm = null
            call GroupAddUnit(udg_FakeHeroGroup, clone)
            call UnitApplyTimedLife(clone, 'BTLF', 900.0)
            call SetUnitVertexColor(clone, 100, 150, 255, 180)
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl", clone, "origin"))
            if GetPlayerController(p) == MAP_CONTROL_COMPUTER then
                call IssuePointOrder(clone, "attack", GetUnitX(orig), GetUnitY(orig))
            endif
            set clone = null
        else
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl", orig, "origin"))
        endif
    else
        // Non-hero target (includes Peasants, Peons, Wisps, Acolytes, Creeps, Spellcasters):
        // Clone with full active skills, 15-minute duration, blue illusion tint
        set clone = CreateUnit(p, uId, tx, ty, GetUnitFacing(orig))
        call UnitAddType(clone, UNIT_TYPE_SUMMONED)
        call UnitApplyTimedLife(clone, 'BTLF', 900.0)
        call SetUnitVertexColor(clone, 100, 150, 255, 180)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl", clone, "origin"))
        if GetPlayerController(p) == MAP_CONTROL_COMPUTER then
            call IssuePointOrder(clone, "attack", GetUnitX(orig), GetUnitY(orig))
        endif
        set clone = null
    endif

    set p = null
endfunction

function DM_CastMassIllusion takes unit caster, real targetX, real targetY returns nothing
    local integer lv = GetUnitAbilityLevel(caster, 'A003')
    local boolean hasAgh = GetUnitAbilityLevel(caster, 'A004') > 0
    local real radius = 250.0
    local unit enumU = null
    local real ox = 0.0
    local real oy = 0.0
    local real spawnX = 0.0
    local real spawnY = 0.0

    if lv == 2 then
        set radius = 350.0
    elseif lv >= 3 then
        set radius = 450.0
    endif
    if hasAgh then
        set radius = radius + 100.0
    endif

    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl", targetX, targetY))

    call GroupClear(udg_EnumGroup)
    call GroupEnumUnitsInRange(udg_EnumGroup, targetX, targetY, radius, null)

    loop
        set enumU = FirstOfGroup(udg_EnumGroup)
        exitwhen enumU == null
        call GroupRemoveUnit(udg_EnumGroup, enumU)

        // Copy ALL living non-structure units (including peasants, wisps, peons, acolytes, creeps, heroes)
        if not IsUnitType(enumU, UNIT_TYPE_DEAD) and not IsUnitType(enumU, UNIT_TYPE_STRUCTURE) and GetUnitTypeId(enumU) != 'u000' then
            set ox = GetUnitX(enumU)
            set oy = GetUnitY(enumU)
            set spawnX = ox + 40.0
            set spawnY = oy + 40.0
            call DM_CloneOneUnit(caster, enumU, spawnX, spawnY)
        endif
    endloop
endfunction

function DM_CastPossession takes unit caster, unit target returns nothing
    local integer lv = GetUnitAbilityLevel(caster, 'A002')
    local player casterPlayer = GetOwningPlayer(caster)
    local player origPlayer = GetOwningPlayer(target)
    local real dur = 30.0
    local integer idx = 0
    local boolean hasAgh = GetUnitAbilityLevel(caster, 'A004') > 0

    if target == null or origPlayer == casterPlayer then
        return
    endif

    if lv == 2 then
        set dur = 120.0
    elseif lv >= 3 then
        if hasAgh then
            set dur = 999999.0
        else
            set dur = 600.0
        endif
    endif

    set idx = DM_FindCapIndex(target)
    if idx >= 0 then
        set udg_CapDuration[idx] = dur
    else
        if udg_CapCount < 128 then
            set udg_CapUnit[udg_CapCount] = target
            set udg_CapOrigOwner[udg_CapCount] = origPlayer
            set udg_CapDuration[udg_CapCount] = dur
            set udg_CapCount = udg_CapCount + 1
        endif
    endif

    call SetUnitOwner(target, casterPlayer, true)
    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Possession\\PossessionTarget.mdl", target, "chest"))

    set casterPlayer = null
    set origPlayer = null
endfunction

function DM_OnCastMirror takes unit caster returns nothing
    if udg_DM_StealthCount < 32 then
        set udg_DM_StealthUnit[udg_DM_StealthCount] = caster
        set udg_DM_StealthTimer[udg_DM_StealthCount] = 0.40
        set udg_DM_StealthCount = udg_DM_StealthCount + 1
    endif
endfunction

function DM_OnSpellEffect takes nothing returns boolean
    local unit caster = GetTriggerUnit()
    local integer abil = GetSpellAbilityId()
    local integer pId = 0
    local unit ult = null

    if abil == 'A001' then
        call DM_OnCastMirror(caster)
    elseif abil == 'A002' then
        call DM_CastPossession(caster, GetSpellTargetUnit())
    elseif abil == 'A003' then
        call DM_CastMassIllusion(caster, GetSpellTargetX(), GetSpellTargetY())
    elseif abil == 'A012' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set udg_Ninja_TrueHero[pId] = Ninja_GetTrueHero(GetOwningPlayer(caster))
        set udg_Ninja_AuraOn[pId] = not udg_Ninja_AuraOn[pId]
        if udg_Ninja_AuraOn[pId] then
            if udg_Ninja_AuraFx[pId] == null then
                set udg_Ninja_AuraFx[pId] = AddSpecialEffectTarget("Abilities\\Spells\\Other\\GeneralAuraTarget\\GeneralAuraTarget.mdl", caster, "origin")
            endif
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl", caster, "origin"))
        else
            if udg_Ninja_AuraFx[pId] != null then
                call DestroyEffect(udg_Ninja_AuraFx[pId])
                set udg_Ninja_AuraFx[pId] = null
            endif
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl", caster, "origin"))
        endif
    elseif abil == 'A014' then
        set pId = GetPlayerId(GetOwningPlayer(caster))
        set ult = CreateUnit(GetOwningPlayer(caster), 'u001', GetUnitX(caster) + 70.0, GetUnitY(caster) + 70.0, GetUnitFacing(caster))
        call UnitAddType(ult, UNIT_TYPE_SUMMONED)
        call UnitApplyTimedLife(ult, 'BTLF', 180.0)
        if udg_Ninja_CloneGroup[pId] == null then
            set udg_Ninja_CloneGroup[pId] = CreateGroup()
        endif
        call GroupAddUnit(udg_Ninja_CloneGroup[pId], ult)
        call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Vengeance\\VengeanceAvenger.mdl", ult, "origin"))
        call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Human\\Thunderclap\\ThunderClapCaster.mdl", GetUnitX(ult), GetUnitY(ult)))
        set ult = null
    endif

    set caster = null
    return false
endfunction

function DM_OnSpellCast takes nothing returns boolean
    local unit caster = GetTriggerUnit()
    local integer hIdx = DM_GetHeroIndex(caster)
    if hIdx >= 0 and udg_DM_InStealth[hIdx] then
        if GetSpellAbilityId() != 'A001' then
            call DM_BreakInvisibility(caster, null)
        endif
    endif
    set caster = null
    return false
endfunction

function DM_OnDamaged takes nothing returns boolean
    local unit src = GetEventDamageSource()
    local unit tgt = GetTriggerUnit()
    local integer hIdx = -1
    local integer pId = 0
    local unit c = null
    local real oldX = 0.0
    local real oldY = 0.0
    local real nx = 0.0
    local real ny = 0.0
    local real nf = 0.0
    local real nhp = 0.0
    local real maxHP = 0.0
    local integer qLv = 0

    if src != null and tgt != null and GetEventDamage() > 0.0 then
        set hIdx = DM_GetHeroIndex(src)
        if hIdx >= 0 and udg_DM_InStealth[hIdx] then
            call DM_BreakInvisibility(src, tgt)
        endif

        // 魔音同化 (A011) - 真身不死转移 (Pre-lethal swap)
        if GetUnitTypeId(tgt) == 'H003' and not IsUnitInGroup(tgt, udg_FakeHeroGroup) and not IsUnitIllusion(tgt) then
            set pId = GetPlayerId(GetOwningPlayer(tgt))
            set udg_Ninja_TrueHero[pId] = tgt
            if GetEventDamage() >= (GetWidgetLife(tgt) - 1.0) then
                set c = Ninja_PickLivingClone(pId)
                if c != null then
                    // 他化自在 (A013) 记录凶手
                    if GetUnitAbilityLevel(tgt, 'A013') > 0 and src != null then
                        call Ninja_MarkKarma(src, GetOwningPlayer(tgt), GetUnitAbilityLevel(tgt, 'A013'))
                    endif

                    set oldX = GetUnitX(tgt)
                    set oldY = GetUnitY(tgt)
                    set nx = GetUnitX(c)
                    set ny = GetUnitY(c)
                    set nf = GetUnitFacing(c)
                    set nhp = GetWidgetLife(c)

                    call GroupRemoveUnit(udg_Ninja_CloneGroup[pId], c)
                    call GroupRemoveUnit(udg_FakeHeroGroup, c)
                    call RemoveUnit(c)
                    set c = null

                    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageDeathCaster.mdl", oldX, oldY))
                    call DestroyEffect(AddSpecialEffect("Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl", oldX, oldY))

                    set maxHP = GetUnitState(tgt, UNIT_STATE_MAX_LIFE)
                    set qLv = GetUnitAbilityLevel(tgt, 'A011')
                    if qLv == 2 and nhp < (maxHP * 0.30) then
                        set nhp = maxHP * 0.30
                    elseif qLv >= 3 and nhp < (maxHP * 0.50) then
                        set nhp = maxHP * 0.50
                    endif

                    call SetWidgetLife(tgt, maxHP)
                    if udg_Ninja_PendingCount < 32 then
                        set udg_Ninja_PendingHealUnit[udg_Ninja_PendingCount] = tgt
                        set udg_Ninja_PendingHealHP[udg_Ninja_PendingCount] = RMaxBJ(nhp, maxHP * 0.35)
                        set udg_Ninja_PendingCount = udg_Ninja_PendingCount + 1
                    endif

                    call SetUnitX(tgt, nx)
                    call SetUnitY(tgt, ny)
                    call SetUnitFacing(tgt, nf)
                    call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl", tgt, "origin"))
                endif
            endif
        endif
    endif

    set src = null
    set tgt = null
    return false
endfunction

function DM_OnHeroRevivable takes nothing returns boolean
    local unit rev = GetRevivableUnit()
    if rev != null and (IsUnitInGroup(rev, udg_FakeHeroGroup) or IsUnitIllusion(rev)) then
        call RemoveUnit(rev)
    endif
    set rev = null
    return false
endfunction

function DM_OnUnitDeath takes nothing returns boolean
    local unit dead = GetTriggerUnit()
    local unit killer = GetKillingUnit()
    local player deadOwner = GetOwningPlayer(dead)
    local integer deadPId = GetPlayerId(deadOwner)
    local integer deadType = GetUnitTypeId(dead)
    local real deadX = GetUnitX(dead)
    local real deadY = GetUnitY(dead)
    local real deadFacing = GetUnitFacing(dead)
    local boolean isFakeHero = IsUnitInGroup(dead, udg_FakeHeroGroup)
    local boolean isIllusion = IsUnitIllusion(dead)
    local integer idx = -1
    local integer kIdx = -1
    local player ko = null
    local integer klv = 0
    local boolean hasLivingNinja = false
    local player kp = null
    local unit th = null
    local integer eLv = 0
    local unit c = null
    local real nx = 0.0
    local real ny = 0.0
    local real nhp = 0.0

    // 1. Dream Master Possession Return
    set idx = DM_FindCapIndex(dead)
    if idx >= 0 then
        call SetUnitOwner(dead, udg_CapOrigOwner[idx], true)
        call DM_RemoveCapIndex(idx)
    endif

    // 2. 他化自在 (A013) - 击杀魔音忍者者被烙印因果
    if (deadType == 'H003' or deadType == 'u002' or deadType == 'u001') and killer != null and IsUnitEnemy(killer, deadOwner) then
        set th = Ninja_GetTrueHero(deadOwner)
        set eLv = GetUnitAbilityLevel(dead, 'A013')
        if th != null and GetUnitAbilityLevel(th, 'A013') > eLv then
            set eLv = GetUnitAbilityLevel(th, 'A013')
        endif
        if eLv > 0 then
            call Ninja_MarkKarma(killer, deadOwner, eLv)
        endif
    endif

    // 3. 他化自在 (A013) - 因果单位死亡化为魔音忍者
    set kIdx = Ninja_FindKarmaIndex(dead)
    if kIdx >= 0 then
        set ko = udg_KarmaOwner[kIdx]
        set klv = udg_KarmaLevel[kIdx]
        call Ninja_RemoveKarmaIndex(kIdx)

        set th = Ninja_GetTrueHero(ko)
        set hasLivingNinja = false
        if th != null and not IsUnitType(th, UNIT_TYPE_DEAD) and GetWidgetLife(th) > 0.405 then
            set hasLivingNinja = true
        elseif Ninja_PickLivingClone(GetPlayerId(ko)) != null then
            set hasLivingNinja = true
        endif

        if not hasLivingNinja and th != null then
            // 当前场上没有任何魔音忍者（本体和分身都没有）：直接从该怪物尸体处产生（复活）魔音忍者本尊！
            call ReviveHero(th, deadX, deadY, true)
            call SetUnitFacing(th, deadFacing)
            call SetWidgetLife(th, GetUnitState(th, UNIT_STATE_MAX_LIFE))
            call SetUnitState(th, UNIT_STATE_MANA, GetUnitState(th, UNIT_STATE_MAX_MANA))
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl", th, "origin"))
            if GetLocalPlayer() == ko then
                call SelectUnit(th, true)
            endif
        else
            // 场上仍有魔音忍者（本体或分身）：产生魔音忍者分身！
            call Ninja_SpawnClone(ko, deadX, deadY, deadFacing)
            if klv >= 3 then
                call Ninja_SpawnClone(ko, deadX + 45.0, deadY + 45.0, deadFacing)
            endif
        endif
        set ko = null
    endif

    // 4. 魔音同化 (A011) - 击杀单位生成伪英雄分身
    if killer != null and not IsUnitType(dead, UNIT_TYPE_STRUCTURE) and deadType != 'u000' and deadType != 'u001' and deadType != 'u002' and deadType != 'H003' and not isFakeHero and not isIllusion and (GetUnitTypeId(killer) == 'H003' or GetUnitTypeId(killer) == 'u002' or GetUnitTypeId(killer) == 'u001') then
        set kp = GetOwningPlayer(killer)
        set th = Ninja_GetTrueHero(kp)
        if GetUnitAbilityLevel(killer, 'A011') > 0 or (th != null and GetUnitAbilityLevel(th, 'A011') > 0) or GetUnitTypeId(killer) == 'u001' then
            call Ninja_SpawnClone(kp, deadX, deadY, deadFacing)
        endif
        set kp = null
        set th = null
    endif

    // 5. 魔音同化 (A011) - 真身死亡 Fallback
    if deadType == 'H003' and not isFakeHero and not isIllusion then
        set c = Ninja_PickLivingClone(deadPId)
        if c != null then
            set nx = GetUnitX(c)
            set ny = GetUnitY(c)
            set nhp = GetWidgetLife(c)
            call GroupRemoveUnit(udg_Ninja_CloneGroup[deadPId], c)
            call GroupRemoveUnit(udg_FakeHeroGroup, c)
            call RemoveUnit(c)
            set c = null

            call ReviveHero(dead, nx, ny, false)
            call SetWidgetLife(dead, RMaxBJ(nhp, GetUnitState(dead, UNIT_STATE_MAX_LIFE) * 0.35))
            call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\NightElf\\Blink\\BlinkTarget.mdl", dead, "origin"))
            if GetLocalPlayer() == deadOwner then
                call SelectUnit(dead, true)
            endif
        endif
    endif

    // 6. Cleanup Fake Hero / Clone
    if isFakeHero or deadType == 'u002' or deadType == 'u001' then
        if udg_Ninja_CloneGroup[deadPId] != null then
            call GroupRemoveUnit(udg_Ninja_CloneGroup[deadPId], dead)
        endif
        call GroupRemoveUnit(udg_FakeHeroGroup, dead)
        if deadType == 'u002' then
            call SetUnitOwner(dead, Player(PLAYER_NEUTRAL_PASSIVE), false)
            call SetUnitExploded(dead, true)
            call RemoveUnit(dead)
        endif
    endif

    set dead = null
    set killer = null
    set deadOwner = null
    return false
endfunction

function TM_ApplyAIConfig takes nothing returns nothing
    local integer i = 0
    local group g = null
    local unit u = null
    local boolean hasCustom = false

    set i = 0
    loop
        exitwhen i > 7
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
            if udg_AI_HeroMode[i] > 0 then
                set hasCustom = true
                if not udg_AI_HeroSpawned[i] then
                    set g = CreateGroup()
                    call GroupEnumUnitsOfPlayer(g, Player(i), null)
                    loop
                        set u = FirstOfGroup(g)
                        exitwhen u == null
                        call GroupRemoveUnit(g, u)
                        if IsUnitType(u, UNIT_TYPE_HERO) and GetUnitTypeId(u) != 'H002' and GetUnitTypeId(u) != 'H003' and not IsUnitIllusion(u) and not IsUnitInGroup(u, udg_FakeHeroGroup) then
                            call AI_SpawnCustomHeroForPlayer(i, GetUnitX(u), GetUnitY(u), GetUnitFacing(u))
                            call RemoveUnit(u)
                            call GroupClear(g)
                        endif
                    endloop
                    call DestroyGroup(g)
                    set g = null
                endif
            endif
        endif
        set i = i + 1
    endloop
endfunction

function TM_ShowMainDialog takes player p returns nothing
    if p == null then
        return
    endif
    set udg_TM_PromptPlayer = p
    call DialogDisplay(p, udg_TM_MainDialog, false)
    call DialogClear(udg_TM_MainDialog)
    call DialogSetMessage(udg_TM_MainDialog, "【测试模式选择】(鼠标点击或按数字键1-4)")
    set udg_TM_BtnNormal = DialogAddButton(udg_TM_MainDialog, "[1] 正常模式：电脑使用原版随机英雄", 49)
    set udg_TM_BtnMode1All = DialogAddButton(udg_TM_MainDialog, "[2] 测试模式一：全部电脑出【幻梦大师】", 50)
    set udg_TM_BtnMode2All = DialogAddButton(udg_TM_MainDialog, "[3] 测试模式二：全部电脑出【魔音忍者】", 51)
    set udg_TM_BtnCustom = DialogAddButton(udg_TM_MainDialog, "[4] 精细配置：逐个指定各家电脑英雄...", 52)
    call DialogDisplay(p, udg_TM_MainDialog, true)
endfunction

function TM_ShowSlotDialog takes player p returns nothing
    local integer i = 0
    local string lbl = ""
    if p == null then
        return
    endif
    set udg_TM_PromptPlayer = p
    call DialogDisplay(p, udg_TM_SlotDialog, false)
    call DialogClear(udg_TM_SlotDialog)
    call DialogSetMessage(udg_TM_SlotDialog, "【精细配置】点击切换各电脑英雄 (确认后生效)")
    set i = 0
    loop
        exitwhen i > 7
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
            if udg_AI_HeroMode[i] == 1 then
                set lbl = "电脑 " + I2S(i + 1) + "：【幻梦大师】 (点击切换)"
            elseif udg_AI_HeroMode[i] == 2 then
                set lbl = "电脑 " + I2S(i + 1) + "：【魔音忍者】 (点击切换)"
            else
                set lbl = "电脑 " + I2S(i + 1) + "：原版默认英雄 (点击切换)"
            endif
            set udg_TM_SlotBtn[i] = DialogAddButton(udg_TM_SlotDialog, lbl, 0)
        else
            set udg_TM_SlotBtn[i] = null
        endif
        set i = i + 1
    endloop
    set udg_TM_SlotConfirm = DialogAddButton(udg_TM_SlotDialog, "[9] 【确认配置并开始】", 57)
    set udg_TM_SlotBack = DialogAddButton(udg_TM_SlotDialog, "[0] 返回上一级菜单", 48)
    call DialogDisplay(p, udg_TM_SlotDialog, true)
endfunction

function TM_OnMainDialogClicked takes nothing returns nothing
    local button b = GetClickedButton()
    local player p = GetTriggerPlayer()
    local integer i = 0
    if p == null then
        set p = udg_TM_PromptPlayer
    endif

    call DialogDisplay(p, udg_TM_MainDialog, false)

    if b == udg_TM_BtnNormal then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 0
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置正常模式：电脑使用原版英雄 (可随时输入 -test 重新选择)")
        call TM_ApplyAIConfig()
    elseif b == udg_TM_BtnMode1All then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 1
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式一：全部电脑出【幻梦大师】！(可随时输入 -test 重新选择)")
        call TM_ApplyAIConfig()
    elseif b == udg_TM_BtnMode2All then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 2
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式二：全部电脑出【魔音忍者】！(可随时输入 -test 重新选择)")
        call TM_ApplyAIConfig()
    elseif b == udg_TM_BtnCustom then
        call TM_ShowSlotDialog(p)
    endif

    set b = null
    set p = null
endfunction

function TM_OnSlotDialogClicked takes nothing returns nothing
    local button b = GetClickedButton()
    local player p = GetTriggerPlayer()
    local integer i = 0
    if p == null then
        set p = udg_TM_PromptPlayer
    endif

    if b == udg_TM_SlotConfirm then
        call DialogDisplay(p, udg_TM_SlotDialog, false)
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 电脑英雄精细配置已生效！(可随时输入 -test 重新配置)")
        call TM_ApplyAIConfig()
    elseif b == udg_TM_SlotBack then
        call DialogDisplay(p, udg_TM_SlotDialog, false)
        call TM_ShowMainDialog(p)
    else
        set i = 0
        loop
            exitwhen i > 7
            if b == udg_TM_SlotBtn[i] then
                if udg_AI_HeroMode[i] == 0 then
                    set udg_AI_HeroMode[i] = 1
                elseif udg_AI_HeroMode[i] == 1 then
                    set udg_AI_HeroMode[i] = 2
                else
                    set udg_AI_HeroMode[i] = 0
                endif
                call TM_ShowSlotDialog(p)
                set b = null
                set p = null
                return
            endif
            set i = i + 1
        endloop
    endif

    set b = null
    set p = null
endfunction

function TM_OnChatCommand takes nothing returns nothing
    local string s = StringCase(GetEventPlayerChatString(), false)
    local player p = GetTriggerPlayer()
    local integer i = 0
    if p == null then
        set p = udg_TM_PromptPlayer
    endif

    if s == "-test" or s == "-mode" then
        call TM_ShowMainDialog(p)
    elseif s == "-m0" then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 0
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置正常模式：所有电脑使用原版默认英雄。")
        call TM_ApplyAIConfig()
    elseif s == "-m1" then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 1
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式一：全部电脑出【幻梦大师】！")
        call TM_ApplyAIConfig()
    elseif s == "-m2" then
        set i = 0
        loop
            exitwhen i > 7
            if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_COMPUTER then
                set udg_AI_HeroMode[i] = 2
            endif
            set i = i + 1
        endloop
        call DisplayTimedTextToPlayer(p, 0, 0, 6.0, "|cff00ff00[测试模式]|r 已设置测试模式二：全部电脑出【魔音忍者】！")
        call TM_ApplyAIConfig()
    endif

    set p = null
endfunction

function TM_GetFirstHumanPlayer takes nothing returns player
    local integer i = 0
    loop
        exitwhen i > 7
        if GetPlayerSlotState(Player(i)) == PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i)) == MAP_CONTROL_USER then
            return Player(i)
        endif
        set i = i + 1
    endloop
    return null
endfunction

function TM_OnStartTimer takes nothing returns nothing
    local timer t = GetExpiredTimer()
    local player p = TM_GetFirstHumanPlayer()
    call PauseTimer(t)
    call DestroyTimer(t)
    set t = null
    if p != null then
        call TM_ShowMainDialog(p)
    endif
    set p = null
endfunction

function AI_OnUnitTrainFinish takes nothing returns boolean
    local unit trained = GetTrainedUnit()
    local player p = null
    local integer pId = 0
    local real hx = 0.0
    local real hy = 0.0
    local real hf = 0.0

    if trained != null then
        set p = GetOwningPlayer(trained)
        set pId = GetPlayerId(p)
        if GetPlayerController(p) == MAP_CONTROL_COMPUTER and udg_AI_HeroMode[pId] > 0 and not udg_AI_HeroSpawned[pId] then
            if IsUnitType(trained, UNIT_TYPE_HERO) and GetUnitTypeId(trained) != 'H002' and GetUnitTypeId(trained) != 'H003' and not IsUnitIllusion(trained) and not IsUnitInGroup(trained, udg_FakeHeroGroup) then
                set hx = GetUnitX(trained)
                set hy = GetUnitY(trained)
                set hf = GetUnitFacing(trained)
                call RemoveUnit(trained)
                call AI_SpawnCustomHeroForPlayer(pId, hx, hy, hf)
            endif
        endif
    endif

    set trained = null
    set p = null
    return false
endfunction

function DM_InitTriggers takes nothing returns nothing
    local trigger tEffect = CreateTrigger()
    local trigger tCast = CreateTrigger()
    local trigger tDeath = CreateTrigger()
    local trigger tDamage = CreateTrigger()
    local trigger tRevive = CreateTrigger()
    local trigger tSkill = CreateTrigger()
    local trigger tTrain = CreateTrigger()
    local trigger tMainDialog = CreateTrigger()
    local trigger tSlotDialog = CreateTrigger()
    local trigger tChat = CreateTrigger()
    local timer tmrCap = CreateTimer()
    local timer tmrStealth = CreateTimer()
    local timer tmrStart = CreateTimer()
    local integer i = 0

    set udg_EnumGroup = CreateGroup()
    set udg_FakeHeroGroup = CreateGroup()

    set i = 0
    loop
        exitwhen i > 15
        set udg_Ninja_CloneGroup[i] = CreateGroup()
        set udg_Ninja_AuraOn[i] = false
        set udg_Ninja_AuraFx[i] = null
        set udg_Ninja_TrueHero[i] = null

        // Initialize AI variables
        set udg_AI_HeroMode[i] = 0
        set udg_AI_CustomHero[i] = null
        set udg_AI_HeroSpawned[i] = false
        set udg_AI_CastCD_Q[i] = 0.0
        set udg_AI_CastCD_W[i] = 0.0
        set udg_AI_CastCD_E[i] = 0.0
        set udg_AI_CastCD_R[i] = 0.0
        set udg_AI_DeadTimer[i] = 0.0
        set udg_AI_AltarTimer[i] = 0.0
        set udg_AI_WaitTimer[i] = 0.0
        set udg_TM_SlotBtn[i] = null
        set i = i + 1
    endloop

    // Initialize Test Mode Dialogs (Handles only - buttons added after game start to avoid click freeze)
    set udg_TM_MainDialog = DialogCreate()
    set udg_TM_SlotDialog = DialogCreate()

    call TriggerRegisterDialogEvent(tMainDialog, udg_TM_MainDialog)
    call TriggerAddAction(tMainDialog, function TM_OnMainDialogClicked)

    call TriggerRegisterDialogEvent(tSlotDialog, udg_TM_SlotDialog)
    call TriggerAddAction(tSlotDialog, function TM_OnSlotDialogClicked)

    set i = 0
    loop
        exitwhen i > 7
        call TriggerRegisterPlayerChatEvent(tChat, Player(i), "-", false)
        set i = i + 1
    endloop
    call TriggerAddAction(tChat, function TM_OnChatCommand)

    call TriggerRegisterAnyUnitEventBJ(tEffect, EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(tEffect, Condition(function DM_OnSpellEffect))

    call TriggerRegisterAnyUnitEventBJ(tCast, EVENT_PLAYER_UNIT_SPELL_CAST)
    call TriggerAddCondition(tCast, Condition(function DM_OnSpellCast))

    call TriggerRegisterAnyUnitEventBJ(tDeath, EVENT_PLAYER_UNIT_DEATH)
    call TriggerAddCondition(tDeath, Condition(function DM_OnUnitDeath))

    call TriggerRegisterAnyUnitEventBJ(tRevive, EVENT_PLAYER_HERO_REVIVABLE)
    call TriggerAddCondition(tRevive, Condition(function DM_OnHeroRevivable))

    call TriggerRegisterAnyUnitEventBJ(tDamage, EVENT_PLAYER_UNIT_DAMAGED)
    call TriggerAddCondition(tDamage, Condition(function DM_OnDamaged))

    call TriggerRegisterAnyUnitEventBJ(tSkill, EVENT_PLAYER_HERO_SKILL)
    call TriggerAddCondition(tSkill, Condition(function Ninja_OnHeroSkill))

    call TriggerRegisterAnyUnitEventBJ(tTrain, EVENT_PLAYER_UNIT_TRAIN_FINISH)
    call TriggerAddCondition(tTrain, Condition(function AI_OnUnitTrainFinish))

    call TimerStart(tmrCap, 1.0, true, function DM_CapTimerLoop)
    call TimerStart(tmrStealth, 0.05, true, function DM_StealthLoop)
    call TimerStart(tmrStart, 1.00, false, function TM_OnStartTimer)

    set tEffect = null
    set tCast = null
    set tDeath = null
    set tDamage = null
    set tRevive = null
    set tSkill = null
    set tTrain = null
    set tMainDialog = null
    set tSlotDialog = null
    set tChat = null
    set tmrCap = null
    set tmrStealth = null
    set tmrStart = null
endfunction



function main takes nothing returns nothing
    call DM_InitTriggers()
    call SetCameraBounds( -9472.0 + GetCameraMargin(CAMERA_MARGIN_LEFT), -7680.0 + GetCameraMargin(CAMERA_MARGIN_BOTTOM), 9472.0 - GetCameraMargin(CAMERA_MARGIN_RIGHT), 7168.0 - GetCameraMargin(CAMERA_MARGIN_TOP), -9472.0 + GetCameraMargin(CAMERA_MARGIN_LEFT), 7168.0 - GetCameraMargin(CAMERA_MARGIN_TOP), 9472.0 - GetCameraMargin(CAMERA_MARGIN_RIGHT), -7680.0 + GetCameraMargin(CAMERA_MARGIN_BOTTOM) )
    call SetDayNightModels( "Environment\\DNC\\DNCLordaeron\\DNCLordaeronTerrain\\DNCLordaeronTerrain.mdl", "Environment\\DNC\\DNCLordaeron\\DNCLordaeronUnit\\DNCLordaeronUnit.mdl" )
    call NewSoundEnvironment( "Default" )
    call SetAmbientDaySound( "LordaeronSummerDay" )
    call SetAmbientNightSound( "LordaeronSummerNight" )
    call SetMapMusic( "Music", true, 0 )
    call CreateAllUnits(  )
    call InitBlizzard(  )
    call InitGlobals(  )
    call InitCustomTriggers(  )
    call RunInitializationTriggers(  )

endfunction

//***************************************************************************
//*
//*  Map Configuration
//*
//***************************************************************************

function config takes nothing returns nothing
    call SetMapName( "TRIGSTR_001" )
    call SetMapDescription( "TRIGSTR_003" )
    call SetPlayers( 8 )
    call SetTeams( 8 )
    call SetGamePlacement( MAP_PLACEMENT_TEAMS_TOGETHER )

    call DefineStartLocation( 0, -6656.0, 5376.0 )
    call DefineStartLocation( 1, -1920.0, 5440.0 )
    call DefineStartLocation( 2, 3008.0, 5440.0 )
    call DefineStartLocation( 3, 8000.0, 5440.0 )
    call DefineStartLocation( 4, 6592.0, -5760.0 )
    call DefineStartLocation( 5, 1728.0, -5760.0 )
    call DefineStartLocation( 6, -3136.0, -5824.0 )
    call DefineStartLocation( 7, -8128.0, -5824.0 )

    // Player setup
    call InitCustomPlayerSlots(  )
    call SetPlayerSlotAvailable( Player(0), MAP_CONTROL_USER )
    call SetPlayerSlotAvailable( Player(1), MAP_CONTROL_USER )
    call SetPlayerSlotAvailable( Player(2), MAP_CONTROL_USER )
    call SetPlayerSlotAvailable( Player(3), MAP_CONTROL_USER )
    call SetPlayerSlotAvailable( Player(4), MAP_CONTROL_USER )
    call SetPlayerSlotAvailable( Player(5), MAP_CONTROL_USER )
    call SetPlayerSlotAvailable( Player(6), MAP_CONTROL_USER )
    call SetPlayerSlotAvailable( Player(7), MAP_CONTROL_USER )
    call InitGenericPlayerSlots(  )
    call InitAllyPriorities(  )
endfunction

