    call SetPlayers( 8 )
    call SetTeams( 8 )
    call SetGamePlacement( MAP_PLACEMENT_TEAMS_TOGETHER )

    call DefineStartLocation( 0, -6656.0, 5376.0 )
    call DefineStartLocation( 1, -1920.0, 5440.0 )
    call DefineStartLocation( 2, 3008.0, 5440.0 )
    call DefineStartLocation( 3, 8000.0, 5440.0 )
    call DefineStartLocation( 4, 6592.0, -5760.0 )
    call DefineStartLocation( 5, 1728.0, -5760.0 )
    call DefineStartLocation( 6, -3136.0, -5824.0 )
    call DefineStartLocation( 7, -8128.0, -5824.0 )

    // Player setup
