//===========================================================================
// Trigger: set
//===========================================================================
function Trig_set_Actions takes nothing returns nothing
    call CinematicFilterGenericBJ(2, BLEND_MODE_BLEND, "ReplaceableTextures\\CameraMasks\\White_mask.blp", 0.00, 0.00, 0.00, 0.00, 0, 0, 0, 0)
    call CinematicModeBJ(true, GetPlayersAll())
    call SetUserControlForceOn(GetPlayersAll())
    call SetCampaignAvailableBJ(true, bj_CAMPAIGN_INDEX_H)
    call SetCampaignAvailableBJ(true, bj_CAMPAIGN_INDEX_U)
    call SetCampaignAvailableBJ(true, bj_CAMPAIGN_INDEX_O)
    call SetCampaignAvailableBJ(true, bj_CAMPAIGN_INDEX_N)
    call SetCampaignAvailableBJ(true, bj_CAMPAIGN_INDEX_XN)
    call SetCampaignAvailableBJ(true, bj_CAMPAIGN_INDEX_XH)
    call SetCampaignAvailableBJ(true, bj_CAMPAIGN_INDEX_XU)
    call SetCampaignAvailableBJ(true, bj_CAMPAIGN_INDEX_XO)
    call SetCampaignAvailableBJ(true, 9)
    call SetCampaignAvailableBJ(true, 10)
    call SetCampaignAvailableBJ(true, 11)
    set bj_forLoopBIndex=1
    set bj_forLoopBIndexEnd=11
    loop
        exitwhen bj_forLoopBIndex > bj_forLoopBIndexEnd
        set bj_forLoopAIndex=( GetForLoopIndexB() * 1000 )
        set bj_forLoopAIndexEnd=( ( GetForLoopIndexB() * 1000 ) + 25 )
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call SetMissionAvailableBJ(true, bj_forLoopAIndex)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
        set bj_forLoopBIndex=bj_forLoopBIndex + 1
    endloop
endfunction

//===========================================================================
function InitTrig_set takes nothing returns nothing
    set gg_trg_set=CreateTrigger()
    call TriggerAddAction(gg_trg_set, function Trig_set_Actions)
endfunction


//===========================================================================
// Trigger: set1
//===========================================================================
function Trig_set1_Actions takes nothing returns nothing
    set bj_forLoopAIndex=9000
    set bj_forLoopAIndexEnd=9020
    loop
        exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
        call SetMissionAvailableBJ(true, bj_forLoopAIndex)
        set bj_forLoopAIndex=bj_forLoopAIndex + 1
    endloop
    call CustomVictoryBJ(Player(0), false, false)
endfunction

//===========================================================================
function InitTrig_set1 takes nothing returns nothing
    set gg_trg_set1=CreateTrigger()
    call TriggerRegisterTimerEventSingle(gg_trg_set1, 0.00)
    call TriggerAddAction(gg_trg_set1, function Trig_set1_Actions)
endfunction

//===========================================================================
function InitCustomTriggers takes nothing returns nothing
    call InitTrig_set()
    call InitTrig_set1()
endfunction

//===========================================================================
function RunInitializationTriggers takes nothing returns nothing
    call ConditionalTriggerExecute(gg_trg_set)
endfunction

